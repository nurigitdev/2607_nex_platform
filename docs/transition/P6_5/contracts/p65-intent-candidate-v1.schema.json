{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/contracts/p65/intent-candidate-v1",
  "title": "P6.5 Intent Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_label",
    "suggested_execution_mode",
    "entity_selectors",
    "parameter_candidates",
    "clarification",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "p65.intent_candidate.v1"
    },
    "intent_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "suggested_execution_mode": {
      "enum": [
        "GENERAL_ANSWER",
        "GROUNDED_ANSWER",
        "DOCUMENT_SUMMARY",
        "DOCUMENT_GENERATION"
      ]
    },
    "entity_selectors": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entitySelector"
      }
    },
    "parameter_candidates": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/parameterCandidate"
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reasons", "questions"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "entitySelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector_id", "selector_type", "value", "confidence"],
      "properties": {
        "selector_id": {
          "type": "string",
          "pattern": "^E[0-9]{1,3}$"
        },
        "selector_type": {
          "enum": [
            "ENTITY_ID",
            "ENTITY_NAME",
            "DOCUMENT_ID",
            "QUERY_TERM",
            "RESOURCE_HINT"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "parameterCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "confidence"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    }
  }
}
