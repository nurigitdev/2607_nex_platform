{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/contracts/p65/plan-candidate-v1",
  "title": "P6.5 Plan Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suggested_plan_kind",
    "goal",
    "logical_steps",
    "completion_mapping",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "p65.plan_candidate.v1"
    },
    "suggested_plan_kind": {
      "enum": ["DIRECT", "KNOWN_TEMPLATE", "DYNAMIC"]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "logical_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/logicalStep"
      }
    },
    "completion_mapping": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "terminal_step_refs"],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^C[0-9]{1,3}$"
          },
          "terminal_step_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^S[0-9]{1,3}$"
            }
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "logicalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "step_type",
        "title",
        "objective",
        "depends_on",
        "capability_hint",
        "completion_criteria"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^S[0-9]{1,3}$"
        },
        "step_type": {
          "enum": ["LOCAL_CAPABILITY", "AGGREGATE", "REPORT"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "depends_on": {
          "type": "array",
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^S[0-9]{1,3}$"
          }
        },
        "capability_hint": {
          "type": ["string", "null"],
          "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
          "maxLength": 160
        },
        "completion_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "step_type": {
                "const": "LOCAL_CAPABILITY"
              }
            },
            "required": ["step_type"]
          },
          "then": {
            "properties": {
              "capability_hint": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "capability_hint": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
