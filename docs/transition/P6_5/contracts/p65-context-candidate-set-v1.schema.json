{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/contracts/p65/context-candidate-set-v1",
  "title": "P6.5 Context Candidate Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity_candidates",
    "retrieval_hints",
    "resource_selectors",
    "parameter_candidates",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "p65.context_candidate_set.v1"
    },
    "entity_candidates": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_key",
          "entity_type",
          "selector_kind",
          "selector_value",
          "confidence"
        ],
        "properties": {
          "candidate_key": {
            "type": "string",
            "pattern": "^E[0-9]{1,3}$"
          },
          "entity_type": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "selector_kind": {
            "enum": ["ID", "NAME", "QUERY"]
          },
          "selector_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "retrieval_hints": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_terms", "resource_types", "confidence"],
        "properties": {
          "query_terms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "resource_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "enum": ["DOCUMENT", "CONVERSATION", "WORKSPACE"]
            }
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "resource_selectors": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_type",
          "selector_kind",
          "selector_value",
          "confidence"
        ],
        "properties": {
          "resource_type": {
            "enum": ["DOCUMENT", "CONVERSATION", "WORKSPACE"]
          },
          "selector_kind": {
            "enum": ["ID", "OWNER_VISIBLE_LABEL"]
          },
          "selector_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "parameter_candidates": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/parameterCandidate"
      }
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    }
  },
  "$defs": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "parameterCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "confidence"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    }
  }
}
