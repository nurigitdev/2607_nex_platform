{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/contracts/p65/semantic-candidate-evidence-v1",
  "title": "P6.5 Semantic Candidate Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "owner_subject_id",
    "candidate_id",
    "execution_id",
    "semantic_stage",
    "candidate_revision",
    "candidate_hash",
    "candidate_payload_storage_ref",
    "candidate_payload_size_bytes",
    "provider_output_sha256",
    "input_context_hash",
    "prompt_binding_id",
    "prompt_binding_key",
    "prompt_template_version_id",
    "prompt_template_version",
    "prompt_content_sha256",
    "rendered_prompt_hash",
    "model_profile",
    "model_ref",
    "deployment_id",
    "mo_generation_id",
    "request_id",
    "trace_id",
    "admission_policy_ref",
    "validation_outcome",
    "directive",
    "failure_code",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "p65.semantic_candidate_evidence.v1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "owner_subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "execution_id": {
      "type": "string",
      "format": "uuid"
    },
    "semantic_stage": {
      "enum": ["INTENT", "CONTEXT", "PLAN"]
    },
    "candidate_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "candidate_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_payload_storage_ref": {
      "type": ["string", "null"],
      "pattern": "^ae://semantic-candidates/[0-9a-f-]{36}/[0-9a-f]{64}\\.json$",
      "maxLength": 512
    },
    "candidate_payload_size_bytes": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 1048576
    },
    "provider_output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_context_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "prompt_binding_id": {
      "type": "string",
      "format": "uuid"
    },
    "prompt_binding_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "prompt_template_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "prompt_template_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "prompt_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rendered_prompt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mo_generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "admission_policy_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "validation_outcome": {
      "enum": ["ADMITTED", "REJECTED", "FAILED"]
    },
    "directive": {
      "enum": [
        "CONTINUE",
        "SHADOW_ONLY",
        "CLARIFICATION_REQUIRED",
        "CONTEXT_REFRESH_REQUIRED",
        "REPLAN_REQUIRED",
        "BLOCKED"
      ]
    },
    "failure_code": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validation_outcome": {
            "const": "ADMITTED"
          }
        },
        "required": ["validation_outcome"]
      },
      "then": {
        "properties": {
          "candidate_hash": {
            "type": "string"
          },
          "candidate_payload_storage_ref": {
            "type": "string"
          },
          "candidate_payload_size_bytes": {
            "type": "integer"
          },
          "directive": {
            "const": "CONTINUE"
          },
          "failure_code": {
            "type": "null"
          }
        }
      }
    }
  ]
}
