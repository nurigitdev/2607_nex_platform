{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nex:transition:p5:agent-context:1.0",
  "title": "NeX P5 AgentContext v1 Transition Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "context_generation",
    "execution_id",
    "work_intent_ref",
    "identity",
    "interaction",
    "project_ref",
    "resolved_entities",
    "retrieval_refs",
    "evidence_refs",
    "runtime_policy_ref",
    "conflicts",
    "degradations",
    "context_manifest",
    "budget",
    "context_hash",
    "built_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "context_id": {"type": "string", "format": "uuid"},
    "context_generation": {"type": "integer", "minimum": 1, "maximum": 9999},
    "execution_id": {"type": "string", "format": "uuid"},
    "work_intent_ref": {"$ref": "#/$defs/versionedHashRef"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "principal_id", "agent_id", "agent_type"],
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "principal_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "agent_id": {"type": "string", "format": "uuid"},
        "agent_type": {"const": "IA"}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "conversation_id", "interaction_id"],
      "properties": {
        "workspace_id": {"type": "string", "format": "uuid"},
        "conversation_id": {"type": "string", "format": "uuid"},
        "interaction_id": {"type": "string", "format": "uuid"}
      }
    },
    "project_ref": {
      "anyOf": [{"$ref": "#/$defs/resourceRef"}, {"type": "null"}]
    },
    "authority_ref": {"type": ["string", "null"], "maxLength": 256},
    "resolved_entities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector_id", "resource_ref", "source_ref", "resolved_at"],
        "properties": {
          "selector_id": {"type": "string", "pattern": "^E[0-9]{1,3}$"},
          "resource_ref": {"$ref": "#/$defs/resourceRef"},
          "source_ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "resolved_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "retrieval_refs": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/resourceRef"}
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/resourceRef"}
    },
    "runtime_policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "rule_version", "rule_hash"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "rule_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "rule_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "degradations": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "context_manifest": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source_ref", "content_hash", "as_of"],
        "properties": {
          "kind": {"type": "string", "minLength": 1, "maxLength": 64},
          "source_ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "source_version": {"type": ["string", "null"], "maxLength": 128},
          "content_hash": {"$ref": "#/$defs/hash"},
          "as_of": {"type": "string", "format": "date-time"}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_tokens", "estimated_used_tokens", "truncated_optional_items"],
      "properties": {
        "budget_tokens": {"type": "integer", "minimum": 0},
        "estimated_used_tokens": {"type": "integer", "minimum": 0},
        "truncated_optional_items": {"type": "integer", "minimum": 0}
      }
    },
    "context_hash": {"$ref": "#/$defs/hash"},
    "built_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "resource_type", "resource_id"],
      "properties": {
        "system": {"type": "string", "minLength": 1, "maxLength": 64},
        "resource_type": {"type": "string", "minLength": 1, "maxLength": 64},
        "resource_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "versionedHashRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
