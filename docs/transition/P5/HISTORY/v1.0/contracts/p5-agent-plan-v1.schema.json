{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nex:transition:p5:agent-plan:1.0",
  "title": "NeX P5 AgentPlan v1 Transition Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_plan_id",
    "agent_plan_version",
    "execution_id",
    "work_intent_ref",
    "agent_context_ref",
    "capability_snapshot_ref",
    "plan_kind",
    "goal",
    "completion_criteria",
    "planning_constraints",
    "steps",
    "planner_provenance",
    "plan_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "agent_plan_id": {"type": "string", "format": "uuid"},
    "agent_plan_version": {"type": "integer", "minimum": 1, "maximum": 99},
    "supersedes_agent_plan_id": {"type": ["string", "null"], "format": "uuid"},
    "execution_id": {"type": "string", "format": "uuid"},
    "work_intent_ref": {"$ref": "#/$defs/versionedHashRef"},
    "agent_context_ref": {"$ref": "#/$defs/versionedHashRef"},
    "capability_snapshot_ref": {"$ref": "#/$defs/versionedHashRef"},
    "plan_kind": {"enum": ["DIRECT", "CERTIFIED_BINDING", "KNOWN_TEMPLATE", "DYNAMIC"]},
    "goal": {"type": "string", "minLength": 1, "maxLength": 1000},
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/completionCriterion"}
    },
    "planning_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_plan_steps", "max_delegation_depth", "max_parallel_steps"],
      "properties": {
        "max_plan_steps": {"const": 12},
        "max_delegation_depth": {"const": 0},
        "max_parallel_steps": {"const": 1}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/planStep"}
    },
    "planner_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder_type", "route_decision_ref", "input_context_hash"],
      "properties": {
        "builder_type": {"enum": ["DIRECT_BINDER", "CERTIFIED_BINDER", "TEMPLATE_BINDER", "DYNAMIC_BUILDER"]},
        "route_decision_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "template_ref": {"type": ["string", "null"], "maxLength": 256},
        "input_context_hash": {"$ref": "#/$defs/hash"},
        "prompt_binding_key": {"type": ["string", "null"], "maxLength": 200},
        "prompt_template_version_id": {"type": ["string", "null"], "format": "uuid"},
        "prompt_content_sha256": {
          "anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
        },
        "rendered_prompt_hash": {
          "anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
        },
        "model_profile": {"type": ["string", "null"], "maxLength": 128},
        "model_ref": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "plan_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capabilityId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
      "maxLength": 160
    },
    "versionedHashRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "hash": {"$ref": "#/$defs/hash"}
      }
    },
    "completionCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "description", "required", "required_terminal_step_refs"],
      "properties": {
        "criterion_id": {"type": "string", "pattern": "^C[0-9]{1,3}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "required": {"type": "boolean"},
        "required_terminal_step_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^S[0-9]{1,3}$"}
        }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_name", "source_type"],
      "properties": {
        "target_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "source_type": {"enum": ["WORK_INTENT_PARAMETER", "ENTITY_SELECTOR", "STEP_OUTPUT", "LITERAL"]},
        "source_ref": {"type": ["string", "null"], "maxLength": 160},
        "json_pointer": {"type": ["string", "null"], "maxLength": 512},
        "literal_value": {}
      }
    },
    "planStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "step_type",
        "title",
        "objective",
        "depends_on",
        "required_capability",
        "capability_version_constraint",
        "input_bindings",
        "output_contract_ref",
        "completion_criteria"
      ],
      "properties": {
        "step_id": {"type": "string", "pattern": "^S[0-9]{1,3}$"},
        "step_type": {"enum": ["LOCAL_CAPABILITY", "DELEGATE_WORK", "AGGREGATE", "REPORT"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "objective": {"type": "string", "minLength": 1, "maxLength": 700},
        "depends_on": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^S[0-9]{1,3}$"}
        },
        "required_capability": {
          "anyOf": [{"$ref": "#/$defs/capabilityId"}, {"type": "null"}]
        },
        "capability_version_constraint": {"type": ["string", "null"], "maxLength": 64},
        "input_bindings": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/inputBinding"}
        },
        "output_contract_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "completion_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "aggregation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["DETERMINISTIC", "STRUCTURED", "LLM_SYNTHESIS"]},
            "source_step_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^S[0-9]{1,3}$"}
            }
          },
          "required": ["mode", "source_step_refs"]
        },
        "report": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "report_kind": {"enum": ["INTERACTIVE_RESPONSE", "WORK_RESULT", "ARTIFACT"]},
            "source_step_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^S[0-9]{1,3}$"}
            }
          },
          "required": ["report_kind", "source_step_refs"]
        }
      }
    }
  }
}
