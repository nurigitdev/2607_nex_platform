{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nex:transition:p5:executable-plan:1.1",
  "title": "NeX P5 ExecutablePlan v1.1 Transition Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "executable_plan_id",
    "executable_plan_version",
    "execution_id",
    "agent_plan_ref",
    "work_intent_ref",
    "agent_context_ref",
    "capability_snapshot_ref",
    "validation_result_ref",
    "compiler_version",
    "steps",
    "completion_criteria",
    "logical_step_mapping",
    "runtime_constraints",
    "compiled_at",
    "executable_plan_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "executable_plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "executable_plan_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "execution_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_plan_ref": {
      "$ref": "#/$defs/versionedHashRef"
    },
    "work_intent_ref": {
      "$ref": "#/$defs/versionedHashRef"
    },
    "agent_context_ref": {
      "$ref": "#/$defs/versionedHashRef"
    },
    "capability_snapshot_ref": {
      "$ref": "#/$defs/versionedHashRef"
    },
    "validation_result_ref": {
      "$ref": "#/$defs/versionedHashRef"
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "policy_snapshot_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "authority_snapshot_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/executableStep"
      }
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "required",
          "required_terminal_compiled_step_keys"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^C[0-9]{1,3}$"
          },
          "required": {
            "type": "boolean"
          },
          "required_terminal_compiled_step_keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^E[0-9]{1,3}$"
            }
          }
        }
      }
    },
    "logical_step_mapping": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logical_step_id",
          "compiled_step_keys",
          "executable_step_ids"
        ],
        "properties": {
          "logical_step_id": {
            "type": "string",
            "pattern": "^S[0-9]{1,3}$"
          },
          "compiled_step_keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^E[0-9]{1,3}$"
            }
          },
          "executable_step_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    "runtime_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_parallel_steps",
        "max_auto_replan"
      ],
      "properties": {
        "max_parallel_steps": {
          "const": 1
        },
        "max_auto_replan": {
          "const": 0
        },
        "max_steps_per_run_slice": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      }
    },
    "compiled_at": {
      "type": "string",
      "format": "date-time"
    },
    "executable_plan_hash": {
      "$ref": "#/$defs/semanticHash"
    }
  },
  "$defs": {
    "semanticHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "versionedHashRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "hash": {
          "$ref": "#/$defs/semanticHash"
        }
      }
    },
    "compiledInputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_name",
        "binding_type",
        "binding_hash"
      ],
      "properties": {
        "target_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "binding_type": {
          "enum": [
            "TYPED_VALUE",
            "RESOURCE_REF",
            "COMPILED_STEP_OUTPUT",
            "LITERAL"
          ]
        },
        "value": {},
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "binding_hash": {
          "$ref": "#/$defs/semanticHash"
        }
      }
    },
    "executableStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiled_step_key",
        "executable_step_id",
        "step_index",
        "logical_step_ref",
        "step_type",
        "executor_kind",
        "title",
        "depends_on_compiled_step_keys",
        "compiled_input_bindings",
        "output_contract_ref",
        "step_contract_hash"
      ],
      "properties": {
        "compiled_step_key": {
          "type": "string",
          "pattern": "^E[0-9]{1,3}$"
        },
        "executable_step_id": {
          "type": "string",
          "format": "uuid"
        },
        "step_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "logical_step_ref": {
          "type": "string",
          "pattern": "^S[0-9]{1,3}$"
        },
        "injected_for_logical_step_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^S[0-9]{1,3}$"
        },
        "step_type": {
          "enum": [
            "LOCAL_SKILL",
            "CANONICAL_CAPABILITY",
            "DELEGATE_WORK",
            "HUMAN_CONFIRMATION",
            "FORMAL_APPROVAL",
            "AGGREGATE",
            "REPORT"
          ]
        },
        "executor_kind": {
          "enum": [
            "P4_CHAT_RAG_COMPATIBILITY",
            "DETERMINISTIC_AGGREGATE",
            "DETERMINISTIC_REPORT",
            "LOCAL_SKILL_UNAVAILABLE",
            "DELEGATE_WORK_UNAVAILABLE"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "depends_on_compiled_step_keys": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^E[0-9]{1,3}$"
          }
        },
        "required_capability": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "capability_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "compiled_input_bindings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/compiledInputBinding"
          }
        },
        "output_contract_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeout_policy_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "retry_policy_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "step_contract_hash": {
          "$ref": "#/$defs/semanticHash"
        }
      }
    }
  }
}
