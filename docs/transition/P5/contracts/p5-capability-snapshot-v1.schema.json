{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nex:transition:p5:capability-snapshot:1.0",
  "title": "NeX P5 Capability Catalog Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "capability_snapshot_id",
    "snapshot_version",
    "capabilities",
    "snapshot_hash",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "capability_snapshot_id": {"type": "string", "format": "uuid"},
    "snapshot_version": {"type": "integer", "minimum": 1, "maximum": 9999},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/capability"}
    },
    "snapshot_hash": {"$ref": "#/$defs/hash"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capabilityId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
      "maxLength": 160
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "capability_version",
        "status",
        "allowed_logical_step_types",
        "executable_step_type",
        "executor_kind",
        "input_contract_ref",
        "output_contract_ref",
        "operation_semantics"
      ],
      "properties": {
        "capability_id": {"$ref": "#/$defs/capabilityId"},
        "capability_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"const": "ACTIVE"},
        "allowed_logical_step_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["LOCAL_CAPABILITY", "AGGREGATE", "REPORT"]}
        },
        "executable_step_type": {"enum": ["CANONICAL_CAPABILITY", "AGGREGATE", "REPORT"]},
        "executor_kind": {"enum": ["P4_CHAT_RAG_COMPATIBILITY", "DETERMINISTIC_AGGREGATE", "DETERMINISTIC_REPORT"]},
        "input_contract_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "output_contract_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "operation_semantics": {"enum": ["READ", "GENERATE", "AGGREGATE", "REPORT"]}
      }
    }
  }
}
