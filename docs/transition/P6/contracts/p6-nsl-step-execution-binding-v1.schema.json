{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nex:transition:p6:nsl-step-execution-binding:1.0",
  "title": "NeX P6 NSLStepExecutionBinding v1 Transition Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "agent_execution_id",
    "executable_plan_id",
    "executable_step_id",
    "nsl_execution_id",
    "business_operation_id",
    "skill_id",
    "exact_skill_version",
    "skill_semantic_hash",
    "verified_artifact_ref",
    "verified_artifact_hash",
    "request_ref",
    "request_hash",
    "backend_profile",
    "state",
    "result_summary_ref",
    "result_summary_hash",
    "allocated_at",
    "request_bound_at",
    "invocation_started_at",
    "completed_at",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tenant_id": {"$ref": "#/$defs/boundedText"},
    "agent_execution_id": {"$ref": "#/$defs/uuid"},
    "executable_plan_id": {"$ref": "#/$defs/uuid"},
    "executable_step_id": {"$ref": "#/$defs/uuid"},
    "nsl_execution_id": {"$ref": "#/$defs/uuid"},
    "business_operation_id": {"$ref": "#/$defs/uuid"},
    "skill_id": {"$ref": "#/$defs/selector"},
    "exact_skill_version": {"$ref": "#/$defs/selector"},
    "skill_semantic_hash": {"$ref": "#/$defs/hashRef"},
    "verified_artifact_ref": {"$ref": "#/$defs/ref"},
    "verified_artifact_hash": {"$ref": "#/$defs/hashRef"},
    "request_ref": {"$ref": "#/$defs/ref"},
    "request_hash": {"$ref": "#/$defs/hashRef"},
    "backend_profile": {"const": "NSL_V01_PROCESS_ISOLATED"},
    "state": {
      "enum": [
        "ALLOCATED",
        "REQUEST_BOUND",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "result_summary_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "result_summary_hash": {"anyOf": [{"$ref": "#/$defs/hashRef"}, {"type": "null"}]},
    "allocated_at": {"type": "string", "format": "date-time"},
    "request_bound_at": {"type": ["string", "null"], "format": "date-time"},
    "invocation_started_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {"enum": ["SUCCEEDED", "FAILED", "BLOCKED", "CANCELLED"]}
        }
      },
      "then": {
        "properties": {
          "result_summary_ref": {"$ref": "#/$defs/ref"},
          "result_summary_hash": {"$ref": "#/$defs/hashRef"},
          "request_bound_at": {"type": "string", "format": "date-time"},
          "invocation_started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {"enum": ["ALLOCATED", "REQUEST_BOUND", "RUNNING"]}
        }
      },
      "then": {
        "properties": {
          "result_summary_ref": {"const": null},
          "result_summary_hash": {"const": null},
          "completed_at": {"const": null}
        }
      }
    }
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "boundedText": {"type": "string", "minLength": 1, "maxLength": 256},
    "ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "hashRef": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
