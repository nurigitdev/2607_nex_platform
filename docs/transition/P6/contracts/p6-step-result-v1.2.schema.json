{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nex:transition:p6:step-result:1.2",
  "title": "NeX P6 StepResult v1.2 Transition Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "step_result_id",
    "execution_id",
    "executable_plan_id",
    "executable_step_id",
    "compiled_step_key",
    "logical_step_ref",
    "executor_kind",
    "attempt_no",
    "status",
    "result_contract_ref",
    "result_payload",
    "external_refs",
    "artifact_refs",
    "evidence_refs",
    "error_ref",
    "business_operation_id",
    "operation_fingerprint",
    "started_at",
    "completed_at",
    "result_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "step_result_id": {"$ref": "#/$defs/uuid"},
    "execution_id": {"$ref": "#/$defs/uuid"},
    "executable_plan_id": {"$ref": "#/$defs/uuid"},
    "executable_step_id": {"$ref": "#/$defs/uuid"},
    "compiled_step_key": {"type": "string", "pattern": "^E[0-9]{1,3}$"},
    "logical_step_ref": {"type": "string", "pattern": "^S[0-9]{1,3}$"},
    "executor_kind": {
      "enum": [
        "P4_CHAT_RAG_COMPATIBILITY",
        "DETERMINISTIC_AGGREGATE",
        "DETERMINISTIC_REPORT",
        "LOCAL_SKILL"
      ]
    },
    "attempt_no": {"type": "integer", "minimum": 1},
    "status": {"enum": ["SUCCEEDED", "FAILED", "BLOCKED", "CANCELLED"]},
    "result_contract_ref": {"$ref": "#/$defs/ref"},
    "result_payload": {"type": "object"},
    "external_refs": {"$ref": "#/$defs/refArray64"},
    "artifact_refs": {"$ref": "#/$defs/refArray64"},
    "evidence_refs": {"$ref": "#/$defs/refArray128"},
    "error_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "business_operation_id": {"type": ["string", "null"], "format": "uuid"},
    "operation_fingerprint": {"const": null},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "result_hash": {"$ref": "#/$defs/hashRef"}
  },
  "allOf": [
    {
      "if": {"properties": {"executor_kind": {"const": "LOCAL_SKILL"}}},
      "then": {"properties": {"business_operation_id": {"$ref": "#/$defs/uuid"}}},
      "else": {"properties": {"business_operation_id": {"const": null}}}
    }
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "hashRef": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "refArray64": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "refArray128": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    }
  }
}
