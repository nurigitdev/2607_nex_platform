      }
    },
    "project_ref": {
      "type": "string",
      "minLength": 1
    },
    "resource_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "operation_class": {
      "type": "string",
      "minLength": 1
    },
    "data_classification": {
      "type": [
        "string",
        "null"
      ]
    },
    "typed_parameters": {
      "type": "object"
    },
    "business_object_type": {
      "type": "string",
      "minLength": 1
    },
    "operation_fingerprint": {
      "type": "string",
      "minLength": 1
