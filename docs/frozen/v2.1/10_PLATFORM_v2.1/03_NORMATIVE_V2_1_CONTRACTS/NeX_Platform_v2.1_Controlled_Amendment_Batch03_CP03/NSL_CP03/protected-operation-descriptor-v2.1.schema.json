    },
    "agent_execution_id": {
      "type": "string",
      "minLength": 1
    },
    "executable_step_id": {
      "type": "string",
      "minLength": 1
    },
    "business_operation_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "org_scope_refs": {
      "type": "array",
