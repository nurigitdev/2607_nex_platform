    },
    "skill_version": {
      "type": "string"
    },
    "skill_semantic_hash": {
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "package_hash": {
      "type": "string"
    },
    "publisher_id": {
      "type": "string",
      "minLength": 1
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1
    },
    "package_trust_evidence_ref": {
      "type": "string",
      "minLength": 1
