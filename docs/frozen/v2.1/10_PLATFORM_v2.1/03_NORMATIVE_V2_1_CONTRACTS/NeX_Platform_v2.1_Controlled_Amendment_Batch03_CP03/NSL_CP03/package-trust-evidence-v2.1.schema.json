{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nex:nsl:package-trust-evidence:v2.1",
  "title": "PackageTrustEvidence v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "package_hash",
    "publisher_id",
    "signing_key_id",
    "verified_at",
    "trust_policy_id",
    "trust_status",
    "governance_status",
    "governance_decision_ref"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "package_hash": {
      "type": "string",
      "minLength": 1
    },
    "publisher_id": {
      "type": "string",
      "minLength": 1
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "trust_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "trust_status": {
      "const": "VALID"
    },
    "governance_status": {
      "const": "ACTIVE"
    },
    "governance_decision_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}