{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CXIngestionRequest v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "source",
    "authority_ref"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object"
    },
    "authority_ref": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "requested_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}