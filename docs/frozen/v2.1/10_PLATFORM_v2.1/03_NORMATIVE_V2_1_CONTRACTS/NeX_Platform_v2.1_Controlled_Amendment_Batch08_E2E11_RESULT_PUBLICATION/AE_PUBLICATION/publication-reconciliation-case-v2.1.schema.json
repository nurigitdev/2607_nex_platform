{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nex:ae:publication-reconciliation-case:v2.1",
  "title": "AE PublicationReconciliationCase v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication_reconciliation_id",
    "tenant_id",
    "agent_execution_id",
    "result_id",
    "result_delivery_id",
    "publication_operation_id",
    "idempotency_key_ref",
    "target_type",
    "target_ref",
    "reason",
    "state",
    "attempt_no",
    "correlation_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "publication_reconciliation_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_execution_id": {
      "type": "string",
      "minLength": 1
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "result_delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "publication_operation_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_type": {
      "enum": [
        "WORKSPACE_RESULT",
        "WC_WORK_RESULT",
        "ARTIFACT_STORE",
        "NOTIFICATION",
        "EMAIL",
        "MESSENGER",
        "WA_PROJECTION",
        "METRICS",
        "ANALYTICS",
        "DASHBOARD_CACHE"
      ]
    },
    "target_ref": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "const": "UNKNOWN_DELIVERY"
    },
    "state": {
      "enum": [
        "PENDING",
        "CHECKING",
        "RESOLVED_ACKNOWLEDGED",
        "RESOLVED_NOT_DELIVERED",
        "STILL_UNKNOWN",
        "CONFLICT",
        "ESCALATED"
      ]
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 0
    },
    "next_check_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deadline_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "latest_outcome_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
