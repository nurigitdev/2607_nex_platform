{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScheduleOccurrence v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "occurrence_id",
    "schedule_id",
    "schedule_version",
    "nominal_time",
    "state",
    "materialization_key"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1
    },
    "schedule_id": {
      "type": "string",
      "minLength": 1
    },
    "schedule_version": {
      "type": "integer",
      "minimum": 1
    },
    "nominal_time": {
      "type": "string",
      "format": "date-time"
    },
    "actual_evaluated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "state": {
      "enum": [
        "DUE",
        "MATERIALIZING",
        "MATERIALIZED",
        "SKIPPED",
        "FAILED"
      ]
    },
    "materialization_key": {
      "type": "string",
      "minLength": 1
    },
    "materialized_work_item_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "skip_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "MATERIALIZED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "materialized_work_item_ref"
        ],
        "properties": {
          "materialized_work_item_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "SKIPPED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "skip_reason"
        ],
        "properties": {
          "skip_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "FAILED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "failure_ref"
        ],
        "properties": {
          "failure_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
