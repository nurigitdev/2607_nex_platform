{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nex:schema:ae:agent-identity:2.1",
  "title": "NeX AgentIdentity v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "agent_id",
    "agent_type",
    "profile_ref",
    "status",
    "created_at",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_type": {
      "enum": [
        "IA",
        "CA",
        "PA",
        "EA"
      ]
    },
    "profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "RETIRED"
      ]
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "agent_type"
        ],
        "properties": {
          "agent_type": {
            "const": "PA"
          }
        }
      },
      "then": {
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}