{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nex:schema:wc:work-result:2.1",
  "title": "NeX WorkResult v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "result_id",
    "work_item_id",
    "revision_no",
    "result_type",
    "technical_outcome",
    "business_outcome",
    "submitted_by",
    "trace",
    "submitted_at"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_no": {
      "type": "integer",
      "minimum": 1
    },
    "result_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "payload": {},
    "schema_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "technical_outcome": {
      "enum": [
        "SUCCEEDED",
        "PARTIAL",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "business_outcome": {
      "enum": [
        "VERIFIED",
        "REVISED",
        "REJECTED",
        "PENDING_VERIFICATION",
        "NOT_APPLICABLE"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRef"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRef"
      }
    },
    "business_object_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityRef"
      }
    },
    "source_execution_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "source_plan_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "claim_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "claim_generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "assignment_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "submitted_by": {
      "$ref": "#/$defs/entityRef"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation_id"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_type",
        "entity_id"
      ],
      "properties": {
        "entity_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "entity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "submitted_by": {
            "properties": {
              "entity_type": {
                "const": "AGENT"
              }
            },
            "required": [
              "entity_type"
            ]
          }
        },
        "required": [
          "submitted_by"
        ]
      },
      "then": {
        "required": [
          "source_execution_ref",
          "claim_ref",
          "claim_generation",
          "assignment_ref"
        ],
        "properties": {
          "source_execution_ref": {
            "type": "string",
            "minLength": 1
          },
          "claim_ref": {
            "type": "string",
            "minLength": 1
          },
          "claim_generation": {
            "type": "integer",
            "minimum": 1
          },
          "assignment_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}