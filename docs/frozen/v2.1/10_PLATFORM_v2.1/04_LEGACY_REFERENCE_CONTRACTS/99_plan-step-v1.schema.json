{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nex:schema:agent:plan-step:1.0",
  "title": "NeX PlanStep v1",
  "description": "Immutable logical plan step. Runtime/compiler concerns such as resolved skill versions, gate nodes, actual assignees and status are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "step_type",
    "title",
    "objective",
    "depends_on",
    "input_bindings",
    "completion_criteria"
  ],
  "properties": {
    "step_id": {
      "type": "string",
      "pattern": "^S[0-9]{1,3}$"
    },
    "step_type": {
      "enum": [
        "LOCAL_CAPABILITY",
        "DELEGATE_WORK",
        "AGGREGATE",
        "REPORT"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700
    },
    "depends_on": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^S[0-9]{1,3}$"
      }
    },
    "required_capability": {
      "anyOf": [
        {
          "$ref": "#/$defs/capabilityId"
        },
        {
          "type": "null"
        }
      ]
    },
    "capability_version_constraint": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "input_bindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/inputBinding"
      }
    },
    "expected_output": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "semantic_name": {
          "type": "string",
          "maxLength": 128
        },
        "schema_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "delegation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "work_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "work_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "routing_target_hint": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "target_type": {
              "enum": [
                "PERSON",
                "ROLE",
                "ORG_UNIT",
                "CAPABILITY_POOL",
                "EXPERT_POOL"
              ]
            },
            "selector_ref": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128,
              "description": "Reference to a WorkIntent selector when the requester explicitly named a person/role/org."
            }
          },
          "required": [
            "target_type"
          ]
        },
        "required_result_contract": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      },
      "required": [
        "work_title",
        "work_description"
      ]
    },
    "aggregation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "DETERMINISTIC_MERGE",
            "STRUCTURED_MERGE",
            "LLM_SYNTHESIS"
          ]
        },
        "source_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^S[0-9]{1,3}$"
          }
        },
        "output_schema_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      },
      "required": [
        "mode",
        "source_steps"
      ]
    },
    "report": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "report_type": {
          "enum": [
            "INTERACTIVE_RESPONSE",
            "WORK_RESULT",
            "ARTIFACT"
          ]
        },
        "artifact_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "audience": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        }
      },
      "required": [
        "report_type"
      ]
    },
    "planner_rationale_summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 700,
      "description": "Short user-safe rationale summary; never private chain-of-thought."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "step_type": {
            "const": "LOCAL_CAPABILITY"
          }
        },
        "required": [
          "step_type"
        ]
      },
      "then": {
        "properties": {
          "required_capability": {
            "$ref": "#/$defs/capabilityId"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "step_type": {
            "const": "DELEGATE_WORK"
          }
        },
        "required": [
          "step_type"
        ]
      },
      "then": {
        "properties": {
          "required_capability": {
            "$ref": "#/$defs/capabilityId"
          },
          "delegation": {
            "type": "object"
          }
        },
        "required": [
          "required_capability",
          "delegation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "step_type": {
            "const": "AGGREGATE"
          }
        },
        "required": [
          "step_type"
        ]
      },
      "then": {
        "properties": {
          "aggregation": {
            "type": "object"
          }
        },
        "required": [
          "aggregation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "step_type": {
            "const": "REPORT"
          }
        },
        "required": [
          "step_type"
        ]
      },
      "then": {
        "properties": {
          "report": {
            "type": "object"
          }
        },
        "required": [
          "report"
        ]
      }
    }
  ],
  "$defs": {
    "capabilityId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
      "maxLength": 160
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_name",
        "source_type"
      ],
      "properties": {
        "target_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "source_type": {
          "enum": [
            "WORK_INTENT",
            "RESOLVED_CONTEXT",
            "STEP_OUTPUT",
            "CONSTANT"
          ]
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "json_pointer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "constant_value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "CONSTANT"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "required": [
              "constant_value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "STEP_OUTPUT"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "required": [
              "source_ref"
            ]
          }
        }
      ]
    }
  }
}