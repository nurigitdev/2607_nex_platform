{
  "document": "32_Reliability_JobQueue_Worker_Recovery_Design_v2.0",
  "version": "v2.0",
  "date": "2026-09-04",
  "counts": {
    "MUST": 133,
    "SHOULD": 15
  },
  "requirements": [
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-001",
      "priority": "MUST",
      "requirement": "모든 NeX 서비스의 비동기 실행은 공통 Reliability Contract를 따르되 Job/Worker 상태는 각 서비스 Local DB가 소유해야 한다.",
      "verification": "Architecture",
      "parent": "00/31"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-002",
      "priority": "MUST",
      "requirement": "Global 중앙 Job DB를 서비스 간 authoritative state store로 사용해서는 안 되며 AG는 projection/operations plane으로만 동작해야 한다.",
      "verification": "Architecture",
      "parent": "30/31"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-003",
      "priority": "MUST",
      "requirement": "Job delivery의 중복 가능성을 전제로 하고 business effect exactly-once를 JobQueue 자체의 속성으로 주장해서는 안 된다.",
      "verification": "Inspection/Fault",
      "parent": "12/17/31"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-004",
      "priority": "MUST",
      "requirement": "Job Lease, Work Claim/Lease, Business Idempotency를 서로 다른 coordination/side-effect 개념으로 유지해야 한다.",
      "verification": "Architecture",
      "parent": "12/14/31"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-005",
      "priority": "MUST",
      "requirement": "Cross-service write는 distributed 2PC로 묶지 않고 local transaction + idempotency + explicit commit state + reconciliation으로 연결해야 한다.",
      "verification": "Fault/Architecture",
      "parent": "12/17/31"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-006",
      "priority": "MUST",
      "requirement": "Failure/timeout/duplicate/out-of-order/stale/partial 상태를 silent success로 변환해서는 안 된다.",
      "verification": "Fault",
      "parent": "31"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-007",
      "priority": "MUST",
      "requirement": "모든 reliability object는 correlation_id를 유지하고 causation_id로 parent work/event/recovery action을 연결해야 한다.",
      "verification": "Trace",
      "parent": "31"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-008",
      "priority": "MUST",
      "requirement": "서비스 간 recovery가 타 서비스 DB를 직접 수정해서는 안 되며 owner service contract를 사용해야 한다.",
      "verification": "Architecture",
      "parent": "31"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-009",
      "priority": "MUST",
      "requirement": "Recovery가 business state를 추측해서는 안 되고 authoritative SoR의 현재 상태와 version/ref를 확인해야 한다.",
      "verification": "Fault/State",
      "parent": "31/EOS/WC"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-010",
      "priority": "MUST",
      "requirement": "정상 Runtime hot path는 NeX-AG 가용성에 의존해서는 안 된다.",
      "verification": "Fault",
      "parent": "30"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-011",
      "priority": "MUST",
      "requirement": "Protected action/Resume에서 current OA/PDP 확인이 필요한 경우 authority 확인 실패를 성공이나 cached grant로 우회해서는 안 된다.",
      "verification": "Security Fault",
      "parent": "26/31"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-012",
      "priority": "MUST",
      "requirement": "Reliability 상태와 Domain 상태를 분리하여 Job SUCCEEDED가 AgentExecution/WorkItem/BusinessTransaction 완료를 의미하지 않도록 해야 한다.",
      "verification": "State",
      "parent": "11/14/31"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-013",
      "priority": "SHOULD",
      "requirement": "각 서비스는 동일 logical contract를 내부 table명/package 구조에 맞게 mapping할 수 있어야 한다.",
      "verification": "Architecture",
      "parent": "32"
    },
    {
      "section": "4.1 Common Reliability Contract",
      "id": "NEX-REL-COM-FR-014",
      "priority": "MUST",
      "requirement": "Common Reliability Contract의 version/hash를 service capability/health endpoint에서 확인할 수 있어야 한다.",
      "verification": "Contract",
      "parent": "30/32"
    },
    {
      "section": "4.2 Job / Attempt Model",
      "id": "NEX-REL-JOB-FR-001",
      "priority": "MUST",
      "requirement": "Job은 job_id, job_type, queue_name, priority, payload_ref, status, available_at, attempt/max_attempts, correlation_id, version을 가져야 한다.",
      "verification": "Schema",
      "parent": "32"
    },
    {
      "section": "4.2 Job / Attempt Model",
      "id": "NEX-REL-JOB-FR-002",
      "priority": "MUST",
      "requirement": "대용량/민감 payload를 Job row에 무제한 복제하지 않고 owner data/ref/hash를 사용할 수 있어야 한다.",
      "verification": "Data/Security",
      "parent": "31"
    },
    {
      "section": "4.2 Job / Attempt Model",
      "id": "NEX-REL-JOB-FR-003",
      "priority": "MUST",
      "requirement": "Job status는 최소 QUEUED/RUNNING/SUCCEEDED/FAILED/CANCELLED/DEAD_LETTER/RECONCILIATION_REQUIRED를 구분해야 한다.",
      "verification": "State",
      "parent": "32"
    },
    {
      "section": "4.2 Job / Attempt Model",
      "id": "NEX-REL-JOB-FR-004",
      "priority": "MUST",
      "requirement": "장기 business wait는 Job RUNNING/WAITING worker 점유로 표현하지 않고 Domain Wait/Checkpoint로 분리해야 한다.",
      "verification": "State/Fault",
      "parent": "12/31"
    },
    {
      "section": "4.2 Job / Attempt Model",
      "id": "NEX-REL-JOB-FR-005",
      "priority": "MUST",
      "requirement": "재시도 대기는 QUEUED + available_at/next_retry_at으로 스케줄링하고 Worker sleep으로 점유해서는 안 된다.",
      "verification": "Fault",
      "parent": "32"
    },
    {
      "section": "4.2 Job / Attempt Model",
      "id": "NEX-REL-JOB-FR-006",
      "priority": "MUST",
      "requirement": "JobAttempt는 attempt_id, job_id, worker_id, lease_token, started/ended, outcome/error, retry_decision을 append 방식으로 보존해야 한다.",
      "verification": "Schema",
      "parent": "32"
    },
    {
      "section": "4.2 Job / Attempt Model",
      "id": "NEX-REL-JOB-FR-007",
      "priority": "MUST",
      "requirement": "Job completion/failure transition은 optimistic version 또는 current lease token으로 stale worker를 거부해야 한다.",
      "verification": "Concurrency",
      "parent": "12/32"
    },
    {
      "section": "4.2 Job / Attempt Model",
      "id": "NEX-REL-JOB-FR-008",
      "priority": "MUST",
      "requirement": "Job enqueue는 dedup_key 또는 idempotent creation contract를 지원해 동일 logical enqueue가 중복 Job을 만들지 않게 할 수 있어야 한다.",
      "verification": "Fault",
      "parent": "31"
    },
    {
      "section": "4.2 Job / Attempt Model",
      "id": "NEX-REL-JOB-FR-009",
      "priority": "SHOULD",
      "requirement": "Job dependency는 서비스 내부 batch/maintenance에 필요할 때만 명시적으로 모델링하고 Domain Work dependency를 대체해서는 안 된다.",
      "verification": "Architecture",
      "parent": "32"
    },
    {
      "section": "4.2 Job / Attempt Model",
      "id": "NEX-REL-JOB-FR-010",
      "priority": "MUST",
      "requirement": "Job payload/result/error에 raw token/private key/secret을 저장해서는 안 된다.",
      "verification": "Security Scan",
      "parent": "26"
    },
    {
      "section": "4.3 Atomic Claim / Lease / Heartbeat",
      "id": "NEX-REL-LEASE-FR-001",
      "priority": "MUST",
      "requirement": "여러 Worker의 claim은 PostgreSQL FOR UPDATE SKIP LOCKED 또는 동등한 atomic claim을 사용해야 한다.",
      "verification": "Concurrency",
      "parent": "12/Platform"
    },
    {
      "section": "4.3 Atomic Claim / Lease / Heartbeat",
      "id": "NEX-REL-LEASE-FR-002",
      "priority": "MUST",
      "requirement": "Claim 성공 시 worker_id, lease_token, lease_expires_at을 원자적으로 기록해야 한다.",
      "verification": "DB Test",
      "parent": "32"
    },
    {
      "section": "4.3 Atomic Claim / Lease / Heartbeat",
      "id": "NEX-REL-LEASE-FR-003",
      "priority": "MUST",
      "requirement": "Heartbeat/complete/fail은 current lease_token이 일치하는 Worker만 수행할 수 있어야 한다.",
      "verification": "Concurrency",
      "parent": "12"
    },
    {
      "section": "4.3 Atomic Claim / Lease / Heartbeat",
      "id": "NEX-REL-LEASE-FR-004",
      "priority": "MUST",
      "requirement": "Lease 만료 후 다른 Worker가 reclaim할 수 있어야 하며 이전 Worker의 stale completion은 거부해야 한다.",
      "verification": "Fault",
      "parent": "12/31"
    },
    {
      "section": "4.3 Atomic Claim / Lease / Heartbeat",
      "id": "NEX-REL-LEASE-FR-005",
      "priority": "MUST",
      "requirement": "Lease timeout은 job type/profile별로 설정 가능하되 remote side effect retry safety와 독립적으로 관리해야 한다.",
      "verification": "Policy/Fault",
      "parent": "32"
    },
    {
      "section": "4.3 Atomic Claim / Lease / Heartbeat",
      "id": "NEX-REL-LEASE-FR-006",
      "priority": "MUST",
      "requirement": "DB server time 또는 일관된 clock source를 lease 판단의 기준으로 사용해야 한다.",
      "verification": "Clock/DB Test",
      "parent": "32"
    },
    {
      "section": "4.3 Atomic Claim / Lease / Heartbeat",
      "id": "NEX-REL-LEASE-FR-007",
      "priority": "SHOULD",
      "requirement": "장시간 step은 heartbeat를 주기적으로 갱신하고 lease remaining threshold 경고를 노출할 수 있어야 한다.",
      "verification": "Monitoring",
      "parent": "32"
    },
    {
      "section": "4.3 Atomic Claim / Lease / Heartbeat",
      "id": "NEX-REL-LEASE-FR-008",
      "priority": "MUST",
      "requirement": "Worker crash 후 reclaim은 이미 발생했을 수 있는 business effect를 재실행할 권한을 의미하지 않는다.",
      "verification": "Fault/Idempotency",
      "parent": "12/17"
    },
    {
      "section": "4.3 Atomic Claim / Lease / Heartbeat",
      "id": "NEX-REL-LEASE-FR-009",
      "priority": "MUST",
      "requirement": "WC WorkClaim lease와 service Job lease를 별도 ID/metric으로 추적해야 한다.",
      "verification": "Trace",
      "parent": "14/31"
    },
    {
      "section": "4.4 Worker Runtime / Pool",
      "id": "NEX-REL-WRK-FR-001",
      "priority": "MUST",
      "requirement": "Worker는 가능한 한 stateless하게 유지하고 durable state는 Job/Checkpoint/Domain DB/SoR에 저장해야 한다.",
      "verification": "Architecture",
      "parent": "12/32"
    },
    {
      "section": "4.4 Worker Runtime / Pool",
      "id": "NEX-REL-WRK-FR-002",
      "priority": "MUST",
      "requirement": "Worker는 worker_id/type/hostname/process/version/status/current_job/last_heartbeat를 노출해야 한다.",
      "verification": "Schema/Monitoring",
      "parent": "Platform/30"
    },
    {
      "section": "4.4 Worker Runtime / Pool",
      "id": "NEX-REL-WRK-FR-003",
      "priority": "MUST",
      "requirement": "Logical worker type은 EXECUTION/RESUME/RECONCILIATION/PROJECTION/ARTIFACT/MAINTENANCE 등으로 구분할 수 있어야 한다.",
      "verification": "Architecture",
      "parent": "32"
    },
    {
      "section": "4.4 Worker Runtime / Pool",
      "id": "NEX-REL-WRK-FR-004",
      "priority": "MUST",
      "requirement": "Worker pool concurrency는 service/profile/job type/global policy로 제한 가능해야 한다.",
      "verification": "Load",
      "parent": "11/30"
    },
    {
      "section": "4.4 Worker Runtime / Pool",
      "id": "NEX-REL-WRK-FR-005",
      "priority": "MUST",
      "requirement": "High-risk WRITE/interactive/resume workload는 bulk/maintenance job으로부터 capacity isolation 또는 reserved concurrency를 가질 수 있어야 한다.",
      "verification": "Load/Recovery",
      "parent": "32"
    },
    {
      "section": "4.4 Worker Runtime / Pool",
      "id": "NEX-REL-WRK-FR-006",
      "priority": "MUST",
      "requirement": "Graceful drain 시 신규 claim을 중단하고 current job을 안전 종료/checkpoint하거나 lease 만료 전 handoff 가능한 상태로 만들어야 한다.",
      "verification": "Operation Test",
      "parent": "32/34"
    },
    {
      "section": "4.4 Worker Runtime / Pool",
      "id": "NEX-REL-WRK-FR-007",
      "priority": "MUST",
      "requirement": "강제 종료된 Worker가 재시작 후 local memory를 authority/state로 사용하지 않아야 한다.",
      "verification": "Crash Test",
      "parent": "32"
    },
    {
      "section": "4.4 Worker Runtime / Pool",
      "id": "NEX-REL-WRK-FR-008",
      "priority": "SHOULD",
      "requirement": "Worker binary/runtime version과 contract version을 JobAttempt provenance에 기록할 수 있어야 한다.",
      "verification": "Audit",
      "parent": "32"
    },
    {
      "section": "4.5 Scheduling / Priority / Fairness",
      "id": "NEX-REL-SCH-FR-001",
      "priority": "MUST",
      "requirement": "Job scheduling은 priority와 available_at을 반영해야 한다.",
      "verification": "DB Test",
      "parent": "32"
    },
    {
      "section": "4.5 Scheduling / Priority / Fairness",
      "id": "NEX-REL-SCH-FR-002",
      "priority": "SHOULD",
      "requirement": "Queue class는 INTERACTIVE/RESUME/HIGH/NORMAL/BULK/MAINTENANCE 등 logical class로 구분할 수 있어야 한다.",
      "verification": "Policy",
      "parent": "32"
    },
    {
      "section": "4.5 Scheduling / Priority / Fairness",
      "id": "NEX-REL-SCH-FR-003",
      "priority": "MUST",
      "requirement": "High priority 지속 유입 시 lower priority starvation을 막기 위한 aging/fairness 정책을 적용할 수 있어야 한다.",
      "verification": "Load",
      "parent": "32"
    },
    {
      "section": "4.5 Scheduling / Priority / Fairness",
      "id": "NEX-REL-SCH-FR-004",
      "priority": "MUST",
      "requirement": "Queue health는 queue_depth뿐 아니라 oldest_job_age/queue_lag를 핵심 지표로 제공해야 한다.",
      "verification": "Monitoring",
      "parent": "32/30"
    },
    {
      "section": "4.5 Scheduling / Priority / Fairness",
      "id": "NEX-REL-SCH-FR-005",
      "priority": "MUST",
      "requirement": "서비스/tenant/job type별 concurrency/admission quota를 적용할 수 있어야 한다.",
      "verification": "Load",
      "parent": "28/30"
    },
    {
      "section": "4.5 Scheduling / Priority / Fairness",
      "id": "NEX-REL-SCH-FR-006",
      "priority": "SHOULD",
      "requirement": "Scheduled recurring maintenance는 missed-run 정책(SKIP/CATCH_UP/LATEST_ONLY)을 명시할 수 있어야 한다.",
      "verification": "Scheduler Test",
      "parent": "32"
    },
    {
      "section": "4.6 Retry Classification / Backoff",
      "id": "NEX-REL-RTY-FR-001",
      "priority": "MUST",
      "requirement": "Retry decision은 최소 RETRY_WITH_BACKOFF/DO_NOT_RETRY/RECONCILE_FIRST/REPLAN_OR_ESCALATE를 구분해야 한다.",
      "verification": "Policy Test",
      "parent": "12/17/32"
    },
    {
      "section": "4.6 Retry Classification / Backoff",
      "id": "NEX-REL-RTY-FR-002",
      "priority": "MUST",
      "requirement": "TRANSIENT_TIMEOUT/THROTTLED/TEMP_UNAVAILABLE은 contract가 허용할 때 bounded retry 대상이 될 수 있어야 한다.",
      "verification": "Fault",
      "parent": "12/28"
    },
    {
      "section": "4.6 Retry Classification / Backoff",
      "id": "NEX-REL-RTY-FR-003",
      "priority": "MUST",
      "requirement": "PERMISSION_DENIED/VALIDATION_FAILED/APPROVAL_REJECTED/ENTITY_AMBIGUOUS 등 deterministic 오류를 동일 입력으로 자동 retry해서는 안 된다.",
      "verification": "Negative Test",
      "parent": "12/26"
    },
    {
      "section": "4.6 Retry Classification / Backoff",
      "id": "NEX-REL-RTY-FR-004",
      "priority": "MUST",
      "requirement": "STATE_CONFLICT는 최신 state를 re-read/re-evaluate한 뒤 동일 write overwrite가 아닌 새 deterministic decision으로 진행해야 한다.",
      "verification": "Concurrency",
      "parent": "12/EOS"
    },
    {
      "section": "4.6 Retry Classification / Backoff",
      "id": "NEX-REL-RTY-FR-005",
      "priority": "MUST",
      "requirement": "WRITE retry는 NOT_COMMITTED + retryable contract + stable idempotency key가 모두 확인된 경우에만 허용해야 한다.",
      "verification": "Fault",
      "parent": "17/31"
    },
    {
      "section": "4.6 Retry Classification / Backoff",
      "id": "NEX-REL-RTY-FR-006",
      "priority": "MUST",
      "requirement": "UNKNOWN_COMMIT_STATE는 모든 일반 retry path보다 우선하여 RECONCILE_FIRST로 분류해야 한다.",
      "verification": "Fault",
      "parent": "17/31"
    },
    {
      "section": "4.6 Retry Classification / Backoff",
      "id": "NEX-REL-RTY-FR-007",
      "priority": "MUST",
      "requirement": "Exponential backoff + jitter 또는 동등한 분산 backoff를 지원해야 한다.",
      "verification": "Unit/Load",
      "parent": "32"
    },
    {
      "section": "4.6 Retry Classification / Backoff",
      "id": "NEX-REL-RTY-FR-008",
      "priority": "MUST",
      "requirement": "Retry는 max_attempts/max_elapsed_time/absolute deadline 중 정책이 요구하는 bounded limit을 가져야 한다.",
      "verification": "Boundary",
      "parent": "32"
    },
    {
      "section": "4.6 Retry Classification / Backoff",
      "id": "NEX-REL-RTY-FR-009",
      "priority": "MUST",
      "requirement": "429/overload retry는 provider Retry-After 또는 service capacity policy를 존중해야 한다.",
      "verification": "Integration",
      "parent": "28/32"
    },
    {
      "section": "4.6 Retry Classification / Backoff",
      "id": "NEX-REL-RTY-FR-010",
      "priority": "MUST",
      "requirement": "Retry attempt는 기존 correlation과 operation identity를 보존하되 개별 request_id/attempt_id는 새 값일 수 있어야 한다.",
      "verification": "Trace",
      "parent": "08/17"
    },
    {
      "section": "4.7 Idempotency Layers",
      "id": "NEX-REL-IDM-FR-001",
      "priority": "MUST",
      "requirement": "Job dedup key, Event id, request_id, Business idempotency_key를 서로 다른 의미로 정의해야 한다.",
      "verification": "Architecture",
      "parent": "17/31"
    },
    {
      "section": "4.7 Idempotency Layers",
      "id": "NEX-REL-IDM-FR-002",
      "priority": "MUST",
      "requirement": "Business idempotency_key는 현재 timestamp/random retry attempt가 아니라 stable business operation identity에서 생성되어야 한다.",
      "verification": "Unit",
      "parent": "17/29"
    },
    {
      "section": "4.7 Idempotency Layers",
      "id": "NEX-REL-IDM-FR-003",
      "priority": "MUST",
      "requirement": "동일 key + 동일 semantic payload는 기존 결과를 재사용하거나 provider의 동일 business result를 반환해야 한다.",
      "verification": "Idempotency Test",
      "parent": "17"
    },
    {
      "section": "4.7 Idempotency Layers",
      "id": "NEX-REL-IDM-FR-004",
      "priority": "MUST",
      "requirement": "동일 key + 다른 semantic payload는 IDEMPOTENCY_CONFLICT로 fail-closed해야 한다.",
      "verification": "Negative Test",
      "parent": "17"
    },
    {
