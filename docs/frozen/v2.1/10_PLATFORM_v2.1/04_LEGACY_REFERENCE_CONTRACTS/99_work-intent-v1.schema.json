{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nex:schema:agent:work-intent:1.0",
  "title": "NeX WorkIntent v1",
  "description": "Immutable structured output of the Understand stage. It contains selectors and candidates, not authoritative business entity IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "source",
    "execution_mode",
    "goal",
    "work_class",
    "required_capability_hints",
    "entity_selectors",
    "parameter_candidates",
    "completion_criteria",
    "clarification",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "intent_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_ref",
        "actor_type",
        "actor_ref",
        "received_at"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "PROMPT",
            "WORKITEM",
            "EVENT",
            "SCHEDULE"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "actor_type": {
          "enum": [
            "EMPLOYEE",
            "COWORKER_AGENT",
            "EXPERT_AGENT",
            "SYSTEM",
            "EXTERNAL_AGENT"
          ]
        },
        "actor_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "execution_mode": {
      "enum": [
        "INTERACTIVE",
        "BACKGROUND_COWORKER",
        "BACKGROUND_EXPERT",
        "SYSTEM",
        "EXTERNAL"
      ]
    },
    "domain_hint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "intent_label": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160,
      "description": "Human-readable label only; never an execution authority."
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "work_class": {
      "enum": [
        "QUERY",
        "ANALYSIS",
        "DOCUMENT",
        "BUSINESS_TRANSACTION",
        "COORDINATION",
        "EXPERT_REVIEW",
        "REPORTING"
      ]
    },
    "required_capability_hints": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capabilityId"
      }
    },
    "entity_selectors": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/entitySelector"
      }
    },
    "parameter_candidates": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/parameterCandidate"
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/completionCriterion"
      }
    },
    "planning_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preference"
      ],
      "properties": {
        "preference": {
          "enum": [
            "DIRECT_IF_POSSIBLE",
            "PLAN_REQUIRED",
            "NO_PREFERENCE"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reasons",
        "questions"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "AMBIGUOUS_INTENT",
              "AMBIGUOUS_ENTITY",
              "MISSING_REQUIRED_PARAMETER",
              "CONFLICTING_CONSTRAINT",
              "UNRESOLVED_PROJECT",
              "UNSUPPORTED_REQUEST",
              "OTHER"
            ]
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall"
      ],
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "intent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "entities": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "parameters": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_template_id": {
          "type": "string",
          "maxLength": 128
        },
        "prompt_template_version": {
          "type": "string",
          "maxLength": 64
        },
        "model_profile": {
          "type": "string",
          "maxLength": 128
        },
        "model_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_context_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{32,128}$"
        }
      }
    }
  },
  "$defs": {
    "capabilityId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$",
      "maxLength": 160
    },
    "entitySelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector_id",
        "entity_type",
        "selector_type",
        "raw_text",
        "required",
        "confidence"
      ],
      "properties": {
        "selector_id": {
          "type": "string",
          "pattern": "^E[0-9]{1,3}$"
        },
        "entity_type": {
          "enum": [
            "EMPLOYEE",
            "ORG_UNIT",
            "ROLE",
            "PROJECT",
            "NVT_PROJECT",
            "ACCOUNT",
            "VENDOR",
            "CUSTOMER",
            "CONTRACT",
            "ARTIFACT",
            "BUSINESS_OBJECT",
            "EXPERT_DOMAIN",
            "OTHER"
          ]
        },
        "selector_type": {
          "enum": [
            "NAME",
            "RELATIVE_ROLE",
            "ORG_ROLE",
            "CODE",
            "TEXT_QUERY",
            "CURRENT_CONTEXT",
            "PARENT_CONTEXT",
            "OTHER"
          ]
        },
        "raw_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        },
        "required": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "parameterCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "value_type",
        "confidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "value": {},
        "value_type": {
          "enum": [
            "STRING",
            "INTEGER",
            "DECIMAL",
            "BOOLEAN",
            "DATE",
            "DATETIME",
            "MONEY",
            "DURATION",
            "ENUM",
            "JSON",
            "NULL"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "source_text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_type": {
                "enum": [
                  "DECIMAL",
                  "MONEY"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "INTEGER"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "BOOLEAN"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "NULL"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_type",
        "description"
      ],
      "properties": {
        "constraint_type": {
          "enum": [
            "DEADLINE",
            "BUDGET",
            "PROJECT_SCOPE",
            "ORG_SCOPE",
            "OUTPUT_FORMAT",
            "POLICY",
            "USER_PREFERENCE",
            "OTHER"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source_text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "completionCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "description",
        "required"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^C[0-9]{1,3}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "required": {
          "type": "boolean"
        },
        "verification_hint": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    }
  }
}