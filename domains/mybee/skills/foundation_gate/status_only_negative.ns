language NSL "0.2";

skill W70.FOUNDATION.STATUS_ONLY_NEGATIVE {
    version "1.0.0";
    risk READ_ONLY;

    requires {
        tool FINANCE.FX_RATE.HISTORY version "1.0.0";
    }

    limits {
        tool_calls 1;
        loop_iterations 1;
        emitted_rows 1;
        collection_size 1;
    }

    input {
        query: String classification INTERNAL;
    }

    output {
        result: String classification INTERNAL;
    }

    let observed = read FINANCE.FX_RATE.HISTORY(query: query);

    emit {
        result: observed.result;
    }
}
