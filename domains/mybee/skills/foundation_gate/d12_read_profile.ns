language NSL "0.2";

skill W70.FOUNDATION.D12_READ_PROFILE {
    version "1.0.0";
    risk READ_ONLY;

    requires {
        tool PROJECT.WORK_CODE_SET.GET version "1.0.0";
    }

    limits {
        tool_calls 1;
        loop_iterations 1;
        emitted_rows 1;
        collection_size 1;
    }

    input {
        query: String classification INTERNAL;
    }

    output {
        result: String classification INTERNAL;
    }

    let observed = read PROJECT.WORK_CODE_SET.GET(query: query);

    emit {
        result: observed.result;
    }
}
