{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/mybee/skill_pack_bindings.schema.json",
  "title": "NeX MyBee W70 candidate Skill bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "domain_code",
    "bindings",
    "release_attestation"
  ],
  "properties": {
    "schema_version": {"const": "nex.mybee.skill-pack-bindings.v1"},
    "pack_id": {"enum": ["MYBEE.D04.ACCOUNTING", "MYBEE.D12.PROJECT"]},
    "pack_version": {"const": "1.0.0"},
    "domain_code": {"enum": ["D04_ACCOUNTING", "D12_PROJECT"]},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/binding"}
    },
    "release_attestation": {"$ref": "#/$defs/attestation"}
  },
  "$defs": {
    "hash_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"
    },
    "contract_ref": {
      "type": "string",
      "pattern": "^(contracts/(schemas/service/nex_eos/[a-z0-9_]+\\.v[0-9]+\\.schema\\.json|openapi/nex-eos\\.openapi\\.yaml#/components/schemas/[A-Za-z][A-Za-z0-9]*|admissions/nex_eos/w70_tool_contract_admission\\.v1\\.json.+))$"
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency",
        "request_hash",
        "verification",
        "unknown_outcome",
        "timeout_profile"
      ],
      "properties": {
        "idempotency": {"enum": ["REQUIRED", "NOT_APPLICABLE"]},
        "request_hash": {"enum": ["PAYLOAD_HASH_REQUIRED", "QUERY_HASH_REQUIRED"]},
        "verification": {"enum": ["REQUIRED_BEFORE_ACTIVATION", "RESULT_HASH_REQUIRED"]},
        "unknown_outcome": {"enum": ["RECONCILE_BEFORE_RETRY", "NOT_APPLICABLE"]},
        "timeout_profile": {"const": "PENDING_ACTIVATION_SLICE"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "skill_version",
        "canonical_operation_id",
        "provider_operation_id",
        "invocation_semantics",
        "approval_requirement",
        "inventory_activation_state",
        "service_scope",
        "oa_action",
        "contract_admission_ref",
        "contract_typing_state",
        "input_contract_ref",
        "output_contract_refs",
        "compile_state",
        "runtime_selectable",
        "execution_policy",
        "activation_blockers"
      ],
      "properties": {
        "skill_id": {"$ref": "#/$defs/operation_id"},
        "skill_version": {"const": "1.0.0"},
        "canonical_operation_id": {"$ref": "#/$defs/operation_id"},
        "provider_operation_id": {"type": "string", "minLength": 1},
        "invocation_semantics": {"enum": ["READ", "GOVERNED_WRITE"]},
        "approval_requirement": {
          "enum": ["NONE", "NSL_WRITE", "BUSINESS_FORMAL", "ACCOUNTING_POSTING"]
        },
        "inventory_activation_state": {
          "enum": ["CANDIDATE", "ACTIVE_COMPATIBILITY", "DEFERRED"]
        },
        "service_scope": {"type": "string", "minLength": 1},
        "oa_action": {"type": "string", "minLength": 1},
        "contract_admission_ref": {
          "type": "string",
          "pattern": "^contracts/admissions/nex_eos/w70_tool_contract_admission\\.v1\\.json#/contracts/[0-9]+$"
        },
        "contract_typing_state": {"enum": ["FULLY_TYPED", "STATUS_ONLY"]},
        "input_contract_ref": {"$ref": "#/$defs/contract_ref"},
        "output_contract_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/contract_ref"}
        },
        "compile_state": {"const": "PENDING_S8_01E"},
        "runtime_selectable": {"const": false},
        "execution_policy": {"$ref": "#/$defs/execution_policy"},
        "activation_blockers": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PROJECT_OA_READ_POLICY_REQUIRED",
              "CANONICAL_SUCCESS_RESPONSE_SCHEMA_REQUIRED",
              "NSL_SOURCE_AND_COMPILE_REQUIRED",
              "SIGNED_BUNDLE_AND_TRUST_ADMISSION_REQUIRED",
              "AE_CAPABILITY_REGISTRY_RELEASE_REQUIRED",
              "PROTECTED_ACTIVATION_GATE_REQUIRED"
            ]
          }
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest"],
      "properties": {"content_digest": {"$ref": "#/$defs/hash_ref"}}
    }
  }
}
