NEX_PROFILE=local_mock
NEX_VERSION=0.0.0-slice0001
NEX_BUILD_SHA=local
NEX_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Shared local data roots. Keep machine-specific overrides in .env.local.
NEX_DATA_ROOT=/data/nex-platform
NEX_AE_ARTIFACT_STORAGE_ROOT=/data/nex-platform/ae/artifacts

# CX document ingestion and retrieval defaults.
NEX_CX_SOURCE_STORAGE_ROOT=/data/nex-platform/cx/source-files
NEX_CX_EXTRACTED_MARKDOWN_ROOT=/data/nex-platform/cx/extracted-markdown
NEX_CX_EXTRACTION_TEMP_ROOT=/data/nex-platform/cx/extraction-temp
NEX_CX_DEFAULT_CHUNK_POLICY=chunk_1000_100
NEX_CX_CHUNK_SIZE=1000
NEX_CX_CHUNK_OVERLAP=100
NEX_CX_BM25_TOKENIZER=mecab_ko
NEX_CX_BM25_TOKENIZER_FALLBACK=korean_mixed_v1

# MO model/provider defaults. local_mock stays the active test path until DGX-spark is reachable.
NEX_MO_PROVIDER_MODE=mock
NEX_MO_MODEL_ROOT=/data/nex-platform/models
NEX_MO_EMBEDDING_PROFILE=qwen3_embedding_4b_bf16
NEX_MO_RERANKER_PROFILE=qwen3_reranker_4b_bf16
NEX_MO_GENERATION_PROFILE=qwen3_6_27b_nvfp4
NEX_MO_EMBEDDING_MODEL_PATH=/data/nex-platform/models/qwen3-embedding-4b-bf16
NEX_MO_RERANKER_MODEL_PATH=/data/nex-platform/models/qwen3-reranker-4b-bf16
NEX_MO_GENERATION_MODEL_PATH=/data/nex-platform/models/qwen3.6-27b-nvfp4

# Development databases. Keep real passwords in .env.local, never in git.
NEX_OA_DATABASE_URL=postgresql://nex_oa_user:<password>@127.0.0.1:5432/nex_oa_dev
NEX_AG_DATABASE_URL=postgresql://nex_ag_user:<password>@127.0.0.1:5432/nex_ag_dev
NEX_AE_DATABASE_URL=postgresql://nex_ae_user:<password>@127.0.0.1:5432/nex_ae_dev
NEX_CX_DATABASE_URL=postgresql://nex_cx_user:<password>@127.0.0.1:5432/nex_cx_dev
NEX_MO_DATABASE_URL=postgresql://nex_mo_user:<password>@127.0.0.1:5432/nex_mo_dev

# Test databases. Slice 0002 will wire these into the quality gate.
NEX_OA_TEST_DATABASE_URL=postgresql://nex_oa_user:<password>@127.0.0.1:5432/nex_oa_test
NEX_AG_TEST_DATABASE_URL=postgresql://nex_ag_user:<password>@127.0.0.1:5432/nex_ag_test
NEX_AE_TEST_DATABASE_URL=postgresql://nex_ae_user:<password>@127.0.0.1:5432/nex_ae_test
NEX_CX_TEST_DATABASE_URL=postgresql://nex_cx_user:<password>@127.0.0.1:5432/nex_cx_test
NEX_MO_TEST_DATABASE_URL=postgresql://nex_mo_user:<password>@127.0.0.1:5432/nex_mo_test
