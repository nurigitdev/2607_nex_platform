NEX_PROFILE=local_mock
NEX_VERSION=0.0.0-slice0001
NEX_BUILD_SHA=local
NEX_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Shared local data roots. Keep machine-specific overrides in .env.local.
NEX_DATA_ROOT=/data/nex-platform
NEX_AE_ARTIFACT_STORAGE_ROOT=/data/nex-platform/ae/artifacts

# CX document ingestion and retrieval defaults.
NEX_CX_SOURCE_STORAGE_ROOT=/data/nex-platform/cx/source-files
NEX_CX_EXTRACTED_MARKDOWN_ROOT=/data/nex-platform/cx/extracted-markdown
NEX_CX_EXTRACTION_TEMP_ROOT=/data/nex-platform/cx/extraction-temp
NEX_CX_DEFAULT_CHUNK_POLICY=chunk_1000_100
NEX_CX_CHUNK_SIZE=1000
NEX_CX_CHUNK_OVERLAP=100
NEX_CX_BM25_TOKENIZER=mecab_ko
NEX_CX_BM25_TOKENIZER_FALLBACK=korean_mixed_v1
NEX_CX_MAX_UPLOAD_SIZE_BYTES=52428800

# MO model/provider defaults. local_mock stays the active test path until DGX-spark is reachable.
NEX_MO_PROVIDER_MODE=mock
NEX_MO_MODEL_ROOT=/data/nex-platform/models
NEX_MO_EMBEDDING_PROFILE=qwen3_embedding_4b_bf16
NEX_MO_RERANKER_PROFILE=qwen3_reranker_0_6b_bf16
NEX_MO_GENERATION_PROFILE=qwen3_5_122b_a10b_nvfp4
NEX_MO_EMBEDDING_MODEL_PATH=/data/nex-platform/models/qwen3-embedding-4b-bf16
NEX_MO_RERANKER_MODEL_PATH=/data/nex-platform/models/qwen3-reranker-0.6b-bf16
NEX_MO_GENERATION_MODEL_PATH=/data/nex-platform/models/qwen3.5-122b-a10b-nvfp4
NEX_MO_GENERATION_QWEN35_122B_MODEL_PATH=/data/nex-platform/models/qwen3.5-122b-a10b-nvfp4
NEX_MO_GENERATION_QWEN36_27B_MODEL_PATH=/data/nex-platform/models/qwen3.6-27b-nvfp4
NEX_MO_GENERATION_KAI_MODEL_PATH=/data/nex-platform/models/k-ai-generation-candidate

# Optional live DGX-Spark preflight. Keep disabled for default regression.
# Current production direction is direct vLLM serving for generation, embedding,
# and reranking. Keep NeX-PCX shape values only in explicit protected profiles.
NEX_MO_PROTECTED_LIVE_PROFILE=
# Supported protected profiles:
# - dgx_vllm: canonical direct vLLM profile
# - dgx: deprecated alias for dgx_vllm
# - dgx_pcx_legacy: explicit NeX-PCX request-shape compatibility profile
NEX_MO_LIVE_PREFLIGHT=0
NEX_MO_LIVE_TIMEOUT_SECONDS=5
NEX_MO_REMOTE_EMBEDDING_URL=
NEX_MO_REMOTE_EMBEDDING_API_KEY=
NEX_MO_REMOTE_EMBEDDING_REQUEST_SHAPE=openai_embeddings
NEX_MO_REMOTE_EMBEDDING_MODEL=Qwen3-Embedding-4B
NEX_MO_REMOTE_EMBEDDING_MODEL_REVISION=Qwen3-Embedding-4B
NEX_MO_REMOTE_EMBEDDING_DEPLOYMENT_ID=vllm-embedding-http
NEX_MO_REMOTE_RERANKER_URL=
NEX_MO_REMOTE_RERANKER_API_KEY=
NEX_MO_REMOTE_RERANKER_REQUEST_SHAPE=rerank
NEX_MO_REMOTE_RERANKER_MODEL=Qwen3-Reranker-0.6B
NEX_MO_REMOTE_RERANKER_MODEL_REVISION=Qwen3-Reranker-0.6B
NEX_MO_REMOTE_RERANKER_DEPLOYMENT_ID=vllm-reranker-http
NEX_MO_VLLM_BASE_URL=
NEX_MO_VLLM_MODELS_URL=
NEX_MO_VLLM_CHAT_COMPLETIONS_URL=
NEX_MO_VLLM_API_KEY=
NEX_MO_VLLM_MODEL=Qwen3.5-122B-A10B-NVFP4
NEX_MO_VLLM_MODEL_REVISION=Qwen3.5-122B-A10B-NVFP4
NEX_MO_VLLM_DEPLOYMENT_ID=vllm-generation-http
NEX_MO_LIVE_EXPECTED_EMBEDDING_MODELS=Qwen3-Embedding-4B
NEX_MO_LIVE_EXPECTED_RERANKER_MODELS=Qwen3-Reranker-0.6B
NEX_MO_LIVE_EXPECTED_GENERATION_MODELS=Qwen3.5-122B-A10B-NVFP4

# NeX-PCX compatibility request options. Leave blank for dgx_vllm. These are
# materialized by the protected dgx_pcx_legacy profile or by explicit PCX shape
# overrides in .env.local.
NEX_MO_REMOTE_EMBEDDING_PROFILE_NAME=
NEX_MO_REMOTE_EMBEDDING_MODEL_KEY=
NEX_MO_REMOTE_EMBEDDING_INPUT_TYPE=
NEX_MO_REMOTE_EMBEDDING_OUTPUT_DIMENSION=
NEX_MO_REMOTE_EMBEDDING_NORMALIZE=
NEX_MO_REMOTE_RERANKER_PROFILE_NAME=
NEX_MO_REMOTE_RERANKER_MODEL_ID=
NEX_MO_REMOTE_RERANKER_SOURCE_PROFILE_NAME=
NEX_MO_REMOTE_RERANKER_SOURCE_RETRIEVAL_STRATEGY=
NEX_MO_REMOTE_RERANKER_SOURCE_SCORE=

# Canonical compatible embedding/reranker provider source defaults.
# Keep provider runtime paths in process env only; never expose them in health/evidence.
NEX_COMPAT_PROVIDER_CAPABILITY=embedding
NEX_COMPAT_PROVIDER_BACKEND=mock
NEX_COMPAT_PROVIDER_MODEL_ROOT=/data/nex-platform/models
NEX_COMPAT_EMBEDDING_MODEL=Qwen3-Embedding-4B
NEX_COMPAT_RERANKER_MODEL=Qwen3-Reranker-0.6B
NEX_COMPAT_PROVIDER_MODEL_ID=
NEX_COMPAT_MODEL_REVISION=
NEX_COMPAT_EMBEDDING_DIMENSIONS=2560
NEX_COMPAT_PRECISION_POLICY=mock_no_model
NEX_COMPAT_REQUESTED_TORCH_DTYPE=mock
NEX_COMPAT_LOADED_PARAMETER_DTYPE=mock
NEX_COMPAT_PROVIDER_DEVICE=mock

# Protected compatible provider live smoke. Keep disabled in default regression.
NEX_COMPAT_LIVE_SMOKE=0
NEX_COMPAT_LIVE_TIMEOUT_SECONDS=10
NEX_COMPAT_EMBEDDING_URL=
NEX_COMPAT_EMBEDDING_MODELS_URL=
NEX_COMPAT_EMBEDDING_API_KEY=
NEX_COMPAT_RERANKER_URL=
NEX_COMPAT_RERANKER_MODELS_URL=
NEX_COMPAT_RERANKER_API_KEY=
NEX_COMPAT_LIVE_EXPECTED_EMBEDDING_MODEL=Qwen3-Embedding-4B
NEX_COMPAT_LIVE_EXPECTED_RERANKER_MODEL=Qwen3-Reranker-0.6B
NEX_COMPAT_LIVE_EXPECTED_EMBEDDING_DIMENSIONS=2560
NEX_COMPAT_EMBEDDING_REQUEST_DIMENSIONS=

# Deprecated 0051 names, retained as fallback aliases for existing local env files.
NEX_MO_LIVE_EMBEDDING_HEALTH_URL=
NEX_MO_LIVE_RERANKER_HEALTH_URL=
NEX_MO_LIVE_VLLM_MODELS_URL=

# Development databases. Keep real passwords in .env.local, never in git.
NEX_OA_DATABASE_URL=postgresql://nex_oa_user:<password>@127.0.0.1:5432/nex_oa_dev
NEX_AG_DATABASE_URL=postgresql://nex_ag_user:<password>@127.0.0.1:5432/nex_ag_dev
NEX_AE_DATABASE_URL=postgresql://nex_ae_user:<password>@127.0.0.1:5432/nex_ae_dev
NEX_CX_DATABASE_URL=postgresql://nex_cx_user:<password>@127.0.0.1:5432/nex_cx_dev
NEX_MO_DATABASE_URL=postgresql://nex_mo_user:<password>@127.0.0.1:5432/nex_mo_dev

# Optional vector database override. Empty means CX uses its primary database.
NEX_CX_VECTOR_DATABASE_URL=

