{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/common/tool_contract_admission.v1.schema.json",
  "title": "NeX W70 EOS Tool contract admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "admission_id",
    "admission_version",
    "revision",
    "status",
    "inventory",
    "openapi",
    "contracts",
    "release_attestation"
  ],
  "properties": {
    "schema_version": {"const": "nex.mybee.tool-contract-admission.v1"},
    "admission_id": {"const": "mybee.phase1.w70.eos-tool-contracts"},
    "admission_version": {"const": "1.0.0"},
    "revision": {"const": 1},
    "status": {"const": "SOURCE_ADMITTED_RUNTIME_UNCHANGED"},
    "inventory": {
      "$ref": "#/$defs/source_ref",
      "properties": {
        "path": {"const": "domains/mybee/skills/tool_inventory.v1.json"}
      }
    },
    "openapi": {
      "$ref": "#/$defs/source_ref",
      "properties": {
        "path": {"const": "contracts/openapi/nex-eos.openapi.yaml"}
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/contract"}
    },
    "release_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest"],
      "properties": {
        "content_digest": {"$ref": "#/$defs/hash_ref"}
      }
    }
  },
  "$defs": {
    "hash_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash_ref"}
      }
    },
    "parameter_ref": {
      "type": "string",
      "pattern": "^(header|path|query):[^:]+$"
    },
    "schema_ref": {
      "type": "string",
      "pattern": "^contracts/(schemas/service/nex_eos/[a-z0-9_]+\\.v[0-9]+\\.schema\\.json|openapi/nex-eos\\.openapi\\.yaml#/components/schemas/[A-Za-z][A-Za-z0-9]*)$"
    },
    "request_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "component_ref",
        "canonical_schema_ref",
        "typing_state"
      ],
      "properties": {
        "required": {"type": "boolean"},
        "component_ref": {
          "type": "string",
          "pattern": "^#/components/schemas/[A-Za-z][A-Za-z0-9]*$"
        },
        "canonical_schema_ref": {"$ref": "#/$defs/schema_ref"},
        "typing_state": {
          "enum": ["CANONICAL_JSON_SCHEMA", "OPENAPI_INLINE_SCHEMA"]
        }
      }
    },
    "success_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "component_ref",
        "canonical_schema_ref",
        "typing_state"
      ],
      "properties": {
        "status": {"type": "string", "pattern": "^2[0-9]{2}$"},
        "component_ref": {
          "type": ["string", "null"],
          "pattern": "^#/components/schemas/[A-Za-z][A-Za-z0-9]*$"
        },
        "canonical_schema_ref": {
          "oneOf": [{"$ref": "#/$defs/schema_ref"}, {"type": "null"}]
        },
        "typing_state": {
          "enum": [
            "CANONICAL_JSON_SCHEMA",
            "OPENAPI_INLINE_SCHEMA",
            "OPENAPI_STATUS_ONLY"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"typing_state": {"const": "OPENAPI_STATUS_ONLY"}},
            "required": ["typing_state"]
          },
          "then": {
            "properties": {
              "component_ref": {"type": "null"},
              "canonical_schema_ref": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "component_ref": {"type": "string"},
              "canonical_schema_ref": {"type": "string"}
            }
          }
        }
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_operation_id",
        "provider_operation_id",
        "method",
        "path",
        "openapi_operation_ref",
        "required_parameters",
        "optional_parameters",
        "request_body",
        "success_responses"
      ],
      "properties": {
        "canonical_operation_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"
        },
        "provider_operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
        },
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
        "path": {"type": "string", "pattern": "^/internal/v[0-9]+/"},
        "openapi_operation_ref": {
          "type": "string",
          "pattern": "^#/paths/~1internal~1v[0-9]+~1.+/(get|post|put|patch|delete)$"
        },
        "required_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/parameter_ref"}
        },
        "optional_parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/parameter_ref"}
        },
        "request_body": {
          "oneOf": [{"$ref": "#/$defs/request_body"}, {"type": "null"}]
        },
        "success_responses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/success_response"}
        }
      }
    }
  }
}
