{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/common/active_service_claim.v1.schema.json",
  "title": "NeX Active Signed Service Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_id",
    "claim_status",
    "claims",
    "request_id",
    "trace_id"
  ],
  "properties": {
    "service_id": {"$ref": "#/$defs/service_id"},
    "claim_status": {"const": "ACTIVE"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "subject",
        "audience",
        "service_id",
        "scopes",
        "token_use",
        "token_kind",
        "issued_at",
        "expires_at",
        "credential_id",
        "credential_revision",
        "key_id",
        "token_id_digest",
        "introspection_status"
      ],
      "properties": {
        "issuer": {"const": "urn:nex-platform:oa"},
        "subject": {"type": "string", "pattern": "^service:nex-(oa|ag|ae-api|cx|mo)$"},
        "audience": {"$ref": "#/$defs/service_id"},
        "service_id": {"$ref": "#/$defs/service_id"},
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {"const": "service:call"},
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)+$"}
        },
        "token_use": {"const": "service_access"},
        "token_kind": {"const": "SIGNED"},
        "issued_at": {"type": "integer", "minimum": 0},
        "expires_at": {"type": "integer", "minimum": 1},
        "credential_id": {"type": "string", "minLength": 2, "maxLength": 64},
        "credential_revision": {"type": "integer", "minimum": 1},
        "key_id": {"type": "string", "minLength": 2, "maxLength": 64},
        "token_id_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "introspection_status": {"const": "ACTIVE"}
      }
    },
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  },
  "$defs": {
    "service_id": {
      "enum": ["nex-oa", "nex-ag", "nex-ae-api", "nex-cx", "nex-mo"]
    }
  }
}
