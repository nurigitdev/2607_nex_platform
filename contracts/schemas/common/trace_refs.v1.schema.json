{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/common/trace_refs.v1.schema.json",
  "title": "NeX Trace References",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "request_id"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "tracestate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "service_id": {
      "type": "string",
      "enum": [
        "nex-oa",
        "nex-ag",
        "nex-ae-api",
        "nex-cx",
        "nex-mo"
      ]
    }
  }
}
