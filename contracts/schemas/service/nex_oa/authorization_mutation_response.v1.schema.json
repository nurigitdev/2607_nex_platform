{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_oa/authorization_mutation_response.v1.schema.json",
  "title": "NeX OA Authorization Mutation Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_schema_version", "service_id", "record", "event",
    "affected_subject_ids", "revoked_session_count", "request_id", "trace_id"
  ],
  "properties": {
    "response_schema_version": {"const": "oa_authz_mutation_response.v1"},
    "service_id": {"const": "nex-oa"},
    "record": {"$ref": "#/$defs/record"},
    "event": {"$ref": "#/$defs/event"},
    "affected_subject_ids": {
      "type": "array", "maxItems": 1000, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "revoked_session_count": {"type": "integer", "minimum": 0},
    "request_id": {"$ref": "#/$defs/identifier"},
    "trace_id": {"$ref": "#/$defs/identifier"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "authz_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
    "base_record": {
      "type": "object",
      "required": ["authorization_schema_version", "tenant_id", "status", "previous_revision", "revision"],
      "properties": {
        "authorization_schema_version": {"const": "oa_authorization.v1"},
        "tenant_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["ACTIVE", "DISABLED"]},
        "previous_revision": {"type": "integer", "minimum": 0},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "role_record": {
      "allOf": [
        {"$ref": "#/$defs/base_record"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["authorization_schema_version", "role_schema_version", "tenant_id", "role_id", "display_name", "description", "status", "scopes", "metadata", "previous_revision", "revision"],
          "properties": {
            "authorization_schema_version": {"const": "oa_authorization.v1"},
            "role_schema_version": {"const": "oa_role.v1"},
            "tenant_id": {"$ref": "#/$defs/identifier"},
            "role_id": {"$ref": "#/$defs/authz_id"},
            "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
            "description": {"type": ["string", "null"], "maxLength": 512},
            "status": {"enum": ["ACTIVE", "DISABLED"]},
            "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "metadata": {"type": "object", "maxProperties": 32},
            "previous_revision": {"type": "integer", "minimum": 0},
            "revision": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "group_record": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_schema_version", "group_schema_version", "tenant_id", "group_id", "display_name", "description", "status", "metadata", "previous_revision", "revision"],
      "properties": {
        "authorization_schema_version": {"const": "oa_authorization.v1"},
        "group_schema_version": {"const": "oa_group.v1"},
        "tenant_id": {"$ref": "#/$defs/identifier"},
        "group_id": {"$ref": "#/$defs/authz_id"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": ["string", "null"], "maxLength": 512},
        "status": {"enum": ["ACTIVE", "DISABLED"]},
        "metadata": {"type": "object", "maxProperties": 32},
        "previous_revision": {"type": "integer", "minimum": 0},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "group_member_record": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_schema_version", "group_member_schema_version", "tenant_id", "group_id", "subject_id", "status", "previous_revision", "revision"],
      "properties": {
        "authorization_schema_version": {"const": "oa_authorization.v1"},
        "group_member_schema_version": {"const": "oa_group_member.v1"},
        "tenant_id": {"$ref": "#/$defs/identifier"},
        "group_id": {"$ref": "#/$defs/authz_id"},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["ACTIVE", "DISABLED"]},
        "previous_revision": {"type": "integer", "minimum": 0},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "group_role_record": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_schema_version", "group_role_schema_version", "tenant_id", "group_id", "role_id", "status", "previous_revision", "revision"],
      "properties": {
        "authorization_schema_version": {"const": "oa_authorization.v1"},
        "group_role_schema_version": {"const": "oa_group_role.v1"},
        "tenant_id": {"$ref": "#/$defs/identifier"},
        "group_id": {"$ref": "#/$defs/authz_id"},
        "role_id": {"$ref": "#/$defs/authz_id"},
        "status": {"enum": ["ACTIVE", "DISABLED"]},
        "previous_revision": {"type": "integer", "minimum": 0},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "record": {"oneOf": [{"$ref": "#/$defs/role_record"}, {"$ref": "#/$defs/group_record"}, {"$ref": "#/$defs/group_member_record"}, {"$ref": "#/$defs/group_role_record"}]},
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "event_schema_version", "tenant_id", "event_type", "entity_type", "entity_id", "subject_id", "previous_revision", "next_revision", "actor_ref", "request_id", "trace_id", "details", "occurred_at"],
      "properties": {
        "event_id": {"$ref": "#/$defs/identifier"},
        "event_schema_version": {"const": "oa_authz_event.v1"},
        "tenant_id": {"$ref": "#/$defs/identifier"},
        "event_type": {"type": "string", "pattern": "^(ROLE|GROUP|GROUP_MEMBER|GROUP_ROLE)_UPSERTED$"},
        "entity_type": {"enum": ["ROLE", "GROUP", "GROUP_MEMBER", "GROUP_ROLE"]},
        "entity_id": {"$ref": "#/$defs/identifier"},
        "subject_id": {"type": ["string", "null"], "maxLength": 256},
        "previous_revision": {"type": "integer", "minimum": 0},
        "next_revision": {"type": "integer", "minimum": 1},
        "actor_ref": {"type": "string", "pattern": "^nex\\.service:[A-Za-z0-9._:-]+$"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "trace_id": {"$ref": "#/$defs/identifier"},
        "details": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "revoked_session_count"],
          "properties": {
            "status": {"enum": ["ACTIVE", "DISABLED"]},
            "revoked_session_count": {"type": "integer", "minimum": 0}
          }
        },
        "occurred_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
