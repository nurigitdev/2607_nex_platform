{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_oa/service_credential_response.v1.schema.json",
  "title": "NeX OA Service Credential Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["response_schema_version", "credential", "request_id", "trace_id"],
  "properties": {
    "response_schema_version": {"const": "oa_service_credential_response.v1"},
    "credential": {"$ref": "#/$defs/credential"},
    "request_id": {"$ref": "#/$defs/context_id"},
    "trace_id": {"$ref": "#/$defs/context_id"},
    "audit_event": {"$ref": "#/$defs/audit_event"}
  },
  "$defs": {
    "context_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_schema_version", "credential_id", "principal_id", "secret_hint",
        "status", "issued_at", "expires_at", "grace_until", "revision"
      ],
      "properties": {
        "credential_schema_version": {"const": "oa_service_credential.v1"},
        "credential_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "principal_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "secret_hint": {"type": "string", "minLength": 6, "maxLength": 6},
        "status": {"enum": ["ACTIVE", "ROTATING", "REVOKED", "EXPIRED"]},
        "issued_at": {"type": "integer", "minimum": 0},
        "expires_at": {"type": "integer", "minimum": 1},
        "grace_until": {"type": ["integer", "null"], "minimum": 0},
        "last_used_at": {"type": ["string", "null"], "format": "date-time"},
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "audit_event": {
      "type": "object", "additionalProperties": false, "required": ["ok"],
      "properties": {
        "ok": {"type": "boolean"},
        "event_id": {"type": "string", "minLength": 1},
        "service_id": {"const": "nex-oa"},
        "event_type": {"type": "string", "minLength": 1},
        "severity": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]},
        "error_code": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "status_code": {"type": "integer", "minimum": 400, "maximum": 599}
      }
    }
  }
}
