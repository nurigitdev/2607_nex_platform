{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_oa/project_entitlement_event.v1.schema.json",
  "title": "OA Project Entitlement Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "tenant_id",
    "business_operation_id",
    "event_type",
    "event_payload",
    "event_payload_hash"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "business_operation_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "PROJECT_ENTITLEMENT_SNAPSHOT" },
    "event_payload_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "project_id",
        "project_code",
        "project_status",
        "source_version",
        "members",
        "correlation_id",
        "causation_id",
        "occurred_at"
      ],
      "properties": {
        "schema_version": { "const": "eos.project_entitlement_snapshot.v1" },
        "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "project_id": { "type": "string", "format": "uuid" },
        "project_code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}[DMSOIG][0-9]{6}$"
        },
        "project_status": {
          "enum": ["ACTIVE", "INACTIVE", "CLOSING", "CLOSED"]
        },
        "source_version": { "type": "integer", "minimum": 1 },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject_id", "project_role"],
            "properties": {
              "subject_id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "project_role": { "enum": ["OWNER", "MANAGER", "MEMBER", "VIEWER"] }
            }
          }
        },
        "correlation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "causation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
