{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_oa/service_principal_response.v1.schema.json",
  "title": "NeX OA Service Principal Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["response_schema_version", "principal", "request_id", "trace_id"],
  "properties": {
    "response_schema_version": {"const": "oa_service_principal_response.v1"},
    "principal": {"$ref": "#/$defs/principal"},
    "request_id": {"$ref": "#/$defs/context_id"},
    "trace_id": {"$ref": "#/$defs/context_id"},
    "audit_event": {"$ref": "#/$defs/audit_event"}
  },
  "$defs": {
    "context_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_schema_version", "principal_id", "service_id", "display_name",
        "status", "allowed_audiences", "allowed_scopes", "revision"
      ],
      "properties": {
        "principal_schema_version": {"const": "oa_service_principal.v1"},
        "principal_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "service_id": {"enum": ["nex-oa", "nex-ag", "nex-ae-api", "nex-cx", "nex-mo"]},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"enum": ["ACTIVE", "DISABLED"]},
        "allowed_audiences": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["nex-oa", "nex-ag", "nex-ae-api", "nex-cx", "nex-mo"]}
        },
        "allowed_scopes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}:[a-z][a-z0-9._-]{0,63}$"}
        },
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "audit_event": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["ok", "event_id", "service_id", "event_type", "severity"],
          "properties": {
            "ok": {"const": true},
            "event_id": {"$ref": "#/$defs/context_id"},
            "service_id": {"const": "nex-oa"},
            "event_type": {"type": "string", "minLength": 1},
            "severity": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["ok", "error_code", "detail", "status_code"],
          "properties": {
            "ok": {"const": false},
            "error_code": {"type": "string", "minLength": 1},
            "detail": {"type": "string", "minLength": 1},
            "status_code": {"type": "integer", "minimum": 400, "maximum": 599}
          }
        }
      ]
    }
  }
}
