{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_oa/credential_rotation.v1.schema.json",
  "title": "NeX OA Credential Rotation Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_rotation_schema_version",
    "service_id",
    "operation",
    "tenant_ref",
    "subject_ref",
    "credential_id",
    "credential_status",
    "password_changed_at",
    "revoked_session_count",
    "reason_code",
    "metadata",
    "request_id",
    "trace_id"
  ],
  "properties": {
    "credential_rotation_schema_version": {"const": "oa_credential_rotation.v1"},
    "service_id": {"const": "nex-oa"},
    "operation": {"enum": ["PASSWORD_CHANGED", "PASSWORD_RESET"]},
    "tenant_ref": {"$ref": "#/$defs/tenant_ref"},
    "subject_ref": {"$ref": "#/$defs/subject_ref"},
    "credential_id": {"$ref": "#/$defs/identifier"},
    "credential_status": {"enum": ["ACTIVE", "PASSWORD_RESET_REQUIRED"]},
    "password_changed_at": {"type": "string", "format": "date-time"},
    "revoked_session_count": {"type": "integer", "minimum": 0},
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "password_hash_included",
        "raw_password_included",
        "session_identifiers_included",
        "session_revocation_atomic"
      ],
      "properties": {
        "password_hash_included": {"const": false},
        "raw_password_included": {"const": false},
        "session_identifiers_included": {"const": false},
        "session_revocation_atomic": {"const": true}
      }
    },
    "request_id": {"$ref": "#/$defs/identifier"},
    "trace_id": {"$ref": "#/$defs/identifier"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"const": "oa.tenant"},
        "id": {"$ref": "#/$defs/identifier"}
      }
    },
    "subject_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"const": "oa.user"},
        "id": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
