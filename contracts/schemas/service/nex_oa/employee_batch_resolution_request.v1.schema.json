{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_oa/employee_batch_resolution_request.v1.schema.json",
  "title": "NeX OA Employee Batch Resolution Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "candidates"],
  "properties": {
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_index", "employee_id"],
        "properties": {
          "input_index": {"type": "integer", "minimum": 0},
          "employee_id": {},
          "expected_name": {"type": ["string", "null"], "maxLength": 256}
        }
      }
    }
  }
}
