{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_oa/service_credential_list.v1.schema.json",
  "title": "NeX OA Service Credential List",
  "type": "object",
  "additionalProperties": false,
  "required": ["response_schema_version", "items", "count", "request_id", "trace_id"],
  "properties": {
    "response_schema_version": {"const": "oa_service_credential_response.v1"},
    "items": {
      "type": "array", "maxItems": 1000,
      "items": {"$ref": "#/$defs/credential"}
    },
    "count": {"type": "integer", "minimum": 0, "maximum": 1000},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "$defs": {
    "credential": {
      "type": "object", "additionalProperties": false,
      "required": ["credential_schema_version", "credential_id", "principal_id", "secret_hint", "status", "issued_at", "expires_at", "grace_until", "revision"],
      "properties": {
        "credential_schema_version": {"const": "oa_service_credential.v1"},
        "credential_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "principal_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "secret_hint": {"type": "string", "minLength": 6, "maxLength": 6},
        "status": {"enum": ["ACTIVE", "ROTATING", "REVOKED", "EXPIRED"]},
        "issued_at": {"type": "integer", "minimum": 0},
        "expires_at": {"type": "integer", "minimum": 1},
        "grace_until": {"type": ["integer", "null"], "minimum": 0},
        "last_used_at": {"type": ["string", "null"], "format": "date-time"},
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
