{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_oa/subject_verification.v1.schema.json",
  "title": "NeX OA Subject Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_schema_version",
    "service_id",
    "tenant_id",
    "requested_count",
    "verified_count",
    "rejected_count",
    "results",
    "verification_evidence_hash",
    "request_id",
    "trace_id"
  ],
  "properties": {
    "verification_schema_version": {"const": "oa_subject_verification.v1"},
    "service_id": {"const": "nex-oa"},
    "tenant_id": {"$ref": "#/$defs/id"},
    "requested_count": {"type": "integer", "minimum": 1, "maximum": 50},
    "verified_count": {"type": "integer", "minimum": 0, "maximum": 50},
    "rejected_count": {"type": "integer", "minimum": 0, "maximum": 50},
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/verified"},
          {"$ref": "#/$defs/notFound"},
          {"$ref": "#/$defs/inactive"},
          {"$ref": "#/$defs/membershipMissing"}
        ]
      }
    },
    "verification_evidence_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "verified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "verification_status",
        "subject_revision",
        "tenant_membership_revision"
      ],
      "properties": {
        "subject_id": {"$ref": "#/$defs/id"},
        "verification_status": {"const": "VERIFIED"},
        "subject_revision": {"type": "integer", "minimum": 1},
        "tenant_membership_revision": {"type": "integer", "minimum": 1}
      }
    },
    "notFound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "verification_status"],
      "properties": {
        "subject_id": {"$ref": "#/$defs/id"},
        "verification_status": {"const": "SUBJECT_NOT_FOUND"}
      }
    },
    "inactive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "verification_status", "subject_revision"],
      "properties": {
        "subject_id": {"$ref": "#/$defs/id"},
        "verification_status": {"const": "SUBJECT_INACTIVE"},
        "subject_revision": {"type": "integer", "minimum": 1}
      }
    },
    "membershipMissing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "verification_status", "subject_revision"],
      "properties": {
        "subject_id": {"$ref": "#/$defs/id"},
        "verification_status": {"const": "TENANT_MEMBERSHIP_MISSING"},
        "subject_revision": {"type": "integer", "minimum": 1}
      }
    }
  }
}
