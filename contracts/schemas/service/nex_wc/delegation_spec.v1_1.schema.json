{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_wc/delegation_spec.v1_1.schema.json",
  "title": "WC Nested DelegationSpec v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delegation_id",
    "tenant_id",
    "parent_agent_execution_id",
    "parent_executable_plan_id",
    "parent_executable_step_id",
    "delegation_revision",
    "goal",
    "work_class",
    "required_agent_type",
    "required_capability",
    "project_ref",
    "project_scope_ref",
    "result_contract_ref",
    "completion_policy",
    "correlation_id"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "delegation_id": {"$ref": "#/$defs/scoped_id"},
    "tenant_id": {"$ref": "#/$defs/scoped_id"},
    "parent_agent_execution_id": {"$ref": "#/$defs/scoped_id"},
    "parent_executable_plan_id": {"$ref": "#/$defs/scoped_id"},
    "parent_executable_step_id": {"$ref": "#/$defs/scoped_id"},
    "delegation_revision": {"type": "integer", "minimum": 1},
    "goal": {"type": "string", "minLength": 1, "maxLength": 4000},
    "work_class": {"enum": ["QUERY", "ANALYSIS", "DOCUMENT", "BUSINESS_TRANSACTION", "COORDINATION", "EXPERT_REVIEW", "REPORTING", "OPERATIONAL"]},
    "required_agent_type": {"enum": ["CA", "PA", "EA"]},
    "required_capability": {"type": "string", "minLength": 1, "maxLength": 160},
    "project_ref": {"$ref": "#/$defs/project_ref"},
    "project_scope_ref": {"type": "string", "minLength": 1, "maxLength": 160},
    "result_contract_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "completion_policy": {"enum": ["OWNER_SUBMITS", "ALL_ASSIGNEES_SUBMIT", "ANY_ASSIGNEE_SUBMITS", "ALL_REQUIRED_CHILDREN", "MANUAL"]},
    "correlation_id": {"$ref": "#/$defs/scoped_id"},
    "causation_id": {"type": ["string", "null"], "maxLength": 128},
    "parent_work_item_id": {"$ref": "#/$defs/uuid"},
    "parent_claim_ref": {"$ref": "#/$defs/uuid"},
    "parent_claim_generation": {"type": "integer", "minimum": 1},
    "delegating_agent_ref": {"$ref": "#/$defs/agent_ref"}
  },
  "dependentRequired": {
    "parent_work_item_id": ["parent_claim_ref", "parent_claim_generation", "delegating_agent_ref"],
    "parent_claim_ref": ["parent_work_item_id", "parent_claim_generation", "delegating_agent_ref"],
    "parent_claim_generation": ["parent_work_item_id", "parent_claim_ref", "delegating_agent_ref"],
    "delegating_agent_ref": ["parent_work_item_id", "parent_claim_ref", "parent_claim_generation"]
  },
  "$defs": {
    "scoped_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "uuid": {"type": "string", "format": "uuid"},
    "project_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "entity_id"],
      "properties": {
        "entity_type": {"const": "PROJECT"},
        "entity_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": ["string", "integer", "null"]}
      }
    },
    "agent_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "agent_type"],
      "properties": {
        "agent_id": {"$ref": "#/$defs/uuid"},
        "agent_type": {"enum": ["CA", "PA", "EA"]}
      }
    }
  }
}
