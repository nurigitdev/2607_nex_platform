{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_wc/approval_gate_detail.v1.schema.json",
  "title": "WC Approval Gate Detail v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate", "created_at", "version", "decision_options"
  ],
  "properties": {
    "schema_version": {"const": "wc_approval_gate_detail.v1"},
    "gate": {"$ref": "#/$defs/human_gate_view"},
    "created_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1},
    "decision_options": {
      "type": "array",
      "prefixItems": [{"const": "APPROVE"}, {"const": "REJECT"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "$defs": {
    "scoped_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "uuid": {"type": "string", "format": "uuid"},
    "human_gate_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "gate_id", "approval_domain", "state", "title",
        "summary", "action_ref", "approval_provider_type",
        "approval_target_ref", "business_operation_id", "expires_at"
      ],
      "properties": {
        "schema_version": {"const": "human_gate_view.p8.v1"},
        "gate_id": {"$ref": "#/$defs/uuid"},
        "approval_domain": {
          "enum": [
            "AGENT_FORMAL", "NSL_WRITE", "BUSINESS_FORMAL",
            "HUMAN_CONFIRMATION", "STEP_UP"
          ]
        },
        "state": {
          "enum": ["PENDING", "APPROVED", "REJECTED", "EXPIRED", "CANCELLED"]
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "action_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "approval_provider_type": {
          "type": ["string", "null"],
          "enum": ["AGENT", "NSL", "EOS", null]
        },
        "approval_target_ref": {"type": ["string", "null"], "maxLength": 256},
        "business_operation_id": {
          "oneOf": [{"$ref": "#/$defs/scoped_id"}, {"type": "null"}]
        },
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "formal_approval": {"$ref": "#/$defs/business_formal_view"}
      },
      "allOf": [
        {
          "if": {"properties": {"approval_domain": {"const": "BUSINESS_FORMAL"}}, "required": ["approval_domain"]},
          "then": {
            "required": ["business_operation_id", "formal_approval"],
            "properties": {
              "approval_provider_type": {"const": "EOS"},
              "approval_target_ref": {"type": "string", "minLength": 1},
              "business_operation_id": {"$ref": "#/$defs/scoped_id"}
            }
          },
          "else": {"not": {"required": ["formal_approval"]}}
        }
      ]
    },
    "business_formal_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "current_stage", "stage_count", "requested_role",
        "eos_target_ref", "org_unit_id", "project_id", "terminal_state"
      ],
      "properties": {
        "schema_version": {"const": "business_formal_gate_view.p8.v1"},
        "current_stage": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 5}, {"type": "null"}]},
        "stage_count": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 5}, {"type": "null"}]},
        "requested_role": {"type": ["string", "null"], "maxLength": 128},
        "eos_target_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "org_unit_id": {"oneOf": [{"$ref": "#/$defs/scoped_id"}, {"type": "null"}]},
        "project_id": {"oneOf": [{"$ref": "#/$defs/scoped_id"}, {"type": "null"}]},
        "terminal_state": {"enum": ["APPROVED", "REJECTED", "EXPIRED", "CANCELLED", null]}
      }
    }
  }
}
