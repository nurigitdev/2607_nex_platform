{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_mo/alias_binding_collection.v1.schema.json",
  "title": "NeX MO Alias Binding Collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "meta"],
  "properties": {
    "data": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "alias", "capability", "state"],
      "properties": {
        "schema_version": {"const": "mo_alias_binding_collection.v1"},
        "alias": {"type": ["string", "null"]},
        "capability": {"enum": ["embedding", "reranking", "generation", null]},
        "state": {"enum": ["ACTIVE", "SUPERSEDED", "ROLLED_BACK", null]}
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias_binding_schema_version", "binding_id", "alias", "provider_capability", "catalog_id", "binding_revision", "binding_state", "change_reason", "previous_binding_id", "created_at"],
      "properties": {
        "alias_binding_schema_version": {"const": "mo_alias_binding.v1"},
        "binding_id": {"type": "string", "minLength": 1},
        "alias": {"type": "string", "minLength": 1},
        "provider_capability": {"enum": ["embedding", "reranking", "generation"]},
        "catalog_id": {"type": "string", "minLength": 1},
        "binding_revision": {"type": "integer", "minimum": 1},
        "binding_state": {"enum": ["ACTIVE", "SUPERSEDED", "ROLLED_BACK"]},
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "previous_binding_id": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
