{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_mo/alias_binding.v1.schema.json",
  "title": "NeX MO Alias Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alias_binding_schema_version", "binding_id", "alias", "provider_capability",
    "catalog_id", "binding_revision", "binding_state", "change_reason",
    "previous_binding_id", "created_at"
  ],
  "properties": {
    "alias_binding_schema_version": {"const": "mo_alias_binding.v1"},
    "binding_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "alias": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "provider_capability": {"enum": ["embedding", "reranking", "generation"]},
    "catalog_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "binding_revision": {"type": "integer", "minimum": 1},
    "binding_state": {"enum": ["ACTIVE", "SUPERSEDED", "ROLLED_BACK"]},
    "change_reason": {"type": "string", "minLength": 1, "maxLength": 500},
    "previous_binding_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
