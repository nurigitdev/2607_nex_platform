{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_mo/compatible_rerank_request.v1.schema.json",
  "title": "NeX Compatible Rerank Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "query",
    "documents"
  ],
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "top_n": {
      "type": "integer",
      "minimum": 1
    },
    "return_documents": {
      "type": "boolean"
    }
  }
}
