{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_mo/rerank_response.v1.schema.json",
  "title": "NeX MO Rerank Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["alias", "model_revision", "deployment_id", "results", "usage"],
  "properties": {
    "alias": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "deployment_id": {"type": "string", "minLength": 1},
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "score", "document"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "score": {"type": "number"},
          "document": {"type": "string"}
        }
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    }
  }
}
