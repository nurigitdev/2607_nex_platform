{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_mo/embedding_response.v1.schema.json",
  "title": "NeX MO Embedding Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["object", "alias", "model_revision", "deployment_id", "data", "usage"],
  "properties": {
    "object": {"const": "list"},
    "alias": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "deployment_id": {"type": "string", "minLength": 1},
    "data": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["object", "index", "embedding"],
        "properties": {
          "object": {"const": "embedding"},
          "index": {"type": "integer", "minimum": 0},
          "embedding": {"type": "array", "minItems": 1, "items": {"type": "number"}}
        }
      }
    },
    "usage": {"$ref": "#/$defs/usage"}
  },
  "$defs": {
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    }
  }
}
