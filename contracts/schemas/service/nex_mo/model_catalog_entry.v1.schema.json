{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_mo/model_catalog_entry.v1.schema.json",
  "title": "NeX MO Model Catalog Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_entry_schema_version", "catalog_id", "provider_capability",
    "model_name", "model_revision", "deployment_id", "runtime_profile",
    "precision", "provider_type", "supports_response_formats",
    "max_input_tokens", "max_output_tokens", "embedding_dimensions",
    "catalog_state", "revision", "created_at", "updated_at"
  ],
  "properties": {
    "catalog_entry_schema_version": {"const": "mo_model_catalog_entry.v1"},
    "catalog_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "provider_capability": {"enum": ["embedding", "reranking", "generation"]},
    "model_name": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "deployment_id": {"type": "string", "minLength": 1},
    "runtime_profile": {"type": "string", "minLength": 1},
    "precision": {"type": "string", "minLength": 1},
    "provider_type": {"type": "string", "minLength": 1},
    "supports_response_formats": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "max_input_tokens": {"type": "integer", "minimum": 1},
    "max_output_tokens": {"type": "integer", "minimum": 0},
    "embedding_dimensions": {"type": ["integer", "null"], "minimum": 1},
    "catalog_state": {"enum": ["DRAFT", "ACTIVE", "RETIRED"]},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"provider_capability": {"const": "embedding"}}},
      "then": {"properties": {"embedding_dimensions": {"type": "integer", "minimum": 1}}},
      "else": {"properties": {"embedding_dimensions": {"type": "null"}}}
    }
  ]
}
