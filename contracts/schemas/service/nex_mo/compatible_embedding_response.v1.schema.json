{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_mo/compatible_embedding_response.v1.schema.json",
  "title": "NeX Compatible Embedding Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object",
    "model",
    "data",
    "usage"
  ],
  "properties": {
    "object": {
      "const": "list"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "embedding",
          "index"
        ],
        "properties": {
          "object": {
            "const": "embedding"
          },
          "embedding": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          },
          "index": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_tokens",
        "total_tokens"
      ],
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
