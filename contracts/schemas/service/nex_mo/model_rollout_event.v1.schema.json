{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_mo/model_rollout_event.v1.schema.json",
  "title": "NeX MO Model Rollout Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "rollout_id", "event_type", "from_state",
    "to_state", "state_revision", "evidence_digest", "failure_code",
    "occurred_at"
  ],
  "properties": {
    "schema_version": {"const": "mo_model_rollout_event.v1"},
    "event_id": {"$ref": "#/$defs/identifier"},
    "rollout_id": {"$ref": "#/$defs/identifier"},
    "event_type": {
      "enum": [
        "rollout.registered", "rollout.validation_started", "rollout.ready",
        "rollout.canary_started", "rollout.canary_evaluated",
        "rollout.activated", "rollout.blocked", "rollout.rolled_back"
      ]
    },
    "from_state": {
      "enum": [
        "REGISTERED", "VALIDATING", "READY", "CANARY", "BLOCKED",
        "ACTIVE", "ROLLED_BACK", null
      ]
    },
    "to_state": {
      "enum": [
        "REGISTERED", "VALIDATING", "READY", "CANARY", "BLOCKED",
        "ACTIVE", "ROLLED_BACK"
      ]
    },
    "state_revision": {"type": "integer", "minimum": 1},
    "evidence_digest": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "failure_code": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/identifier"}
      ]
    },
    "occurred_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
