{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_mo/generation_response.v1.schema.json",
  "title": "NeX MO Generation Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mo_generation_id", "alias", "model_revision", "deployment_id",
    "provider_type", "output", "finish_reason", "usage", "runtime_metadata",
    "created_at", "updated_at"
  ],
  "properties": {
    "mo_generation_id": {"type": "string", "minLength": 1},
    "alias": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "deployment_id": {"type": "string", "minLength": 1},
    "provider_type": {"type": "string", "minLength": 1},
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {"const": "text"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "finish_reason": {"type": "string", "minLength": 1},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "runtime_metadata": {
      "type": "object", "additionalProperties": false,
      "required": [
        "request_id", "trace_id", "queue_ms", "provider_ms", "total_ms",
        "route_id", "admission_decision", "provider_request_id"
      ],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "trace_id": {"type": "string", "minLength": 1},
        "queue_ms": {"type": "integer", "minimum": 0},
        "provider_ms": {"type": "integer", "minimum": 0},
        "total_ms": {"type": "integer", "minimum": 0},
        "route_id": {"type": "string", "minLength": 1},
        "admission_decision": {"type": "string", "minLength": 1},
        "provider_request_id": {"type": "string", "minLength": 1}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
