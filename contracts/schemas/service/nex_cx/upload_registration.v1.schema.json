{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_cx/upload_registration.v1.schema.json",
  "title": "NeX CX Upload Registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_schema_version",
    "document_id",
    "upload_id",
    "filename",
    "original_filename",
    "content_type",
    "size_bytes",
    "source_sha256",
    "trace_id",
    "request_id",
    "ownership",
    "ownership_ref",
    "storage",
    "retrieval_policy",
    "extraction",
    "dedupe",
    "ingestion_job",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "document_schema_version": {
      "const": "cx_upload_registration.v1"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "upload_id": {
      "type": "string",
      "minLength": 1
    },
    "filename": {
      "type": "string",
      "pattern": "^[^/\\\\]{1,255}$"
    },
    "original_filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "content_type": {
      "type": "string",
      "minLength": 1
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "owner_user_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_user_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ownership_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership_schema_version",
        "tenant_ref",
        "owner_subject_ref",
        "uploaded_by_subject_ref",
        "legacy",
        "compatibility_mode"
      ],
      "properties": {
        "ownership_schema_version": {
          "const": "cx_source_ownership_ref.v1"
        },
        "tenant_ref": {
          "$ref": "#/$defs/tenant_ref"
        },
        "owner_subject_ref": {
          "$ref": "#/$defs/user_subject_ref"
        },
        "uploaded_by_subject_ref": {
          "$ref": "#/$defs/user_subject_ref"
        },
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenant_id",
            "owner_user_id"
          ],
          "properties": {
            "tenant_id": {
              "type": "string",
              "minLength": 1
            },
            "owner_user_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "compatibility_mode": {
          "const": "legacy_owner_fields_mapped_to_oa_subject_refs"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_storage_backend",
        "source_storage_key",
        "source_storage_path",
        "stored_filename",
        "stored_extension",
        "extracted_markdown_path",
        "extraction_temp_path"
      ],
      "properties": {
        "source_storage_backend": {
          "type": "string",
          "enum": [
            "local_filesystem",
            "s3",
            "minio",
            "gcs",
            "azure_blob"
          ]
        },
        "source_storage_key": {
          "type": "string",
          "pattern": "^[0-9]{8}/[0-9a-f]{2}/[0-9a-f]{2}/[^/\\\\]{1,255}$"
        },
        "source_storage_path": {
          "type": "string",
          "pattern": "^/"
        },
        "stored_filename": {
          "type": "string",
          "pattern": "^[^/\\\\]{1,255}$"
        },
        "stored_extension": {
          "type": "string",
          "pattern": "^(|\\.[A-Za-z0-9][A-Za-z0-9._-]{0,31})$"
        },
        "extracted_markdown_path": {
          "type": "string",
          "pattern": "^/"
        },
        "extraction_temp_path": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "retrieval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_policy",
        "chunk_size",
        "chunk_overlap",
        "bm25_tokenizer",
        "bm25_tokenizer_fallback"
      ],
      "properties": {
        "chunk_policy": {
          "type": "string",
          "minLength": 1
        },
        "chunk_size": {
          "type": "integer",
          "minimum": 1
        },
        "chunk_overlap": {
          "type": "integer",
          "minimum": 0
        },
        "bm25_tokenizer": {
          "type": "string",
          "minLength": 1
        },
        "bm25_tokenizer_fallback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "job_id",
        "markdown_available"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "RUNNING",
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "markdown_available": {
          "type": "boolean"
        }
      }
    },
    "dedupe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "status",
        "existing_document_id"
      ],
      "properties": {
        "scope": {
          "const": "owner_active_content"
        },
        "status": {
          "type": "string",
          "enum": [
            "CREATED",
            "ALREADY_EXISTS"
          ]
        },
        "existing_document_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ingestion_job": {
      "$ref": "#/$defs/common_job"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "tenant_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "oa.tenant"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "user_subject_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "oa.user"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "common_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_schema_version",
        "job_id",
        "job_type",
        "status",
        "trace_id",
        "request_id",
        "subject_ref",
        "idempotency_key",
        "attempt_count",
        "max_attempts",
        "retryable",
        "links",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "job_schema_version": {
          "const": "common_job.v1"
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "job_type": {
          "const": "cx.document_ingestion"
        },
        "status": {
          "const": "QUEUED"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "cx.document"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "attempt_count": {
          "type": "integer",
          "const": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
