{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_cx/document_intelligence_run.v1.schema.json",
  "title": "NeX CX Document Intelligence Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_intelligence_run_schema_version",
    "document_id",
    "status",
    "summary",
    "summary_embedding",
    "summary_vector",
    "raw_summary_included",
    "raw_vector_included",
    "observability"
  ],
  "properties": {
    "document_intelligence_run_schema_version": {
      "const": "cx_document_intelligence_run.v1"
    },
    "document_id": {"type": "string", "format": "uuid"},
    "status": {"const": "READY"},
    "summary": {"$ref": "#/$defs/summary"},
    "summary_embedding": {"$ref": "#/$defs/summaryEmbedding"},
    "summary_vector": {"$ref": "#/$defs/summaryVector"},
    "raw_summary_included": {"const": false},
    "raw_vector_included": {"const": false},
    "observability": {"$ref": "#/$defs/observability"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_summary_id",
        "status",
        "summary_text_sha256",
        "summary_char_count",
        "summary_preview",
        "summary_storage_uri",
        "source_markdown_sha256",
        "summarizer",
        "updated_at"
      ],
      "properties": {
        "document_summary_id": {"type": "string", "format": "uuid"},
        "status": {"const": "READY"},
        "summary_text_sha256": {"$ref": "#/$defs/sha256"},
        "summary_char_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "summary_preview": {"type": "string", "minLength": 1, "maxLength": 240},
        "summary_storage_uri": {"type": "string", "minLength": 1},
        "source_markdown_sha256": {"$ref": "#/$defs/sha256"},
        "summarizer": {"$ref": "#/$defs/summarizer"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "summarizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "mode", "model_profile_id", "model_revision"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "model_profile_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "deployment_id": {"type": "string", "minLength": 1},
        "provider_type": {"type": "string", "minLength": 1},
        "mo_generation_id": {"type": "string", "minLength": 1},
        "finish_reason": {"type": "string", "minLength": 1},
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0}
          }
        },
        "provider_prompt_package_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "summaryEmbedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_embedding_id",
        "document_summary_id",
        "provider_alias",
        "model_profile_id",
        "model_revision",
        "deployment_id",
        "embedding_sha256",
        "vector_dimension"
      ],
      "properties": {
        "summary_embedding_id": {"type": "string", "format": "uuid"},
        "document_summary_id": {"type": "string", "format": "uuid"},
        "provider_alias": {"type": "string", "minLength": 1},
        "model_profile_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "deployment_id": {"type": "string", "minLength": 1},
        "embedding_sha256": {"$ref": "#/$defs/sha256"},
        "vector_dimension": {"type": "integer", "minimum": 1, "maximum": 8192}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness_schema_version",
        "state",
        "usable",
        "reasons",
        "document_summary_id",
        "summary_embedding_id",
        "profile_fingerprint"
      ],
      "properties": {
        "freshness_schema_version": {"const": "cx_summary_vector_freshness.v1"},
        "state": {"enum": ["READY", "STALE"]},
        "usable": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "document_summary_id": {"type": "string", "format": "uuid"},
        "summary_embedding_id": {"type": "string", "format": "uuid"},
        "profile_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "summaryVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_vector_id",
        "storage_backend",
        "storage_uri",
        "embedding_sha256",
        "vector_dimension",
        "profile_fingerprint",
        "freshness"
      ],
      "properties": {
        "summary_vector_id": {"type": "string", "format": "uuid"},
        "storage_backend": {"type": "string", "minLength": 1},
        "storage_uri": {"type": "string", "minLength": 1},
        "embedding_sha256": {"$ref": "#/$defs/sha256"},
        "vector_dimension": {"type": "integer", "minimum": 1, "maximum": 8192},
        "profile_fingerprint": {"$ref": "#/$defs/sha256"},
        "freshness": {"$ref": "#/$defs/freshness"}
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": {
        "ok": {"type": "boolean"},
        "event_id": {"type": "string", "format": "uuid"},
        "service_id": {"const": "nex-cx"},
        "event_type": {"const": "cx.document_intelligence.ready"},
        "severity": {"const": "INFO"},
        "error_code": {"type": "string"},
        "detail": {"type": "string"},
        "status_code": {"type": "integer"}
      },
      "allOf": [
        {
          "if": {"properties": {"ok": {"const": true}}},
          "then": {"required": ["event_id", "service_id", "event_type", "severity"]},
          "else": {"required": ["error_code", "detail", "status_code"]}
        }
      ]
    }
  }
}
