{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_cx/document_detail_projection.v1.schema.json",
  "title": "NeX CX Owner-Scoped Document Detail Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_schema_version",
    "service_id",
    "source",
    "filters",
    "document",
    "boundary_audit",
    "metadata"
  ],
  "properties": {
    "projection_schema_version": {
      "const": "cx_document_detail_projection.v1"
    },
    "service_id": {
      "const": "nex-cx"
    },
    "source": {
      "$ref": "#/$defs/projection_source"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filter_schema_version",
        "document_ref",
        "tenant_ref",
        "owner_subject_ref",
        "lifecycle_status"
      ],
      "properties": {
        "filter_schema_version": {
          "const": "cx_document_detail_query_filters.v1"
        },
        "document_ref": {
          "$ref": "#/$defs/document_ref"
        },
        "tenant_ref": {
          "$ref": "#/$defs/tenant_ref"
        },
        "owner_subject_ref": {
          "$ref": "#/$defs/user_subject_ref"
        },
        "lifecycle_status": {
          "const": "ACTIVE"
        }
      }
    },
    "document": {
      "$ref": "#/$defs/document_detail_item"
    },
    "boundary_audit": {
      "$ref": "#/$defs/boundary_audit"
    },
    "metadata": {
      "$ref": "#/$defs/detail_privacy_metadata"
    }
  },
  "$defs": {
    "projection_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "database_env",
        "redacted_database_url"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "database_env": {
          "$ref": "#/$defs/optional_text"
        },
        "redacted_database_url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^postgresql(\\+psycopg)?://[^:]+:\\*\\*\\*@.+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "document_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "cx.document"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tenant_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "oa.tenant"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "user_subject_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "oa.user"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "optional_text": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "optional_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "optional_date_time": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "document_detail_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_detail_schema_version",
        "document_id",
        "upload_id",
        "tenant_ref",
        "owner_subject_ref",
        "uploaded_by_subject_ref",
        "filename",
        "content_type",
        "size_bytes",
        "source_sha256",
        "classification",
        "lifecycle_status",
        "retrieval_policy",
        "created_at",
        "updated_at",
        "summary",
        "summary_embedding",
        "processing",
        "links",
        "metadata",
        "source_lineage",
        "upload",
        "extraction",
        "boundary_audit"
      ],
      "properties": {
        "document_detail_schema_version": {
          "const": "cx_document_detail_item.v1"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "upload_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_ref": {
          "$ref": "#/$defs/tenant_ref"
        },
        "owner_subject_ref": {
          "$ref": "#/$defs/user_subject_ref"
        },
        "uploaded_by_subject_ref": {
          "$ref": "#/$defs/user_subject_ref"
        },
        "filename": {
          "type": "string",
          "pattern": "^[^/\\\\]{1,255}$"
        },
        "content_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_status": {
          "const": "ACTIVE"
        },
        "retrieval_policy": {
          "type": "object",
          "additionalProperties": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "$ref": "#/$defs/document_summary_projection"
        },
        "summary_embedding": {
          "$ref": "#/$defs/summary_embedding_projection"
        },
        "processing": {
          "$ref": "#/$defs/processing_projection"
        },
        "links": {
          "$ref": "#/$defs/document_links"
        },
        "metadata": {
          "$ref": "#/$defs/item_privacy_metadata"
        },
        "source_lineage": {
          "$ref": "#/$defs/source_lineage"
        },
        "upload": {
          "$ref": "#/$defs/upload_metadata"
        },
        "extraction": {
          "$ref": "#/$defs/extraction_metadata"
        },
        "boundary_audit": {
          "$ref": "#/$defs/boundary_audit"
        }
      }
    },
    "document_summary_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "status",
        "document_summary_id",
        "summary_text_sha256",
        "summary_preview",
        "summary_char_count",
        "model_profile_id",
        "model_revision",
        "updated_at"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "document_summary_id": {
          "$ref": "#/$defs/optional_text"
        },
        "summary_text_sha256": {
          "$ref": "#/$defs/optional_hash"
        },
        "summary_preview": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "summary_char_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "model_profile_id": {
          "$ref": "#/$defs/optional_text"
        },
        "model_revision": {
          "$ref": "#/$defs/optional_text"
        },
        "updated_at": {
          "$ref": "#/$defs/optional_date_time"
        }
      }
    },
    "summary_embedding_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "status",
        "summary_embedding_id",
        "model_profile_id",
        "model_revision",
        "vector_dimension",
        "embedding_sha256",
        "created_at"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "summary_embedding_id": {
          "$ref": "#/$defs/optional_text"
        },
        "model_profile_id": {
          "$ref": "#/$defs/optional_text"
        },
        "model_revision": {
          "$ref": "#/$defs/optional_text"
        },
        "vector_dimension": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "embedding_sha256": {
          "$ref": "#/$defs/optional_hash"
        },
        "created_at": {
          "$ref": "#/$defs/optional_date_time"
        }
      }
    },
    "processing_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "latest_pipeline_run_id",
        "status",
        "step_total",
        "step_failed",
        "updated_at"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "latest_pipeline_run_id": {
          "$ref": "#/$defs/optional_text"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "step_total": {
          "type": "integer",
          "minimum": 0
        },
        "step_failed": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "$ref": "#/$defs/optional_date_time"
        }
      }
    },
    "document_links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cx_document",
        "cx_summary",
        "cx_summary_embedding",
        "cx_processing_runs"
      ],
      "properties": {
        "cx_document": {
          "type": "string",
          "pattern": "^/api/v1/documents/[^/]+$"
        },
        "cx_summary": {
          "type": "string",
          "pattern": "^/api/v1/documents/[^/]+/summary$"
        },
        "cx_summary_embedding": {
          "type": "string",
          "pattern": "^/api/v1/documents/[^/]+/summary-embedding$"
        },
        "cx_processing_runs": {
          "type": "string",
          "pattern": "^/api/v1/documents/[^/]+/processing/runs$"
        }
      }
    },
    "source_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file_id",
        "source_sha256",
        "content_type",
        "size_bytes",
        "storage_backend",
        "storage_key_included",
        "storage_uri_included",
        "storage_path_included"
      ],
      "properties": {
        "source_file_id": {
          "$ref": "#/$defs/optional_text"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "storage_backend": {
          "type": "null"
        },
        "storage_key_included": {
          "const": false
        },
        "storage_uri_included": {
          "const": false
        },
        "storage_path_included": {
          "const": false
        }
      }
    },
    "upload_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "upload_id",
        "request_id",
        "trace_id",
        "dedupe_status",
        "existing_document_id",
        "payload_source",
        "source_content_in_record"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "upload_id": {
          "$ref": "#/$defs/optional_text"
        },
        "request_id": {
          "$ref": "#/$defs/optional_text"
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dedupe_status": {
          "$ref": "#/$defs/optional_text"
        },
        "existing_document_id": {
          "$ref": "#/$defs/optional_text"
        },
        "payload_source": {
          "$ref": "#/$defs/optional_text"
        },
        "source_content_in_record": {
          "const": false
        }
      }
    },
    "extraction_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "job_id",
        "status",
        "markdown_available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "job_id": {
          "$ref": "#/$defs/optional_text"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "markdown_available": {
          "type": "boolean"
        }
      }
    },
    "boundary_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_schema_version",
        "legacy_route",
        "projection"
      ],
      "properties": {
        "audit_schema_version": {
          "const": "cx_document_detail_boundary_audit.v1"
        },
        "legacy_route": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "current_payload",
            "owner_scope_required",
            "may_expose_local_storage_path",
            "replacement_projection_schema_version"
          ],
          "properties": {
            "path": {
              "const": "/api/v1/documents/{document_id}"
            },
            "current_payload": {
              "const": "cx_upload_registration.v1"
            },
            "owner_scope_required": {
              "const": false
            },
            "may_expose_local_storage_path": {
              "const": true
            },
            "replacement_projection_schema_version": {
              "const": "cx_document_detail_projection.v1"
            }
          }
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner_scope_required",
            "not_found_and_not_authorized_collapsed",
            "raw_source_included",
            "raw_summary_included",
            "embedding_vector_included",
            "local_storage_path_included",
            "storage_uri_included",
            "storage_key_included"
          ],
          "properties": {
            "owner_scope_required": {
              "const": true
            },
            "not_found_and_not_authorized_collapsed": {
              "const": true
            },
            "raw_source_included": {
              "const": false
            },
            "raw_summary_included": {
              "const": false
            },
            "embedding_vector_included": {
              "const": false
            },
            "local_storage_path_included": {
              "const": false
            },
            "storage_uri_included": {
              "const": false
            },
            "storage_key_included": {
              "const": false
            }
          }
        }
      }
    },
    "item_privacy_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_source_included",
        "raw_summary_included",
        "embedding_vector_included",
        "storage_path_redacted"
      ],
      "properties": {
        "raw_source_included": {
          "const": false
        },
        "raw_summary_included": {
          "const": false
        },
        "embedding_vector_included": {
          "const": false
        },
        "storage_path_redacted": {
          "const": true
        }
      }
    },
    "detail_privacy_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_scoped",
        "not_found_and_not_authorized_collapsed",
        "legacy_upload_registration_route_replacement",
        "raw_source_included",
        "raw_summary_included",
        "embedding_vector_included",
        "storage_path_redacted"
      ],
      "properties": {
        "owner_scoped": {
          "const": true
        },
        "not_found_and_not_authorized_collapsed": {
          "const": true
        },
        "legacy_upload_registration_route_replacement": {
          "const": true
        },
        "raw_source_included": {
          "const": false
        },
        "raw_summary_included": {
          "const": false
        },
        "embedding_vector_included": {
          "const": false
        },
        "storage_path_redacted": {
          "const": true
        }
      }
    }
  }
}
