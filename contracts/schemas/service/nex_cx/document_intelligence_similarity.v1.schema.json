{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_cx/document_intelligence_similarity.v1.schema.json",
  "title": "NeX CX Document Intelligence Similarity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_intelligence_similarity_schema_version",
    "source_document",
    "freshness",
    "result",
    "raw_summary_included",
    "raw_vector_included",
    "observability"
  ],
  "properties": {
    "document_intelligence_similarity_schema_version": {
      "const": "cx_document_intelligence_similarity.v1"
    },
    "source_document": {"$ref": "#/$defs/sourceDocument"},
    "freshness": {"$ref": "#/$defs/freshness"},
    "result": {"$ref": "#/$defs/similarityResult"},
    "raw_summary_included": {"const": false},
    "raw_vector_included": {"const": false},
    "observability": {"$ref": "#/$defs/observability"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_object_id",
        "document_summary_id",
        "summary_embedding_id",
        "profile_fingerprint"
      ],
      "properties": {
        "content_object_id": {"type": "string", "format": "uuid"},
        "document_summary_id": {"type": "string", "format": "uuid"},
        "summary_embedding_id": {"type": "string", "format": "uuid"},
        "profile_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness_schema_version",
        "state",
        "usable",
        "reasons",
        "document_summary_id",
        "summary_embedding_id",
        "profile_fingerprint"
      ],
      "properties": {
        "freshness_schema_version": {"const": "cx_summary_vector_freshness.v1"},
        "state": {"enum": ["READY", "STALE"]},
        "usable": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "document_summary_id": {"type": "string", "format": "uuid"},
        "summary_embedding_id": {"type": "string", "format": "uuid"},
        "profile_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "similarityCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_similarity_candidate_schema_version",
        "candidate_rank",
        "content_object_id",
        "document_summary_id",
        "summary_embedding_id",
        "original_filename",
        "content_type",
        "summary_text_sha256",
        "summary_char_count",
        "embedding_sha256",
        "vector_dimension",
        "profile_fingerprint",
        "similarity_score",
        "cosine_distance"
      ],
      "properties": {
        "summary_similarity_candidate_schema_version": {"const": "cx_summary_similarity_candidate.v1"},
        "candidate_rank": {"type": "integer", "minimum": 1},
        "content_object_id": {"type": "string", "format": "uuid"},
        "document_summary_id": {"type": "string", "format": "uuid"},
        "summary_embedding_id": {"type": "string", "format": "uuid"},
        "original_filename": {"type": "string", "minLength": 1, "maxLength": 512},
        "content_type": {"type": "string", "minLength": 1, "maxLength": 160},
        "summary_text_sha256": {"$ref": "#/$defs/sha256"},
        "summary_char_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "embedding_sha256": {"$ref": "#/$defs/sha256"},
        "vector_dimension": {"type": "integer", "minimum": 1, "maximum": 8192},
        "profile_fingerprint": {"$ref": "#/$defs/sha256"},
        "similarity_score": {"type": "number", "minimum": -1, "maximum": 1},
        "cosine_distance": {"type": "number", "minimum": 0, "maximum": 2}
      }
    },
    "similarityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_similarity_result_schema_version",
        "candidate_source",
        "metric",
        "query_embedding_sha256",
        "query_dimension",
        "profile_fingerprint",
        "minimum_score",
        "excluded_content_object_id",
        "candidate_count",
        "candidates"
      ],
      "properties": {
        "summary_similarity_result_schema_version": {"const": "cx_summary_similarity_result.v1"},
        "candidate_source": {"const": "postgresql_pgvector_summary"},
        "metric": {"const": "cosine"},
        "query_embedding_sha256": {"$ref": "#/$defs/sha256"},
        "query_dimension": {"type": "integer", "minimum": 1, "maximum": 8192},
        "profile_fingerprint": {"$ref": "#/$defs/sha256"},
        "minimum_score": {"type": "number", "minimum": -1, "maximum": 1},
        "excluded_content_object_id": {"type": ["string", "null"], "format": "uuid"},
        "candidate_count": {"type": "integer", "minimum": 0, "maximum": 100},
        "candidates": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/similarityCandidate"}
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": {
        "ok": {"type": "boolean"},
        "event_id": {"type": "string", "format": "uuid"},
        "service_id": {"const": "nex-cx"},
        "event_type": {"const": "cx.document_intelligence.similarity_observed"},
        "severity": {"const": "INFO"},
        "error_code": {"type": "string"},
        "detail": {"type": "string"},
        "status_code": {"type": "integer"}
      },
      "allOf": [
        {
          "if": {"properties": {"ok": {"const": true}}},
          "then": {"required": ["event_id", "service_id", "event_type", "severity"]},
          "else": {"required": ["error_code", "detail", "status_code"]}
        }
      ]
    }
  }
}
