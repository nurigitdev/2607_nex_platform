{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_cx/retrieval_confidence_calibration_profile.v1.schema.json",
  "title": "NeX CX Retrieval Confidence Calibration Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_schema_version",
    "profile_id",
    "version",
    "status",
    "policy_id",
    "binding",
    "weights",
    "threshold",
    "evaluation",
    "profile_hash"
  ],
  "properties": {
    "profile_schema_version": {
      "const": "cx_retrieval_confidence_calibration_profile.v1"
    },
    "profile_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["CANDIDATE", "ACTIVE", "RETIRED"]},
    "policy_id": {"const": "cx_retrieval_confidence_multisignal_v1"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embedding_model_revision",
        "reranker_model_revision",
        "ranking_policy_id",
        "feature_schema_version"
      ],
      "properties": {
        "embedding_model_revision": {"type": "string", "minLength": 1},
        "reranker_model_revision": {"type": "string", "minLength": 1},
        "ranking_policy_id": {"type": "string", "minLength": 1},
        "feature_schema_version": {
          "const": "cx_retrieval_confidence_features.v1"
        }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reranker_score",
        "reranker_margin",
        "rrf_normalized_score",
        "channel_support"
      ],
      "properties": {
        "reranker_score": {"type": "number", "minimum": 0, "maximum": 1},
        "reranker_margin": {"type": "number", "minimum": 0, "maximum": 1},
        "rrf_normalized_score": {"type": "number", "minimum": 0, "maximum": 1},
        "channel_support": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "evaluation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "evaluation_schema_version",
        "dataset_id",
        "dataset_sha256",
        "status",
        "sample_count",
        "positive_count",
        "negative_count",
        "selected_threshold",
        "selected_metrics",
        "constraints"
      ],
      "properties": {
        "evaluation_schema_version": {"const": "model_calibration_evaluation.v1"},
        "dataset_id": {"type": "string", "minLength": 1},
        "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"const": "PASSED"},
        "sample_count": {"type": "integer", "minimum": 20},
        "positive_count": {"type": "integer", "minimum": 8},
        "negative_count": {"type": "integer", "minimum": 8},
        "selected_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "selected_metrics": {"type": "object"},
        "constraints": {"type": "object"}
      }
    },
    "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
