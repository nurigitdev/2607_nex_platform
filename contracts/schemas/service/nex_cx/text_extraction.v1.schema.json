{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_cx/text_extraction.v1.schema.json",
  "title": "NeX CX Text Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extraction_schema_version",
    "document_id",
    "job_id",
    "status",
    "trace_id",
    "request_id",
    "source_sha256",
    "extracted_markdown_sha256",
    "extracted_markdown_path",
    "markdown_char_count",
    "markdown_preview",
    "extracted_markdown_normalization",
    "extractor",
    "source_reader",
    "warnings",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "extraction_schema_version": {
      "const": "cx_text_extraction.v1"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "extracted_markdown_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "extracted_markdown_path": {
      "type": "string",
      "pattern": "^/.+\\.md$"
    },
    "markdown_char_count": {
      "type": "integer",
      "minimum": 0
    },
    "markdown_preview": {
      "type": "string",
      "maxLength": 120
    },
    "extracted_markdown_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalization_schema_version",
        "source_format",
        "line_endings",
        "final_newline",
        "trailing_whitespace_present",
        "title_present",
        "required_section_heading",
        "required_section_heading_present",
        "heading_count",
        "table_count",
        "line_count",
        "char_count",
        "warning_count",
        "contract_status"
      ],
      "properties": {
        "normalization_schema_version": {
          "const": "cx_extracted_markdown_normalization.v1"
        },
        "source_format": {
          "type": "string",
          "enum": [
            "markdown",
            "plain_text",
            "pdf",
            "docx",
            "pptx",
            "xlsx"
          ]
        },
        "line_endings": {
          "const": "lf"
        },
        "final_newline": {
          "const": true
        },
        "trailing_whitespace_present": {
          "const": false
        },
        "title_present": {
          "type": "boolean"
        },
        "required_section_heading": {
          "type": "string",
          "enum": [
            "none",
            "page",
            "slide",
            "sheet"
          ]
        },
        "required_section_heading_present": {
          "type": "boolean"
        },
        "heading_count": {
          "type": "integer",
          "minimum": 0
        },
        "table_count": {
          "type": "integer",
          "minimum": 0
        },
        "line_count": {
          "type": "integer",
          "minimum": 0
        },
        "char_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "contract_status": {
          "const": "valid"
        }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "mode",
        "version",
        "source_format"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_format": {
          "type": "string",
          "enum": [
            "markdown",
            "plain_text",
            "pdf",
            "docx",
            "pptx",
            "xlsx"
          ]
        }
      }
    },
    "source_reader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_reader_schema_version",
        "source",
        "runtime_source_bytes_used",
        "fallback_used",
        "checksum_algorithm",
        "storage_key_included",
        "local_storage_path_included",
        "raw_source_included"
      ],
      "properties": {
        "source_reader_schema_version": {
          "const": "cx_source_reader.v1"
        },
        "source": {
          "type": "string",
          "enum": [
            "runtime_memory",
            "materialized_local_source_file"
          ]
        },
        "runtime_source_bytes_used": {
          "type": "boolean"
        },
        "fallback_used": {
          "type": "boolean"
        },
        "checksum_algorithm": {
          "const": "sha256"
        },
        "storage_key_included": {
          "const": false
        },
        "local_storage_path_included": {
          "const": false
        },
        "raw_source_included": {
          "const": false
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
