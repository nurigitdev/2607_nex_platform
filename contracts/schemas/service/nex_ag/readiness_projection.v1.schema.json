{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ag/readiness_projection.v1.schema.json",
  "title": "NeX AG Readiness Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_schema_version",
    "checked_at",
    "services",
    "summary"
  ],
  "properties": {
    "projection_schema_version": {
      "const": "ag_readiness_projection.v1"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service_projection"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "ready",
        "not_ready",
        "degraded",
        "unavailable"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "not_ready": {
          "type": "integer",
          "minimum": 0
        },
        "degraded": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "service_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "base_url",
        "health_status",
        "readiness_status",
        "version",
        "contract_catalog_version",
        "observed_status",
        "failures"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "enum": [
            "nex-oa",
            "nex-ag",
            "nex-ae-api",
            "nex-cx",
            "nex-mo"
          ]
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "health_status": {
          "type": "string"
        },
        "readiness_status": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "contract_catalog_version": {
          "type": "string"
        },
        "observed_status": {
          "type": "string",
          "enum": [
            "READY",
            "NOT_READY",
            "DEGRADED",
            "UNAVAILABLE"
          ]
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
