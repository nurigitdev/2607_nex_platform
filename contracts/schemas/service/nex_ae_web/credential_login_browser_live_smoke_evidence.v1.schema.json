{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_web/credential_login_browser_live_smoke_evidence.v1.schema.json",
  "title": "NeX AE Web Credential-Login Browser Live Smoke Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "smoke_schema_version",
    "status",
    "profile",
    "services",
    "source_smokes",
    "activation",
    "database_envs",
    "redacted_database_urls",
    "migrations",
    "request_id",
    "trace_id",
    "db_observations",
    "credential_login_observations",
    "browser_harness_observations",
    "execution_observations",
    "checks",
    "cleanup_observations",
    "redaction"
  ],
  "properties": {
    "smoke_schema_version": {
      "const": "ae_web_credential_login_browser_live_smoke.v1"
    },
    "status": {
      "const": "PASS"
    },
    "profile": {
      "const": "test"
    },
    "services": {
      "type": "array",
      "prefixItems": [
        {
          "const": "nex-ae-web"
        },
        {
          "const": "nex-ae-api"
        },
        {
          "const": "nex-oa"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "source_smokes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary",
        "readiness",
        "credential_postgres",
        "browser_harness"
      ],
      "properties": {
        "boundary": {
          "$ref": "#/$defs/source_smoke_boundary"
        },
        "readiness": {
          "$ref": "#/$defs/source_smoke_readiness"
        },
        "credential_postgres": {
          "$ref": "#/$defs/source_smoke_credential"
        },
        "browser_harness": {
          "$ref": "#/$defs/source_smoke_harness"
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "env",
        "enabled",
        "default_quality_gate_behavior"
      ],
      "properties": {
        "env": {
          "const": "NEX_AE_WEB_CREDENTIAL_LOGIN_BROWSER_SMOKE"
        },
        "enabled": {
          "const": true
        },
        "default_quality_gate_behavior": {
          "const": "skipped_until_explicitly_enabled"
        }
      }
    },
    "database_envs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ae",
        "oa"
      ],
      "properties": {
        "ae": {
          "const": "NEX_AE_TEST_DATABASE_URL"
        },
        "oa": {
          "const": "NEX_OA_TEST_DATABASE_URL"
        }
      }
    },
    "redacted_database_urls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ae",
        "oa"
      ],
      "properties": {
        "ae": {
          "$ref": "#/$defs/redacted_test_database_url"
        },
        "oa": {
          "$ref": "#/$defs/redacted_test_database_url"
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ae",
        "oa"
      ],
      "properties": {
        "ae": {
          "$ref": "#/$defs/migration_evidence"
        },
        "oa": {
          "$ref": "#/$defs/migration_evidence"
        }
      }
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "db_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ae_marker_rows",
        "oa_credential_count",
        "oa_session_count",
        "oa_session_status",
        "oa_session_revoked_at_present"
      ],
      "properties": {
        "ae_marker_rows": {
          "type": "integer",
          "minimum": 1
        },
        "oa_credential_count": {
          "type": "integer",
          "minimum": 1
        },
        "oa_session_count": {
          "type": "integer",
          "minimum": 1
        },
        "oa_session_status": {
          "const": "REVOKED"
        },
        "oa_session_revoked_at_present": {
          "const": true
        }
      }
    },
    "credential_login_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ae_endpoint",
        "oa_endpoint",
        "oa_client_operations",
        "password_verified",
        "browser_cookie_value_kind",
        "browser_cookie_material_in_evidence",
        "owner_scope_authority"
      ],
      "properties": {
        "ae_endpoint": {
          "const": "POST /api/v1/auth/session/login"
        },
        "oa_endpoint": {
          "const": "POST /internal/v1/auth/user-login"
        },
        "oa_client_operations": {
          "type": "array",
          "prefixItems": [
            {
              "const": "login_with_credentials"
            },
            {
              "const": "introspect_session"
            },
            {
              "const": "introspect_session"
            },
            {
              "const": "revoke_session"
            },
            {
              "const": "introspect_session"
            }
          ],
          "minItems": 5,
          "maxItems": 5
        },
        "password_verified": {
          "const": true
        },
        "browser_cookie_value_kind": {
          "const": "opaque_oa_session_id"
        },
        "browser_cookie_material_in_evidence": {
          "const": false
        },
        "owner_scope_authority": {
          "const": "claim"
        }
      }
    },
    "browser_harness_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "route_guard_status",
        "fetch_call_count",
        "login_route",
        "current_session_status",
        "authenticated_session_status",
        "logout_session_status"
      ],
      "properties": {
        "mode": {
          "const": "deterministic_fake_fetch"
        },
        "route_guard_status": {
          "const": "allowed"
        },
        "fetch_call_count": {
          "type": "integer",
          "minimum": 1
        },
        "login_route": {
          "const": "/api/v1/auth/session/login"
        },
        "current_session_status": {
          "const": "anonymous"
        },
        "authenticated_session_status": {
          "const": "authenticated"
        },
        "logout_session_status": {
          "const": "anonymous"
        }
      }
    },
    "execution_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_test_database_smoke_executed",
        "browser_harness_kind",
        "browser_live_network_executed",
        "postgres_execution_runner",
        "playwright_execution_status"
      ],
      "properties": {
        "actual_test_database_smoke_executed": {
          "const": true
        },
        "browser_harness_kind": {
          "const": "deterministic_fake_fetch"
        },
        "browser_live_network_executed": {
          "const": false
        },
        "postgres_execution_runner": {
          "const": "run_ae_credential_login_postgres_smoke"
        },
        "playwright_execution_status": {
          "const": "deferred_until_explicit_dependency_decision"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_passed",
        "readiness_passed",
        "credential_postgres_smoke_passed",
        "browser_harness_smoke_passed",
        "actual_test_database_smoke_executed",
        "ae_test_database_connected",
        "oa_test_database_connected",
        "oa_credential_login_proven",
        "password_verified",
        "ae_cookie_session_facade_proven",
        "route_guard_allowed",
        "logout_returns_anonymous",
        "db_session_revoked",
        "redacted_evidence"
      ],
      "properties": {
        "boundary_passed": {
          "const": true
        },
        "readiness_passed": {
          "const": true
        },
        "credential_postgres_smoke_passed": {
          "const": true
        },
        "browser_harness_smoke_passed": {
          "const": true
        },
        "actual_test_database_smoke_executed": {
          "const": true
        },
        "ae_test_database_connected": {
          "const": true
        },
        "oa_test_database_connected": {
          "const": true
        },
        "oa_credential_login_proven": {
          "const": true
        },
        "password_verified": {
          "const": true
        },
        "ae_cookie_session_facade_proven": {
          "const": true
        },
        "route_guard_allowed": {
          "const": true
        },
        "logout_returns_anonymous": {
          "const": true
        },
        "db_session_revoked": {
          "const": true
        },
        "redacted_evidence": {
          "const": true
        }
      }
    },
    "cleanup_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ae_marker_rows_after_delete",
        "oa_rows"
      ],
      "properties": {
        "ae_marker_rows_after_delete": {
          "const": 0
        },
        "oa_rows": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deleted_sessions",
            "deleted_credentials",
            "deleted_memberships",
            "deleted_subjects",
            "deleted_tenants"
          ],
          "properties": {
            "deleted_sessions": {
              "type": "integer",
              "minimum": 1
            },
            "deleted_credentials": {
              "type": "integer",
              "minimum": 1
            },
            "deleted_memberships": {
              "type": "integer",
              "minimum": 1
            },
            "deleted_subjects": {
              "type": "integer",
              "minimum": 1
            },
            "deleted_tenants": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_password_in_evidence",
        "database_endpoint_in_evidence",
        "cookie_material_in_evidence",
        "token_material_in_evidence",
        "provider_endpoint_in_evidence"
      ],
      "properties": {
        "raw_password_in_evidence": {
          "const": false
        },
        "database_endpoint_in_evidence": {
          "const": false
        },
        "cookie_material_in_evidence": {
          "const": false
        },
        "token_material_in_evidence": {
          "const": false
        },
        "provider_endpoint_in_evidence": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "redacted_test_database_url": {
      "type": "string",
      "pattern": "^postgresql(\\+psycopg)?://[^\\s:/]+:\\*\\*\\*@[^\\s]+/[^\\s/]+_test$"
    },
    "migration_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "profile",
        "planned_count",
        "applied",
        "skipped_count",
        "dry_run"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "enum": [
            "nex-ae-api",
            "nex-oa"
          ]
        },
        "profile": {
          "const": "test"
        },
        "planned_count": {
          "type": "integer",
          "minimum": 0
        },
        "applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped_count": {
          "type": "integer",
          "minimum": 0
        },
        "dry_run": {
          "const": false
        }
      }
    },
    "source_smoke_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status"
      ],
      "properties": {
        "schema_version": {
          "const": "ae_web_credential_login_browser_smoke_boundary.v1"
        },
        "status": {
          "const": "PASS"
        }
      }
    },
    "source_smoke_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status"
      ],
      "properties": {
        "schema_version": {
          "const": "ae_web_credential_login_browser_execution_readiness.v1"
        },
        "status": {
          "const": "PASS"
        }
      }
    },
    "source_smoke_credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status"
      ],
      "properties": {
        "schema_version": {
          "const": "ae_credential_login_postgres_smoke.v1"
        },
        "status": {
          "const": "PASS"
        }
      }
    },
    "source_smoke_harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status"
      ],
      "properties": {
        "schema_version": {
          "const": "ae_web_credential_login_browser_harness_smoke_runner.v1"
        },
        "status": {
          "const": "PASS"
        }
      }
    }
  }
}
