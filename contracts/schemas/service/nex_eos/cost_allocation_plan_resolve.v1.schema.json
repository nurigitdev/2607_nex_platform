{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_eos/cost_allocation_plan_resolve.v1.schema.json",
  "title": "EOS Cost Allocation Plan Resolve v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_kind", "scope_type", "effective_on", "projects"
  ],
  "properties": {
    "schema_version": {"const": "eos_cost_allocation_plan_resolve.v1"},
    "source_kind": {
      "enum": [
        "PAYROLL", "PURCHASE", "SERVICE", "SHARED_EXPENSE",
        "REVENUE", "FX_GAIN_LOSS", "OTHER"
      ]
    },
    "scope_type": {"const": "PROJECT_SET"},
    "effective_on": {"type": "string", "format": "date"},
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/project"}
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "project_code", "allocation_ratio"],
      "properties": {
        "project_id": {"type": "string", "format": "uuid"},
        "project_code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}[DMSOIG][0-9]{6}$"
        },
        "allocation_ratio": {
          "type": "string",
          "pattern": "^(?:0\\.(?!0{12}$)[0-9]{12}|1\\.000000000000)$"
        }
      }
    }
  }
}
