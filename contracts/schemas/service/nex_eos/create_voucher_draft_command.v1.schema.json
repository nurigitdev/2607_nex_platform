{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_eos/create_voucher_draft_command.v1.schema.json",
  "title": "EOS Create Voucher Draft Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tenant_id", "business_operation_id", "idempotency_key",
    "payload_hash", "requester_ref", "project_ref", "voucher_type",
    "transaction_date", "currency", "description", "lines",
    "nsl_approval_request_id", "nsl_approval_evidence_ref", "trace"
  ],
  "allOf": [
    {
      "if": {
        "required": ["attachments"],
        "properties": {"attachments": {"minItems": 1}}
      },
      "then": {
        "required": ["attachment_batch_id", "attachment_manifest_hash"]
      }
    }
  ],
  "properties": {
    "schema_version": {"const": "eos_create_voucher_draft_command.v1"},
    "tenant_id": {"$ref": "#/$defs/scoped_id"},
    "business_operation_id": {"$ref": "#/$defs/uuid"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:.*\\S)?$"},
    "payload_hash": {"$ref": "#/$defs/hash_ref"},
    "requester_ref": {"$ref": "#/$defs/entity_ref"},
    "project_ref": {
      "allOf": [
        {"$ref": "#/$defs/entity_ref"},
        {"properties": {"type": {"const": "eos.project"}}}
      ]
    },
    "voucher_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$"},
    "transaction_date": {"type": "string", "format": "date"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "lines": {
      "type": "array", "minItems": 2, "maxItems": 1000,
      "items": {"$ref": "#/$defs/voucher_line"}
    },
    "nsl_approval_request_id": {"$ref": "#/$defs/scoped_id"},
    "nsl_approval_evidence_ref": {"$ref": "#/$defs/scoped_id"},
    "business_approval_proof_ref": {
      "oneOf": [{"$ref": "#/$defs/scoped_id"}, {"type": "null"}]
    },
    "attachment_batch_id": {"$ref": "#/$defs/uuid"},
    "attachment_manifest_hash": {"$ref": "#/$defs/hash_ref"},
    "attachments": {
      "type": "array", "maxItems": 20, "uniqueItems": true,
      "items": {"$ref": "#/$defs/attachment"}
    },
    "trace": {"$ref": "#/$defs/trace"}
  },
  "$defs": {
    "scoped_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "uuid": {"type": "string", "format": "uuid"},
    "hash_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entity_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "id": {"$ref": "#/$defs/scoped_id"}
      }
    },
    "voucher_line": {
      "type": "object", "additionalProperties": false,
      "required": ["line_no", "account_ref", "signed_amount", "economic_category", "evidence_refs"],
      "properties": {
        "line_no": {"type": "integer", "minimum": 1},
        "account_ref": {
          "allOf": [
            {"$ref": "#/$defs/entity_ref"},
            {"properties": {"type": {"const": "eos.account"}}}
          ]
        },
        "signed_amount": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]{0,17})\\.[0-9]{2}$", "not": {"enum": ["0.00", "-0.00"]}},
        "economic_category": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$"},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "evidence_refs": {
          "type": "array", "maxItems": 20, "uniqueItems": true,
          "items": {"$ref": "#/$defs/scoped_id"}
        }
      }
    },
    "attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["attachment_id", "object_ref", "display_name", "media_type", "size_bytes", "content_sha256"],
      "properties": {
        "attachment_id": {"$ref": "#/$defs/uuid"},
        "object_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{15,255}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 512},
        "media_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]{0,63}/[a-z0-9][a-z0-9.+-]{0,127}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_ref": {"oneOf": [{"$ref": "#/$defs/scoped_id"}, {"type": "null"}]}
      }
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["trace_id", "correlation_id", "causation_id"],
      "properties": {
        "trace_id": {"$ref": "#/$defs/scoped_id"},
        "correlation_id": {"$ref": "#/$defs/scoped_id"},
        "causation_id": {"$ref": "#/$defs/scoped_id"}
      }
    }
  }
}
