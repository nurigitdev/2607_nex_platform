{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_eos/project_verification_request.v1.schema.json",
  "title": "EOS Project Verification Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "project_ids"],
  "properties": {
    "tenant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$"},
    "project_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uuid"}
    }
  }
}
