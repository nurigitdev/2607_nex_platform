{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_eos/nvt_project_create_command.v1.schema.json",
  "title": "EOS NVTProject Create Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "business_operation_id",
    "idempotency_key",
    "payload_hash",
    "requester_subject_id",
    "nvt_project"
  ],
  "properties": {
    "schema_version": {"const": "eos_nvt_project_create_command.v1"},
    "tenant_id": {"$ref": "#/$defs/scoped_id"},
    "business_operation_id": {"$ref": "#/$defs/uuid"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "payload_hash": {"$ref": "#/$defs/hash_ref"},
    "requester_subject_id": {"$ref": "#/$defs/scoped_id"},
    "requested_operation": {"const": "PROJECT.NVT_PROJECT.CREATE"},
    "nvt_project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nvt_project_id", "nvt_project_code", "name", "status"],
      "properties": {
        "nvt_project_id": {"$ref": "#/$defs/uuid"},
        "nvt_project_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "status": {"const": "ACTIVE"}
      }
    }
  },
  "$defs": {
    "scoped_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$"
    },
    "uuid": {"type": "string", "format": "uuid"},
    "hash_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
