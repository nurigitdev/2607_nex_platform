{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/nex_eos/transaction_preparation_authority_resolve.v1.schema.json",
  "title": "EOS Transaction Preparation Authority Resolve",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tenant_id", "requester_subject_id", "business_context_hash",
    "company_selector", "project_codes", "amount", "currency", "recognition_date",
    "debit_semantic_key", "credit_semantic_key", "capability_binding",
    "coordinator_binding", "correlation_id", "request_hash"
  ],
  "properties": {
    "schema_version": {"const": "eos_transaction_preparation_authority_resolve.v1"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "requester_subject_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "business_context_hash": {"$ref": "#/$defs/hashRef"},
    "company_selector": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["CODE", "NAME", "CODE_OR_NAME"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "project_codes": {
      "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9]{4}[DMSOIG][0-9]{6}$"}
    },
    "amount": {"type": "string", "pattern": "^[0-9]{1,16}\\.[0-9]{2}$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "recognition_date": {"type": "string", "format": "date"},
    "debit_semantic_key": {"type": "string", "pattern": "^MB-COA-[A-Z0-9-]{1,112}$"},
    "credit_semantic_key": {"type": "string", "pattern": "^MB-COA-[A-Z0-9-]{1,112}$"},
    "capability_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "capability_version", "capability_registration_hash"],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "capability_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "capability_registration_hash": {"$ref": "#/$defs/hashRef"}
      }
    },
    "coordinator_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinator_id", "coordinator_version", "coordinator_registration_hash", "preparation_adapter_source_identity"],
      "properties": {
        "coordinator_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "coordinator_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "coordinator_registration_hash": {"$ref": "#/$defs/hashRef"},
        "preparation_adapter_source_identity": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_hash": {"$ref": "#/$defs/hashRef"}
  },
  "$defs": {
    "hashRef": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
