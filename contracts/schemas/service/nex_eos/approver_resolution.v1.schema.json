{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_eos/approver_resolution.v1.schema.json",
  "title": "EOS Approver Resolution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tenant_id", "approval_domain", "risk_level",
    "policy_ref", "requester_ref", "principal_ref", "position_type",
    "position_ref", "position_assignment_ref", "org_unit_ref", "project_ref",
    "resolution_ref", "resolution_hash", "resolved_at", "security_authorization"
  ],
  "properties": {
    "schema_version": {"const": "eos_approver_resolution.v1"},
    "tenant_id": {"$ref": "#/$defs/scoped_id"},
    "approval_domain": {
      "enum": ["AGENT_FORMAL", "NSL_WRITE", "BUSINESS_FORMAL"]
    },
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "policy_ref": {"const": "eos.approver.default.v1"},
    "requester_ref": {
      "allOf": [
        {"$ref": "#/$defs/entity_ref"},
        {"properties": {"type": {"const": "oa.user"}}}
      ]
    },
    "principal_ref": {
      "allOf": [
        {"$ref": "#/$defs/entity_ref"},
        {"properties": {"type": {"const": "oa.user"}}}
      ]
    },
    "position_type": {
      "enum": ["PART_LEAD", "TEAM_LEAD", "GROUP_LEAD", "CEO", "CHAIRMAN"]
    },
    "position_ref": {
      "allOf": [
        {"$ref": "#/$defs/uuid_entity_ref"},
        {"properties": {"type": {"const": "eos.position"}}}
      ]
    },
    "position_assignment_ref": {
      "allOf": [
        {"$ref": "#/$defs/uuid_entity_ref"},
        {"properties": {"type": {"const": "eos.position_assignment"}}}
      ]
    },
    "org_unit_ref": {
      "allOf": [
        {"$ref": "#/$defs/uuid_entity_ref"},
        {"properties": {"type": {"const": "eos.org_unit"}}}
      ]
    },
    "project_ref": {
      "oneOf": [
        {
          "allOf": [
            {"$ref": "#/$defs/uuid_entity_ref"},
            {"properties": {"type": {"const": "eos.project"}}}
          ]
        },
        {"type": "null"}
      ]
    },
    "resolution_ref": {
      "type": "string",
      "pattern": "^eos\\.approver-resolution:[0-9a-f]{64}$"
    },
    "resolution_hash": {"$ref": "#/$defs/hash_ref"},
    "resolved_at": {"type": "string", "format": "date-time"},
    "security_authorization": {"const": false}
  },
  "$defs": {
    "scoped_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "hash_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "id": {"$ref": "#/$defs/scoped_id"}
      }
    },
    "uuid_entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "id": {"type": "string", "format": "uuid"}
      }
    }
  }
}
