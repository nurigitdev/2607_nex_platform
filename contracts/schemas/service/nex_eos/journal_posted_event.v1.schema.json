{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_eos/journal_posted_event.v1.schema.json",
  "title": "EOS Journal Posted Outbox Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tenant_id", "business_operation_id", "operation",
    "company_id", "journal_id", "journal_no", "journal_hash", "candidate_id",
    "candidate_revision", "accounting_acceptance_id", "accounting_period_id",
    "project_codes", "commit_state", "posted_at"
  ],
  "properties": {
    "schema_version": {"const": "eos_journal_posted_event.v1"},
    "tenant_id": {"$ref": "#/$defs/scoped_id"},
    "business_operation_id": {"type": "string", "format": "uuid"},
    "operation": {"const": "FINANCE.VOUCHER.APPROVE_AND_POST"},
    "company_id": {"type": "string", "format": "uuid"},
    "journal_id": {"type": "string", "format": "uuid"},
    "journal_no": {"$ref": "#/$defs/scoped_id"},
    "journal_hash": {"$ref": "#/$defs/hash_ref"},
    "candidate_id": {"type": "string", "format": "uuid"},
    "candidate_revision": {"type": "integer", "minimum": 1},
    "accounting_acceptance_id": {"type": "string", "format": "uuid"},
    "accounting_period_id": {"type": "string", "format": "uuid"},
    "project_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9]{4}[DMSOIG][0-9]{6}$"}
    },
    "commit_state": {"const": "COMMITTED"},
    "posted_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "hash_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scoped_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,255}$"}
  }
}
