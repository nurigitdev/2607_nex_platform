{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_eos/voucher_candidate_review_invalidate.v1.schema.json",
  "title": "EOS VoucherCandidate Review Invalidation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tenant_id", "event_id", "candidate_id",
    "approval_case_id", "expected_candidate_version", "expected_revision_no",
    "expected_candidate_hash", "actor_subject_id", "reason", "invalidated_at"
  ],
  "properties": {
    "schema_version": {"const": "eos_candidate_review_invalidate.v1"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "event_id": {"type": "string", "format": "uuid"},
    "candidate_id": {"type": "string", "format": "uuid"},
    "approval_case_id": {"type": "string", "format": "uuid"},
    "expected_candidate_version": {"type": "integer", "minimum": 1},
    "expected_revision_no": {"type": "integer", "minimum": 1},
    "expected_candidate_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actor_subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "invalidated_at": {"type": "string", "format": "date-time"}
  }
}
