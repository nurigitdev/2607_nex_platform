{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/project_membership_batch_admission.v1.schema.json",
  "title": "NeX AE Project Membership Batch Admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "directive",
    "operation_id",
    "tenant_id",
    "requester_subject_id",
    "project_id",
    "member_role",
    "requested_count",
    "admitted_count",
    "rejected_count",
    "admitted_members",
    "rejected_candidates",
    "resolution_evidence_hash",
    "protected_intake_hash",
    "governed_payload",
    "payload_hash",
    "approval_projection",
    "admission_hash"
  ],
  "properties": {
    "schema_version": {"const": "p8.project_membership_batch_admission.v1"},
    "directive": {"enum": ["CONTINUE", "REJECTED"]},
    "operation_id": {"const": "PROJECT.MEMBERSHIP.ADD_MANY"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "requester_subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "member_role": {"enum": ["OWNER", "MANAGER", "MEMBER", "VIEWER"]},
    "requested_count": {"type": "integer", "minimum": 1, "maximum": 50},
    "admitted_count": {"type": "integer", "minimum": 0, "maximum": 50},
    "rejected_count": {"type": "integer", "minimum": 0, "maximum": 50},
    "admitted_members": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/admittedMember"}
    },
    "rejected_candidates": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/rejectedCandidate"}
    },
    "resolution_evidence_hash": {"$ref": "#/$defs/hashRef"},
    "protected_intake_hash": {"$ref": "#/$defs/hashRef"},
    "governed_payload": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/governedPayload"}]
    },
    "payload_hash": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/hashRef"}]
    },
    "approval_projection": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/approvalProjection"}]
    },
    "admission_hash": {"$ref": "#/$defs/hashRef"}
  },
  "allOf": [
    {
      "if": {"properties": {"directive": {"const": "REJECTED"}}},
      "then": {
        "properties": {
          "admitted_count": {"const": 0},
          "admitted_members": {"maxItems": 0},
          "governed_payload": {"type": "null"},
          "payload_hash": {"type": "null"},
          "approval_projection": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "admitted_count": {"minimum": 1},
          "admitted_members": {"minItems": 1},
          "governed_payload": {"$ref": "#/$defs/governedPayload"},
          "payload_hash": {"$ref": "#/$defs/hashRef"},
          "approval_projection": {"$ref": "#/$defs/approvalProjection"}
        }
      }
    }
  ],
  "$defs": {
    "hashRef": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subjectIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "admittedMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "subject_revision", "tenant_membership_revision"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "subject_revision": {"type": "integer", "minimum": 1},
        "tenant_membership_revision": {"type": "integer", "minimum": 1}
      }
    },
    "rejectedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_index", "outcome_code"],
      "properties": {
        "input_index": {"type": "integer", "minimum": 0},
        "outcome_code": {
          "enum": [
            "INVALID_EMPLOYEE_ID",
            "EMPLOYEE_NOT_FOUND",
            "SUBJECT_INACTIVE",
            "NAME_MISMATCH",
            "DUPLICATE_INPUT",
            "DUPLICATE_SUBJECT"
          ]
        },
        "normalized_employee_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "governedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "requester_subject_id",
        "project_id",
        "target_subject_ids",
        "member_role",
        "resolution_evidence_hash"
      ],
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "requester_subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "target_subject_ids": {"$ref": "#/$defs/subjectIds"},
        "member_role": {"enum": ["OWNER", "MANAGER", "MEMBER", "VIEWER"]},
        "resolution_evidence_hash": {"$ref": "#/$defs/hashRef"}
      }
    },
    "approvalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "project_id",
        "target_subject_ids",
        "target_count",
        "rejected_count",
        "member_role",
        "resolution_evidence_hash",
        "payload_hash"
      ],
      "properties": {
        "operation_id": {"const": "PROJECT.MEMBERSHIP.ADD_MANY"},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "target_subject_ids": {"$ref": "#/$defs/subjectIds"},
        "target_count": {"type": "integer", "minimum": 1, "maximum": 50},
        "rejected_count": {"type": "integer", "minimum": 0, "maximum": 50},
        "member_role": {"enum": ["OWNER", "MANAGER", "MEMBER", "VIEWER"]},
        "resolution_evidence_hash": {"$ref": "#/$defs/hashRef"},
        "payload_hash": {"$ref": "#/$defs/hashRef"}
      }
    }
  }
}
