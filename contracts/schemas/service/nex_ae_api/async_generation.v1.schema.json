{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/async_generation.v1.schema.json",
  "title": "NeX AE Asynchronous Generation Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "async_generation_schema_version",
    "execution_strategy",
    "lifecycle_status",
    "admission_status",
    "job_id",
    "cx_generation_id",
    "cx_job_status",
    "attempt_count",
    "max_attempts",
    "retryable",
    "handoff_status",
    "next_action",
    "error",
    "links",
    "owner_scope_enforced",
    "content_included"
  ],
  "properties": {
    "async_generation_schema_version": {
      "const": "ae_async_generation.v1"
    },
    "execution_strategy": {
      "const": "ASYNCHRONOUS"
    },
    "lifecycle_status": {
      "enum": ["PENDING", "COMPLETED", "BLOCKED"]
    },
    "admission_status": {
      "enum": ["ENQUEUED", "JOINED", "REPLAYED"]
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "cx_generation_id": {
      "type": "string",
      "minLength": 1
    },
    "cx_job_status": {
      "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "handoff_status": {
      "enum": ["PENDING", "READY", "BLOCKED", null]
    },
    "next_action": {
      "enum": [
        "POLL_GENERATION_HANDOFF",
        "PRESENT_GENERATION_TO_OWNER",
        "RETRY_OR_REVIEW_GENERATION"
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["error_code", "retryable", "dead_lettered"],
          "properties": {
            "error_code": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "dead_lettered": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string",
          "pattern": "^/api/v1/"
        },
        "async_job": {
          "type": "string",
          "pattern": "^/api/v1/"
        }
      }
    },
    "owner_scope_enforced": {
      "const": true
    },
    "content_included": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "PENDING"
          }
        }
      },
      "then": {
        "properties": {
          "cx_job_status": {
            "enum": ["QUEUED", "RUNNING", "SUCCEEDED"]
          },
          "handoff_status": {
            "enum": ["PENDING", null]
          },
          "next_action": {
            "const": "POLL_GENERATION_HANDOFF"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "properties": {
          "cx_job_status": {
            "const": "SUCCEEDED"
          },
          "handoff_status": {
            "const": "READY"
          },
          "next_action": {
            "const": "PRESENT_GENERATION_TO_OWNER"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "cx_job_status": {
            "enum": ["FAILED", "CANCELLED"]
          },
          "handoff_status": {
            "enum": ["BLOCKED", null]
          },
          "next_action": {
            "const": "RETRY_OR_REVIEW_GENERATION"
          }
        }
      }
    }
  ],
  "not": {
    "anyOf": [
      {"required": ["content"]},
      {"required": ["raw_prompt"]},
      {"required": ["provider_url"]},
      {"required": ["api_key"]}
    ]
  }
}
