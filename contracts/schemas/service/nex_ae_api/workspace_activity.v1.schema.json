{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/workspace_activity.v1.schema.json",
  "title": "NeX AE Workspace Activity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activity_schema_version",
    "activity_id",
    "workspace_id",
    "activity_type",
    "trace_id",
    "request_id",
    "summary",
    "metadata",
    "created_at"
  ],
  "properties": {
    "activity_schema_version": {
      "const": "ae_workspace_activity.v1"
    },
    "activity_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "workspace.created",
        "chat.interaction.started",
        "chat.interaction.completed",
        "chat.interaction.no_answer",
        "chat.interaction.failed",
        "chat.agent-runtime.admitted",
        "chat.async.admitted",
        "agent.result.published",
        "agent.execution.progress"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "metadata": {
      "oneOf": [
        {
          "$ref": "#/$defs/workspaceCreatedMetadata"
        },
        {
          "$ref": "#/$defs/chatInteractionMetadata"
        },
        {
          "$ref": "#/$defs/agentResultPublishedMetadata"
        },
        {
          "$ref": "#/$defs/agentExecutionProgressMetadata"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "workspaceCreatedMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "owner_user_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_user_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "chatInteractionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_id",
        "status",
        "user_message_hash"
      ],
      "properties": {
        "interaction_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "COMPLETED",
            "NO_ANSWER",
            "FAILED"
          ]
        },
        "user_message_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "agentResultPublishedMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_ref",
        "agent_execution_ref",
        "agent_result_ref",
        "agent_result_hash",
        "result_delivery_ref",
        "result_status",
        "structured_result_contract_ref",
        "business_refs",
        "external_refs"
      ],
      "properties": {
        "interaction_ref": {"type": "string", "minLength": 1},
        "agent_execution_ref": {"type": "string", "minLength": 1},
        "agent_result_ref": {"type": "string", "minLength": 1},
        "agent_result_hash": {"type": "string", "minLength": 1},
        "result_delivery_ref": {"type": "string", "minLength": 1},
        "result_status": {"type": "string", "minLength": 1},
        "structured_result_contract_ref": {"type": ["string", "null"]},
        "business_refs": {"type": "array", "items": {"type": "string"}},
        "external_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "agentExecutionProgressMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_id",
        "event_code",
        "state",
        "agent_type",
        "source_ref",
        "terminal",
        "private_payload_included"
      ],
      "properties": {
        "interaction_id": {"type": "string", "format": "uuid"},
        "event_code": {"type": "string", "minLength": 1, "maxLength": 96},
        "state": {"type": "string", "minLength": 1, "maxLength": 48},
        "agent_type": {"type": ["string", "null"]},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "terminal": {"type": "boolean"},
        "private_payload_included": {"const": false}
      }
    }
  }
}
