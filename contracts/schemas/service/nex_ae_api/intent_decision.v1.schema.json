{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/intent_decision.v1.schema.json",
  "title": "NeX AE Intent Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_decision_schema_version",
    "intent_label",
    "task_category",
    "execution_mode",
    "decision_source",
    "confidence",
    "retrieval_required",
    "template_required",
    "matched_rule",
    "raw_prompt_included",
    "decision_hash"
  ],
  "properties": {
    "intent_decision_schema_version": {
      "const": "ae_intent_decision.v1"
    },
    "intent_label": {
      "type": "string",
      "minLength": 1
    },
    "task_category": {
      "type": "string",
      "minLength": 1
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "GENERAL_ANSWER",
        "GROUNDED_ANSWER",
        "DOCUMENT_SUMMARY",
        "DOCUMENT_GENERATION"
      ]
    },
    "decision_source": {
      "type": "string",
      "enum": [
        "EXPLICIT",
        "DETERMINISTIC_FALLBACK"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "retrieval_required": {
      "type": "boolean"
    },
    "template_required": {
      "type": "boolean"
    },
    "matched_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_prompt_included": {
      "const": false
    },
    "decision_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
