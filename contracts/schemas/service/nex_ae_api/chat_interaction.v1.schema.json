{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/chat_interaction.v1.schema.json",
  "title": "NeX AE Chat Interaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interaction_schema_version",
    "interaction_id",
    "chat_document_id",
    "status",
    "trace_id",
    "request_id",
    "user_message_hash",
    "user_message_preview",
    "cx_generation_id",
    "cx_status",
    "generation",
    "retrieval",
    "artifact_refs",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "interaction_schema_version": {
      "const": "ae_chat_interaction.v1"
    },
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "chat_document_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "NO_ANSWER",
        "FAILED"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "user_message_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "user_message_preview": {
      "type": "string",
      "maxLength": 120
    },
    "cx_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "cx_status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "NO_ANSWER",
        "LOW_CONFIDENCE",
        "PARTIAL",
        "FAILED"
      ]
    },
    "generation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alias",
            "provider_capability",
            "mo_generation_id",
            "finish_reason",
            "output_preview",
            "usage"
          ],
          "properties": {
            "alias": {
              "type": "string"
            },
            "provider_capability": {
              "type": "string",
              "enum": [
                "generation"
              ]
            },
            "mo_generation_id": {
              "type": "string"
            },
            "finish_reason": {
              "type": "string"
            },
            "output_preview": {
              "type": "string",
              "maxLength": 120
            },
            "usage": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "$ref": "#/$defs/generationQualityRejectionFailure"
    },
    "retrieval": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cx_retrieval_package_id",
            "cx_package_hash",
            "cx_status",
            "evidence_count",
            "best_score",
            "confidence_bucket",
            "no_answer_reason",
            "warnings",
            "quality_warnings"
          ],
          "properties": {
            "cx_retrieval_package_id": {
              "type": "string",
              "minLength": 1
            },
            "cx_package_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "cx_status": {
              "type": "string",
              "enum": [
                "READY",
                "NO_ANSWER",
                "LOW_CONFIDENCE",
                "PARTIAL",
                "FAILED"
              ]
            },
            "evidence_count": {
              "type": "integer",
              "minimum": 0
            },
            "best_score": {
              "type": "number",
              "minimum": 0
            },
            "confidence_bucket": {
              "type": "string"
            },
            "no_answer_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "quality_warnings": {
              "$ref": "#/$defs/retrievalQualityWarnings"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "renderFormat": {
      "type": "string",
      "enum": [
        "MD",
        "HTML_PREVIEW",
        "DOCX",
        "PDF"
      ]
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_status",
        "citation_count",
        "validation_error_count",
        "warning_count",
        "grounding_required",
        "retrieval_package_id",
        "retrieval_package_hash",
        "evidence_ref_count"
      ],
      "properties": {
        "citation_status": {
          "type": "string",
          "enum": [
            "VALIDATED"
          ]
        },
        "citation_count": {
          "type": "integer",
          "minimum": 0
        },
        "validation_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "grounding_required": {
          "type": "boolean"
        },
        "retrieval_package_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "retrieval_package_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_ref_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "retrievalQualityWarnings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_schema_version",
        "warning_count",
        "warning_kinds",
        "quality_flag_count",
        "quality_flag_kinds",
        "low_confidence_threshold",
        "best_score_below_threshold",
        "status_caveat_required",
        "recommended_action",
        "raw_warning_details_included"
      ],
      "properties": {
        "contract_schema_version": {
          "const": "ae_chat_retrieval_quality_warning.v1"
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quality_flag_count": {
          "type": "integer",
          "minimum": 0
        },
        "quality_flag_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "low_confidence_threshold": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "best_score_below_threshold": {
          "type": "boolean"
        },
        "status_caveat_required": {
          "type": "boolean"
        },
        "recommended_action": {
          "type": "string",
          "enum": [
            "proceed",
            "proceed_with_caveat",
            "ask_confirmation",
            "show_no_answer",
            "show_error"
          ]
        },
        "raw_warning_details_included": {
          "const": false
        }
      }
    },
    "generationQualityRejectionFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_schema_version",
        "error_code",
        "failed_stage",
        "owner_service",
        "retryable",
        "retrieval_quality_recommended_action",
        "recommended_action",
        "raw_error_detail_included"
      ],
      "properties": {
        "failure_schema_version": {
          "const": "ae_chat_generation_quality_rejection.v1"
        },
        "error_code": {
          "type": "string",
          "enum": [
            "cx.retrieval_package_not_ready",
            "cx.retrieval_package_quality_blocked"
          ]
        },
        "failed_stage": {
          "type": "string",
          "enum": [
            "retrieval_package_status",
            "retrieval_package_quality",
            "generation_quality_rejection"
          ]
        },
        "owner_service": {
          "const": "nex-cx"
        },
        "retryable": {
          "type": "boolean"
        },
        "retrieval_quality_recommended_action": {
          "$ref": "#/$defs/retrievalQualityRecommendedAction"
        },
        "recommended_action": {
          "$ref": "#/$defs/retrievalQualityRecommendedAction"
        },
        "raw_error_detail_included": {
          "const": false
        }
      }
    },
    "retrievalQualityRecommendedAction": {
      "type": "string",
      "enum": [
        "proceed",
        "proceed_with_caveat",
        "ask_confirmation",
        "show_no_answer",
        "show_error"
      ]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_version_id",
        "display_title",
        "artifact_type",
        "artifact_status",
        "primary_format",
        "available_formats",
        "preview_route",
        "download_routes",
        "source_generation_id",
        "source_content_hash",
        "quality_summary",
        "actions"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version_id": {
          "type": "string",
          "minLength": 1
        },
        "display_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "generated_document",
            "summary",
            "answer_export"
          ]
        },
        "artifact_status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "RENDERING",
            "READY",
            "FAILED",
            "ARCHIVED",
            "DELETED"
          ]
        },
        "primary_format": {
          "$ref": "#/$defs/renderFormat"
        },
        "available_formats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/renderFormat"
          }
        },
        "preview_route": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^/api/v1/"
        },
        "download_routes": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "MD",
              "HTML_PREVIEW",
              "DOCX",
              "PDF"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^/api/v1/"
          }
        },
        "source_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "source_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quality_summary": {
          "$ref": "#/$defs/qualitySummary"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "preview",
              "download_md",
              "download_html_preview",
              "download_docx",
              "download_pdf",
              "view_sources",
              "view_lineage",
              "retry_render"
            ]
          }
        }
      }
    }
  }
}
