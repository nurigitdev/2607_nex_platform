{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/chat_interaction.v1.schema.json",
  "title": "NeX AE Chat Interaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interaction_schema_version",
    "interaction_id",
    "chat_document_id",
    "status",
    "trace_id",
    "request_id",
    "user_message_hash",
    "user_message_preview",
    "cx_generation_id",
    "cx_status",
    "generation",
    "retrieval",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "interaction_schema_version": {
      "const": "ae_chat_interaction.v1"
    },
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "chat_document_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "NO_ANSWER",
        "FAILED"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "user_message_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "user_message_preview": {
      "type": "string",
      "maxLength": 120
    },
    "cx_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "cx_status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "NO_ANSWER",
        "LOW_CONFIDENCE",
        "PARTIAL",
        "FAILED"
      ]
    },
    "generation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alias",
            "provider_capability",
            "mo_generation_id",
            "finish_reason",
            "output_preview",
            "usage"
          ],
          "properties": {
            "alias": {
              "type": "string"
            },
            "provider_capability": {
              "type": "string",
              "enum": [
                "generation"
              ]
            },
            "mo_generation_id": {
              "type": "string"
            },
            "finish_reason": {
              "type": "string"
            },
            "output_preview": {
              "type": "string",
              "maxLength": 120
            },
            "usage": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieval": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cx_retrieval_package_id",
            "cx_package_hash",
            "cx_status",
            "evidence_count",
            "best_score",
            "confidence_bucket",
            "no_answer_reason",
            "warnings"
          ],
          "properties": {
            "cx_retrieval_package_id": {
              "type": "string",
              "minLength": 1
            },
            "cx_package_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "cx_status": {
              "type": "string",
              "enum": [
                "READY",
                "NO_ANSWER",
                "LOW_CONFIDENCE",
                "PARTIAL",
                "FAILED"
              ]
            },
            "evidence_count": {
              "type": "integer",
              "minimum": 0
            },
            "best_score": {
              "type": "number",
              "minimum": 0
            },
            "confidence_bucket": {
              "type": "string"
            },
            "no_answer_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
