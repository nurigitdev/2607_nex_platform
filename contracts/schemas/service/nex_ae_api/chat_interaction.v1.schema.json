{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/chat_interaction.v1.schema.json",
  "title": "NeX AE Chat Interaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interaction_schema_version",
    "interaction_id",
    "workspace_id",
    "chat_document_id",
    "tenant_id",
    "user_id",
    "owner_user_id",
    "status",
    "trace_id",
    "request_id",
    "user_message_hash",
    "user_message_preview",
    "cx_generation_id",
    "cx_status",
    "generation",
    "retrieval",
    "artifact_refs",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "interaction_schema_version": {
      "const": "ae_chat_interaction.v1"
    },
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "chat_document_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_user_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "COMPLETED",
        "NO_ANSWER",
        "FAILED"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "user_message_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "user_message_preview": {
      "type": "string",
      "maxLength": 120
    },
    "cx_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "cx_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "COMPLETED",
        "NO_ANSWER",
        "LOW_CONFIDENCE",
        "PARTIAL",
        "FAILED"
      ]
    },
    "generation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alias",
            "provider_capability",
            "mo_generation_id",
            "finish_reason",
            "output_preview",
            "usage",
            "grounded_response_quality"
          ],
          "properties": {
            "alias": {
              "type": "string"
            },
            "provider_capability": {
              "type": "string",
              "enum": [
                "generation"
              ]
            },
            "mo_generation_id": {
              "type": "string"
            },
            "finish_reason": {
              "type": "string"
            },
            "output_preview": {
              "type": "string",
              "maxLength": 120
            },
            "usage": {
              "type": "object",
              "additionalProperties": true
            },
            "grounded_response_quality": {
              "$ref": "#/$defs/groundedResponseQuality"
            },
            "policy": {
              "$ref": "#/$defs/runtimePolicySummary"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "$ref": "#/$defs/runtimePolicySummary"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/generationQualityRejectionFailure"
        },
        {
          "$ref": "#/$defs/chatExecutionFailure"
        }
      ]
    },
    "retrieval": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cx_retrieval_package_id",
            "cx_package_hash",
            "cx_status",
            "evidence_count",
            "best_score",
            "confidence_bucket",
            "no_answer_reason",
            "warnings",
            "quality_warnings"
          ],
          "properties": {
            "cx_retrieval_package_id": {
              "type": "string",
              "minLength": 1
            },
            "cx_package_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "cx_status": {
              "type": "string",
              "enum": [
                "READY",
                "NO_ANSWER",
                "LOW_CONFIDENCE",
                "PARTIAL",
                "FAILED"
              ]
            },
            "evidence_count": {
              "type": "integer",
              "minimum": 0
            },
            "best_score": {
              "type": "number",
              "minimum": 0
            },
            "confidence_bucket": {
              "type": "string"
            },
            "no_answer_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "quality_warnings": {
              "$ref": "#/$defs/retrievalQualityWarnings"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "runtimePolicySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_summary_schema_version",
        "runtime_policy_snapshot",
        "prompt_binding",
        "prompt_render_event_ref",
        "generation_policy_package",
        "raw_prompt_included",
        "provider_runtime_included"
      ],
      "properties": {
        "policy_summary_schema_version": {
          "const": "ae_chat_runtime_policy_summary.v1"
        },
        "runtime_policy_snapshot": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "runtime_policy_schema_version",
            "intent_decision",
            "compatibility_rule",
            "prompt_contract_ref",
            "policy_snapshot_hash",
            "raw_prompt_included",
            "provider_runtime_included"
          ],
          "properties": {
            "runtime_policy_schema_version": {
              "const": "ae_runtime_policy.v1"
            },
            "intent_decision": {
              "type": "object"
            },
            "compatibility_rule": {
              "type": "object"
            },
            "prompt_contract_ref": {
              "type": "object"
            },
            "policy_snapshot_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "raw_prompt_included": {
              "const": false
            },
            "provider_runtime_included": {
              "const": false
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "raw_prompt"
                ]
              },
              {
                "required": [
                  "api_key"
                ]
              },
              {
                "required": [
                  "provider_url"
                ]
              }
            ]
          }
        },
        "prompt_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_binding_projection_schema_version",
            "prompt_binding_id",
            "binding_key",
            "prompt_template_version_id",
            "service_id",
            "purpose",
            "status",
            "prompt_version",
            "role",
            "segment_order",
            "content_sha256",
            "model_capability",
            "content_included"
          ],
          "properties": {
            "prompt_binding_projection_schema_version": {
              "const": "ae_prompt_binding_projection.v1"
            },
            "prompt_binding_id": {
              "type": "string",
              "minLength": 1
            },
            "binding_key": {
              "type": "string",
              "minLength": 1
            },
            "prompt_template_version_id": {
              "type": "string",
              "minLength": 1
            },
            "service_id": {
              "const": "nex-ae-api"
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "ACTIVE"
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "const": "system"
            },
            "segment_order": {
              "type": "integer",
              "minimum": 0
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "model_capability": {
              "const": "generation"
            },
            "content_included": {
              "const": false
            }
          }
        },
        "prompt_render_event_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_render_event_id",
            "rendered_prompt_hash",
            "user_prompt_hash"
          ],
          "properties": {
            "prompt_render_event_id": {
              "type": "string",
              "minLength": 1
            },
            "rendered_prompt_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "user_prompt_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "generation_policy_package": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "generation_policy_package_schema_version",
                "prompt_contract_ref",
                "user_message_hash",
                "policy_snapshot_hash",
                "privacy",
                "client_package_hash"
              ],
              "properties": {
                "generation_policy_package_schema_version": {
                  "const": "ae_generation_policy_package.v1"
                },
                "prompt_contract_ref": {
                  "type": "object"
                },
                "user_message_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "policy_snapshot_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "privacy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "raw_user_prompt_included",
                    "raw_evidence_included",
                    "provider_runtime_included",
                    "raw_token_included"
                  ],
                  "properties": {
                    "raw_user_prompt_included": {
                      "const": false
                    },
                    "raw_evidence_included": {
                      "const": false
                    },
                    "provider_runtime_included": {
                      "const": false
                    },
                    "raw_token_included": {
                      "const": false
                    }
                  }
                },
                "client_package_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "raw_prompt"
                    ]
                  },
                  {
                    "required": [
                      "evidence_text"
                    ]
                  },
                  {
                    "required": [
                      "api_key"
                    ]
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_prompt_included": {
          "const": false
        },
        "provider_runtime_included": {
          "const": false
        }
      }
    },
    "renderFormat": {
      "type": "string",
      "enum": [
        "MD",
        "HTML_PREVIEW",
        "DOCX",
        "PDF"
      ]
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_status",
        "citation_count",
        "validation_error_count",
        "warning_count",
        "grounding_required",
        "retrieval_package_id",
        "retrieval_package_hash",
        "evidence_ref_count"
      ],
      "properties": {
        "citation_status": {
          "type": "string",
          "enum": [
            "VALIDATED"
          ]
        },
        "citation_count": {
          "type": "integer",
          "minimum": 0
        },
        "validation_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "grounding_required": {
          "type": "boolean"
        },
        "retrieval_package_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "retrieval_package_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_ref_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "groundedResponseQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_schema_version",
        "source_audit_schema_version",
        "boundary_status",
        "citation_status",
        "issue_count",
        "recommended_action",
        "grounding_required",
        "retrieval_package_id",
        "retrieval_package_hash",
        "structured_draft_id",
        "raw_output_included",
        "evidence_text_included",
        "prompt_text_included",
        "provider_detail_included"
      ],
      "properties": {
        "contract_schema_version": {
          "const": "ae_chat_grounded_response_quality.v1"
        },
        "source_audit_schema_version": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "cx_grounded_response_citation_quality_audit.v1",
            null
          ]
        },
        "boundary_status": {
          "type": "string",
          "enum": [
            "PASS",
            "WARN",
            "FAIL",
            "NOT_REQUIRED",
            "UNKNOWN"
          ]
        },
        "citation_status": {
          "type": "string",
          "enum": [
            "VALIDATED",
            "INVALID",
            "NOT_REQUIRED",
            "UNKNOWN"
          ]
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "recommended_action": {
          "type": "string",
          "enum": [
            "proceed",
            "proceed_with_caveat",
            "show_error"
          ]
        },
        "grounding_required": {
          "type": "boolean"
        },
        "retrieval_package_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "retrieval_package_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "structured_draft_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "raw_output_included": {
          "const": false
        },
        "evidence_text_included": {
          "const": false
        },
        "prompt_text_included": {
          "const": false
        },
        "provider_detail_included": {
          "const": false
        }
      }
    },
    "retrievalQualityWarnings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_schema_version",
        "warning_count",
        "warning_kinds",
        "quality_flag_count",
        "quality_flag_kinds",
        "low_confidence_threshold",
        "best_score_below_threshold",
        "status_caveat_required",
        "recommended_action",
        "raw_warning_details_included"
      ],
      "properties": {
        "contract_schema_version": {
          "const": "ae_chat_retrieval_quality_warning.v1"
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quality_flag_count": {
          "type": "integer",
          "minimum": 0
        },
        "quality_flag_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "low_confidence_threshold": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "best_score_below_threshold": {
          "type": "boolean"
        },
        "status_caveat_required": {
          "type": "boolean"
        },
        "recommended_action": {
          "type": "string",
          "enum": [
            "proceed",
            "proceed_with_caveat",
            "ask_confirmation",
            "show_no_answer",
            "show_error"
          ]
        },
        "raw_warning_details_included": {
          "const": false
        }
      }
    },
    "generationQualityRejectionFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_schema_version",
        "error_code",
        "failed_stage",
        "owner_service",
        "retryable",
        "retrieval_quality_recommended_action",
        "recommended_action",
        "raw_error_detail_included"
      ],
      "properties": {
        "failure_schema_version": {
          "const": "ae_chat_generation_quality_rejection.v1"
        },
        "error_code": {
          "type": "string",
          "enum": [
            "cx.retrieval_package_not_ready",
            "cx.retrieval_package_quality_blocked"
          ]
        },
        "failed_stage": {
          "type": "string",
          "enum": [
            "retrieval_package_status",
            "retrieval_package_quality",
            "generation_quality_rejection"
          ]
        },
        "owner_service": {
          "const": "nex-cx"
        },
        "retryable": {
          "type": "boolean"
        },
        "retrieval_quality_recommended_action": {
          "$ref": "#/$defs/retrievalQualityRecommendedAction"
        },
        "recommended_action": {
          "$ref": "#/$defs/retrievalQualityRecommendedAction"
        },
        "raw_error_detail_included": {
          "const": false
        }
      }
    },
    "chatExecutionFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_schema_version",
        "error_code",
        "failed_stage",
        "retryable",
        "raw_error_detail_included"
      ],
      "properties": {
        "failure_schema_version": {
          "const": "ae_chat_execution_failure.v1"
        },
        "error_code": {
          "type": "string",
          "minLength": 1
        },
        "failed_stage": {
          "const": "workspace_chat_orchestration"
        },
        "retryable": {
          "type": "boolean"
        },
        "raw_error_detail_included": {
          "const": false
        }
      }
    },
    "retrievalQualityRecommendedAction": {
      "type": "string",
      "enum": [
        "proceed",
        "proceed_with_caveat",
        "ask_confirmation",
        "show_no_answer",
        "show_error"
      ]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_version_id",
        "display_title",
        "artifact_type",
        "artifact_status",
        "primary_format",
        "available_formats",
        "preview_route",
        "download_routes",
        "source_generation_id",
        "source_content_hash",
        "quality_summary",
        "actions"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version_id": {
          "type": "string",
          "minLength": 1
        },
        "display_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "generated_document",
            "summary",
            "answer_export"
          ]
        },
        "artifact_status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "RENDERING",
            "READY",
            "FAILED",
            "ARCHIVED",
            "DELETED"
          ]
        },
        "primary_format": {
          "$ref": "#/$defs/renderFormat"
        },
        "available_formats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/renderFormat"
          }
        },
        "preview_route": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^/api/v1/"
        },
        "download_routes": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "MD",
              "HTML_PREVIEW",
              "DOCX",
              "PDF"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^/api/v1/"
          }
        },
        "source_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "source_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quality_summary": {
          "$ref": "#/$defs/qualitySummary"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "preview",
              "download_md",
              "download_html_preview",
              "download_docx",
              "download_pdf",
              "view_sources",
              "view_lineage",
              "retry_render"
            ]
          }
        }
      }
    }
  }
}
