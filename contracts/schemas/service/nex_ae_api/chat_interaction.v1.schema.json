{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/chat_interaction.v1.schema.json",
  "title": "NeX AE Chat Interaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interaction_schema_version",
    "interaction_id",
    "workspace_id",
    "chat_document_id",
    "tenant_id",
    "user_id",
    "owner_user_id",
    "status",
    "trace_id",
    "request_id",
    "user_message_hash",
    "user_message_preview",
    "cx_generation_id",
    "cx_status",
    "generation",
    "retrieval",
    "artifact_refs",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "interaction_schema_version": {
      "const": "ae_chat_interaction.v1"
    },
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "chat_document_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_user_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "COMPLETED",
        "NO_ANSWER",
        "FAILED"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "user_message_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "user_message_preview": {
      "type": "string",
      "maxLength": 120
    },
    "cx_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "cx_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "COMPLETED",
        "NO_ANSWER",
        "LOW_CONFIDENCE",
        "PARTIAL",
        "FAILED",
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "CANCELLED"
      ]
    },
    "generation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "async_generation"
          ],
          "properties": {
            "policy": {
              "$ref": "#/$defs/runtimePolicySummary"
            },
            "async_generation": {
              "$ref": "#/$defs/asyncGeneration"
            },
            "citation_workflow": {
              "$ref": "#/$defs/citationQualityWorkflow"
            },
            "retry_lineage": {
              "$ref": "#/$defs/asyncRetryLineage"
            },
            "generated_response": {
              "$ref": "#/$defs/generatedResponseLineage"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alias",
            "provider_capability",
            "mo_generation_id",
            "finish_reason",
            "output_preview",
            "usage",
            "grounded_response_quality"
          ],
          "properties": {
            "alias": {
              "type": "string"
            },
            "provider_capability": {
              "type": "string",
              "enum": [
                "generation"
              ]
            },
            "mo_generation_id": {
              "type": "string"
            },
            "finish_reason": {
              "type": "string"
            },
            "output_preview": {
              "type": "string",
              "maxLength": 120
            },
            "usage": {
              "type": "object",
              "additionalProperties": true
            },
            "grounded_response_quality": {
              "$ref": "#/$defs/groundedResponseQuality"
            },
            "policy": {
              "$ref": "#/$defs/runtimePolicySummary"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "$ref": "#/$defs/runtimePolicySummary"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/generationQualityRejectionFailure"
        },
        {
          "$ref": "#/$defs/chatExecutionFailure"
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieval": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cx_retrieval_package_id",
            "cx_package_hash",
            "cx_status",
            "evidence_count",
            "best_score",
            "confidence_bucket",
            "no_answer_reason",
            "warnings",
            "quality_warnings"
          ],
          "properties": {
            "cx_retrieval_package_id": {
              "type": "string",
              "minLength": 1
            },
            "cx_package_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "cx_status": {
              "type": "string",
              "enum": [
                "READY",
                "NO_ANSWER",
                "LOW_CONFIDENCE",
                "PARTIAL",
                "FAILED"
              ]
            },
            "evidence_count": {
              "type": "integer",
              "minimum": 0
            },
            "best_score": {
              "type": "number",
              "minimum": 0
            },
            "confidence_bucket": {
              "type": "string"
            },
            "no_answer_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "quality_warnings": {
              "$ref": "#/$defs/retrievalQualityWarnings"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "asyncGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "async_generation_schema_version",
        "execution_strategy",
        "lifecycle_status",
        "admission_status",
        "job_id",
        "cx_generation_id",
        "cx_job_status",
        "attempt_count",
        "max_attempts",
        "retryable",
        "handoff_status",
        "next_action",
        "error",
        "links",
        "owner_scope_enforced",
        "content_included"
      ],
      "properties": {
        "async_generation_schema_version": {
          "const": "ae_async_generation.v1"
        },
        "execution_strategy": {
          "const": "ASYNCHRONOUS"
        },
        "lifecycle_status": {
          "enum": ["PENDING", "COMPLETED", "BLOCKED"]
        },
        "admission_status": {
          "enum": ["ENQUEUED", "JOINED", "REPLAYED"]
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "cx_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "cx_job_status": {
          "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "handoff_status": {
          "enum": ["PENDING", "READY", "BLOCKED", null]
        },
        "next_action": {
          "enum": [
            "POLL_GENERATION_HANDOFF",
            "PRESENT_GENERATION_TO_OWNER",
            "RETRY_OR_REVIEW_GENERATION"
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["error_code", "retryable", "dead_lettered"],
              "properties": {
                "error_code": {"type": "string", "minLength": 1},
                "retryable": {"type": "boolean"},
                "dead_lettered": {"type": "boolean"}
              }
            },
            {"type": "null"}
          ]
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "generation": {"type": "string", "pattern": "^/api/v1/"},
            "async_job": {"type": "string", "pattern": "^/api/v1/"}
          }
        },
        "owner_scope_enforced": {
          "const": true
        },
        "content_included": {
          "const": false
        }
      }
    },
    "citationQualityWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_schema_version",
        "interaction_id",
        "cx_generation_id",
        "workflow_status",
        "next_action",
        "quality",
        "repair",
        "operator_remediation",
        "owner_scope_enforced",
        "content_included"
      ],
      "properties": {
        "workflow_schema_version": {"const": "ae_citation_quality_workflow.v1"},
        "interaction_id": {"type": "string", "minLength": 1},
        "cx_generation_id": {"type": "string", "minLength": 1},
        "workflow_status": {
          "enum": ["NOT_REQUIRED", "VALIDATED", "REPAIRED", "ATTENTION_REQUIRED"]
        },
        "next_action": {
          "enum": [
            "PRESENT_RESPONSE",
            "PRESENT_REPAIRED_RESPONSE",
            "RETRY_OR_REVIEW_GENERATION"
          ]
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_schema_version",
            "source_audit_schema_version",
            "boundary_status",
            "citation_status",
            "issue_count",
            "recommended_action",
            "grounding_required",
            "retrieval_package_id",
            "retrieval_package_hash",
            "structured_draft_id",
            "raw_output_included",
            "evidence_text_included",
            "prompt_text_included",
            "provider_detail_included"
          ],
          "properties": {
            "contract_schema_version": {"const": "ae_chat_grounded_response_quality.v1"},
            "source_audit_schema_version": {"type": ["string", "null"]},
            "boundary_status": {"enum": ["PASS", "WARN", "FAIL", "NOT_REQUIRED", "UNKNOWN"]},
            "citation_status": {"enum": ["VALIDATED", "INVALID", "NOT_REQUIRED", "UNKNOWN"]},
            "issue_count": {"type": "integer", "minimum": 0},
            "recommended_action": {"enum": ["proceed", "proceed_with_caveat", "show_error"]},
            "grounding_required": {"type": "boolean"},
            "retrieval_package_id": {"type": ["string", "null"]},
            "retrieval_package_hash": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{64}$"
            },
            "structured_draft_id": {"type": ["string", "null"]},
            "raw_output_included": {"const": false},
            "evidence_text_included": {"const": false},
            "prompt_text_included": {"const": false},
            "provider_detail_included": {"const": false}
          }
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_projection_present",
            "repair_schema_version",
            "mode",
            "status",
            "attempted",
            "attempt_count",
            "max_attempts",
            "trigger_error_code",
            "same_retrieval_package",
            "original_provider_prompt_package_hash",
            "effective_provider_prompt_package_hash",
            "invalid_output_included"
          ],
          "properties": {
            "source_projection_present": {"type": "boolean"},
            "repair_schema_version": {"enum": ["cx_citation_repair.v1", null]},
            "mode": {"enum": ["NONE", "BOUNDED_INLINE"]},
            "status": {"enum": ["NOT_ATTEMPTED", "SUCCEEDED", "ATTENTION_REQUIRED"]},
            "attempted": {"type": "boolean"},
            "attempt_count": {"type": "integer", "minimum": 0, "maximum": 1},
            "max_attempts": {"const": 1},
            "trigger_error_code": {
              "enum": ["cx.citation_required_missing", "cx.citation_validation_failed", null]
            },
            "same_retrieval_package": {"type": ["boolean", "null"]},
            "original_provider_prompt_package_hash": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{64}$"
            },
            "effective_provider_prompt_package_hash": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{64}$"
            },
            "invalid_output_included": {"const": false}
          }
        },
        "operator_remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "required", "handoff_included"],
          "properties": {
            "mode": {"const": "SEPARATE_HANDOFF"},
            "required": {"type": "boolean"},
            "handoff_included": {"const": false}
          }
        },
        "owner_scope_enforced": {"const": true},
        "content_included": {"const": false}
      }
    },
    "asyncRetryLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retry_lineage_schema_version",
        "parent_interaction_id",
        "parent_job_id",
        "parent_cx_generation_id",
        "raw_input_included"
      ],
      "properties": {
        "retry_lineage_schema_version": {
          "const": "ae_async_generation_retry_lineage.v1"
        },
        "parent_interaction_id": {"type": "string", "minLength": 1},
        "parent_job_id": {"type": "string", "minLength": 1},
        "parent_cx_generation_id": {"type": "string", "minLength": 1},
        "parent_response_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "raw_input_included": {"const": false}
      }
    },
    "generatedResponseLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_schema_version",
        "response_id",
        "lineage_type",
        "interaction_id",
        "chat_document_id",
        "cx_generation_id",
        "cx_job_id",
        "content_type",
        "content_sha256",
        "size_bytes",
        "content_available",
        "retrieval_package_id",
        "retrieval_package_hash",
        "structured_draft_id",
        "citation_workflow_status",
        "bounded_repair_applied",
        "parent_interaction_id",
        "parent_response_id",
        "owner_scope_enforced",
        "raw_content_included",
        "storage_ref_included"
      ],
      "properties": {
        "lineage_schema_version": {"const": "ae_generated_response_lineage.v1"},
        "response_id": {"type": "string", "minLength": 1},
        "lineage_type": {"enum": ["ORIGINAL", "RETRY_CHILD"]},
        "interaction_id": {"type": "string", "minLength": 1},
        "chat_document_id": {"type": "string", "minLength": 1},
        "cx_generation_id": {"type": "string", "minLength": 1},
        "cx_job_id": {"type": "string", "minLength": 1},
        "content_type": {"type": "string", "pattern": "^text/", "maxLength": 120},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "content_available": {"const": true},
        "retrieval_package_id": {"type": ["string", "null"], "minLength": 1},
        "retrieval_package_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "structured_draft_id": {"type": ["string", "null"], "minLength": 1},
        "citation_workflow_status": {
          "enum": ["NOT_REQUIRED", "VALIDATED", "REPAIRED", "ATTENTION_REQUIRED"]
        },
        "bounded_repair_applied": {"type": "boolean"},
        "parent_interaction_id": {"type": ["string", "null"], "minLength": 1},
        "parent_response_id": {"type": ["string", "null"], "minLength": 1},
        "owner_scope_enforced": {"const": true},
        "raw_content_included": {"const": false},
        "storage_ref_included": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"lineage_type": {"const": "ORIGINAL"}}},
          "then": {
            "properties": {
              "parent_interaction_id": {"const": null},
              "parent_response_id": {"const": null}
            }
          },
          "else": {
            "properties": {
              "parent_interaction_id": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"citation_workflow_status": {"const": "REPAIRED"}}
          },
          "then": {"properties": {"bounded_repair_applied": {"const": true}}},
          "else": {"properties": {"bounded_repair_applied": {"const": false}}}
        }
      ]
    },
    "runtimePolicySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_summary_schema_version",
        "runtime_policy_snapshot",
        "prompt_binding",
        "prompt_render_event_ref",
        "generation_policy_package",
        "raw_prompt_included",
        "provider_runtime_included"
      ],
      "properties": {
        "policy_summary_schema_version": {
          "const": "ae_chat_runtime_policy_summary.v1"
        },
        "runtime_policy_snapshot": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "runtime_policy_schema_version",
            "intent_decision",
            "compatibility_rule",
            "prompt_contract_ref",
            "policy_snapshot_hash",
            "raw_prompt_included",
            "provider_runtime_included"
          ],
          "properties": {
            "runtime_policy_schema_version": {
              "const": "ae_runtime_policy.v1"
            },
            "intent_decision": {
              "type": "object"
            },
            "compatibility_rule": {
              "type": "object"
            },
            "prompt_contract_ref": {
              "type": "object"
            },
            "policy_snapshot_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "raw_prompt_included": {
              "const": false
            },
            "provider_runtime_included": {
              "const": false
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "raw_prompt"
                ]
              },
              {
                "required": [
                  "api_key"
                ]
              },
              {
                "required": [
                  "provider_url"
                ]
              }
            ]
          }
        },
        "prompt_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_binding_projection_schema_version",
            "prompt_binding_id",
            "binding_key",
            "prompt_template_version_id",
            "service_id",
            "purpose",
            "status",
            "prompt_version",
            "role",
            "segment_order",
            "content_sha256",
            "model_capability",
            "content_included"
          ],
          "properties": {
            "prompt_binding_projection_schema_version": {
              "const": "ae_prompt_binding_projection.v1"
            },
            "prompt_binding_id": {
              "type": "string",
              "minLength": 1
            },
            "binding_key": {
              "type": "string",
              "minLength": 1
            },
            "prompt_template_version_id": {
              "type": "string",
              "minLength": 1
            },
            "service_id": {
              "const": "nex-ae-api"
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "ACTIVE"
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "const": "system"
            },
            "segment_order": {
              "type": "integer",
              "minimum": 0
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "model_capability": {
              "const": "generation"
            },
            "content_included": {
              "const": false
            }
          }
        },
        "prompt_render_event_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_render_event_id",
            "rendered_prompt_hash",
            "user_prompt_hash"
          ],
          "properties": {
            "prompt_render_event_id": {
              "type": "string",
              "minLength": 1
            },
            "rendered_prompt_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "user_prompt_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "generation_policy_package": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "generation_policy_package_schema_version",
                "prompt_contract_ref",
                "user_message_hash",
                "policy_snapshot_hash",
                "privacy",
                "client_package_hash"
              ],
              "properties": {
                "generation_policy_package_schema_version": {
                  "const": "ae_generation_policy_package.v1"
                },
                "prompt_contract_ref": {
                  "type": "object"
                },
                "user_message_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "policy_snapshot_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "privacy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "raw_user_prompt_included",
                    "raw_evidence_included",
                    "provider_runtime_included",
                    "raw_token_included"
                  ],
                  "properties": {
                    "raw_user_prompt_included": {
                      "const": false
                    },
                    "raw_evidence_included": {
                      "const": false
                    },
                    "provider_runtime_included": {
                      "const": false
                    },
                    "raw_token_included": {
                      "const": false
                    }
                  }
                },
                "client_package_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "raw_prompt"
                    ]
                  },
                  {
                    "required": [
                      "evidence_text"
                    ]
                  },
                  {
                    "required": [
                      "api_key"
                    ]
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_prompt_included": {
          "const": false
        },
        "provider_runtime_included": {
          "const": false
        }
      }
    },
    "renderFormat": {
      "type": "string",
      "enum": [
        "MD",
        "HTML_PREVIEW",
        "DOCX",
        "PDF"
      ]
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_status",
        "citation_count",
        "validation_error_count",
        "warning_count",
        "grounding_required",
        "retrieval_package_id",
        "retrieval_package_hash",
        "evidence_ref_count"
      ],
      "properties": {
        "citation_status": {
          "type": "string",
          "enum": [
            "VALIDATED"
          ]
        },
        "citation_count": {
          "type": "integer",
          "minimum": 0
        },
        "validation_error_count": {
          "type": "integer",
          "minimum": 0
        },
