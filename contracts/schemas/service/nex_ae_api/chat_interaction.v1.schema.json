{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/chat_interaction.v1.schema.json",
  "title": "NeX AE Chat Interaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interaction_schema_version",
    "interaction_id",
    "chat_document_id",
    "status",
    "trace_id",
    "request_id",
    "user_message_hash",
    "user_message_preview",
    "cx_generation_id",
    "cx_status",
    "generation",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "interaction_schema_version": {
      "const": "ae_chat_interaction.v1"
    },
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "chat_document_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "FAILED"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "user_message_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "user_message_preview": {
      "type": "string",
      "maxLength": 120
    },
    "cx_generation_id": {
      "type": "string",
      "minLength": 1
    },
    "cx_status": {
      "type": "string"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "provider_capability",
        "mo_generation_id",
        "finish_reason",
        "output_preview",
        "usage"
      ],
      "properties": {
        "alias": {
          "type": "string"
        },
        "provider_capability": {
          "type": "string",
          "enum": [
            "generation"
          ]
        },
        "mo_generation_id": {
          "type": "string"
        },
        "finish_reason": {
          "type": "string"
        },
        "output_preview": {
          "type": "string",
          "maxLength": 120
        },
        "usage": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
