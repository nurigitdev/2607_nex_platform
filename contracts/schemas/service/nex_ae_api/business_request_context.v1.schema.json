{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/business_request_context.v1.schema.json",
  "title": "AE BusinessRequestContext v1",
  "description": "Hash-bound user business input. This contract is not business authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_kind",
    "source_prompt_ref",
    "company_selector",
    "document",
    "transaction",
    "requested_allocation",
    "candidate_provenance",
    "context_hash"
  ],
  "properties": {
    "schema_version": {"const": "ae.business_request_context.v1"},
    "request_kind": {"const": "FINANCE_VOUCHER_POSTING"},
    "source_prompt_ref": {
      "type": "string",
      "pattern": "^AE:INTERACTION:[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
      "maxLength": 175
    },
    "company_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["CODE", "NAME", "CODE_OR_NAME"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "primary_project_code": {
      "type": "string",
      "pattern": "^[A-Z0-9]{4}[DMSOIG][0-9]{6}$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "subject_ref",
        "subject_revision",
        "content_hash",
        "attachment_manifest_hash"
      ],
      "properties": {
        "document_type": {"const": "BUSINESS_PROPOSAL"},
        "subject_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "subject_revision": {"type": "integer", "minimum": 1},
        "content_hash": {"$ref": "#/$defs/hashRef"},
        "attachment_manifest_hash": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/hashRef"}
          ]
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counterparty_selector",
        "amount",
        "currency",
        "recognition_date",
        "description"
      ],
      "properties": {
        "counterparty_selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "amount": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
        },
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "recognition_date": {"type": "string", "format": "date"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "requested_allocation": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_code", "ratio"],
        "properties": {
          "project_code": {
            "type": "string",
            "pattern": "^[A-Z0-9]{4}[DMSOIG][0-9]{6}$"
          },
          "ratio": {
            "type": "string",
            "pattern": "^(?:0\\.[0-9]{6}|1\\.000000)$"
          }
        }
      }
    },
    "candidate_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_candidate_hash",
        "input_context_hash",
        "model_profile",
        "model_ref"
      ],
      "properties": {
        "intent_candidate_hash": {"$ref": "#/$defs/hashRef"},
        "input_context_hash": {"$ref": "#/$defs/hashRef"},
        "model_profile": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "model_ref": {
          "type": ["string", "null"],
          "maxLength": 256
        }
      }
    },
    "context_hash": {"$ref": "#/$defs/hashRef"}
  },
  "$defs": {
    "hashRef": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
