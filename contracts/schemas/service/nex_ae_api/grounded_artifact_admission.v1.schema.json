{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/grounded_artifact_admission.v1.schema.json",
  "title": "NeX AE Grounded Artifact Admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grounded_artifact_admission_schema_version",
    "artifact",
    "response_binding",
    "render_admission",
    "owner_scope_enforced",
    "content_included"
  ],
  "properties": {
    "grounded_artifact_admission_schema_version": {
      "const": "ae_grounded_artifact_admission.v1"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "artifact_schema_version",
        "artifact_id",
        "artifact_status",
        "chat_document_id",
        "interaction_id",
        "owner_actor_ref",
        "workspace_ref",
        "source_refs",
        "render_jobs"
      ],
      "properties": {
        "artifact_schema_version": {"const": "ae_artifact_record.v1"},
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_status": {"const": "RENDERING"},
        "chat_document_id": {"type": "string", "minLength": 1},
        "interaction_id": {"type": "string", "minLength": 1},
        "owner_actor_ref": {
          "type": "object",
          "required": ["actor_type", "actor_id", "tenant_id"],
          "properties": {
            "actor_type": {"const": "user"},
            "actor_id": {"type": "string", "minLength": 1},
            "tenant_id": {"type": "string", "minLength": 1}
          }
        },
        "workspace_ref": {
          "type": "object",
          "required": ["workspace_id", "tenant_id"],
          "properties": {
            "workspace_id": {"type": "string", "minLength": 1},
            "tenant_id": {"type": "string", "minLength": 1}
          }
        },
        "source_refs": {"type": "array", "minItems": 1},
        "render_jobs": {"type": "array", "minItems": 1}
      }
    },
    "response_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_binding_schema_version",
        "response_id",
        "interaction_id",
        "chat_document_id",
        "cx_generation_id",
        "structured_draft_id",
        "lineage_type",
        "citation_workflow_status",
        "owner_scope_enforced",
        "content_included"
      ],
      "properties": {
        "response_binding_schema_version": {
          "const": "ae_async_artifact_response_binding.v1"
        },
        "response_id": {"type": "string", "minLength": 1},
        "interaction_id": {"type": "string", "minLength": 1},
        "chat_document_id": {"type": "string", "minLength": 1},
        "cx_generation_id": {"type": "string", "minLength": 1},
        "structured_draft_id": {"type": "string", "minLength": 1},
        "lineage_type": {"enum": ["ORIGINAL", "RETRY_CHILD"]},
        "citation_workflow_status": {"const": "VALIDATED"},
        "owner_scope_enforced": {"const": true},
        "content_included": {"const": false}
      }
    },
    "render_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "render_admission_schema_version",
        "admission_status",
        "render",
        "owner_scope_enforced",
        "content_included"
      ],
      "properties": {
        "render_admission_schema_version": {
          "const": "ae_async_artifact_render_admission.v1"
        },
        "admission_status": {"enum": ["ENQUEUED", "JOINED", "RECOVERED"]},
        "render": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "render_projection_schema_version",
            "render_job_id",
            "artifact_id",
            "render_job_status",
            "queue_job_status",
            "owner_scope_enforced",
            "rendered_content_included"
          ],
          "properties": {
            "render_projection_schema_version": {
              "const": "ae_async_artifact_render_projection.v1"
            },
            "render_job_id": {"type": "string", "minLength": 1},
            "artifact_id": {"type": "string", "minLength": 1},
            "render_job_status": {
              "enum": ["QUEUED", "RUNNING", "COMPLETED", "FAILED", "CANCELLED"]
            },
            "queue_job_status": {
              "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]
            },
            "owner_scope_enforced": {"const": true},
            "rendered_content_included": {"const": false}
          }
        },
        "owner_scope_enforced": {"const": true},
        "content_included": {"const": false}
      }
    },
    "owner_scope_enforced": {"const": true},
    "content_included": {"const": false}
  }
}
