{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/interaction_execution_progress.v1.schema.json",
  "title": "NeX AE Interaction Execution Progress",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interaction_id", "workspace_id", "status", "terminal", "next_sequence", "events", "metadata"],
  "properties": {
    "schema_version": {"const": "ae_interaction_execution_progress.v1"},
    "interaction_id": {"type": "string", "format": "uuid"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "status": {
      "type": "string",
      "enum": ["IN_PROGRESS", "COMPLETED", "NO_ANSWER", "SUCCEEDED", "FAILED", "BLOCKED", "CANCELLED"]
    },
    "terminal": {"type": "boolean"},
    "next_sequence": {"type": "integer", "minimum": 0},
    "events": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/progressEvent"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_scoped", "ordered_projection", "raw_prompt_included", "private_payload_included", "debug_time_available"],
      "properties": {
        "owner_scoped": {"const": true},
        "ordered_projection": {"const": true},
        "raw_prompt_included": {"const": false},
        "private_payload_included": {"const": false},
        "debug_time_available": {"const": true}
      }
    }
  },
  "$defs": {
    "progressEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "sequence", "event_code", "state", "agent_type", "source_ref", "occurred_at", "terminal"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "sequence": {"type": "integer", "minimum": 1},
        "event_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,95}$"},
        "state": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,47}$"},
        "agent_type": {"type": ["string", "null"], "enum": ["IA", "CA", "PA", "EA", null]},
        "source_ref": {"type": ["string", "null"], "maxLength": 256},
        "occurred_at": {"type": "string", "format": "date-time"},
        "terminal": {"type": "boolean"}
      }
    }
  }
}
