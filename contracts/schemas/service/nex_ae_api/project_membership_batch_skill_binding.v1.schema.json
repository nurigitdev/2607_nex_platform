{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/project_membership_batch_skill_binding.v1.schema.json",
  "title": "NeX AE Project Membership Batch Skill Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "payload_hash",
    "capability_ref",
    "arguments",
    "approval_projection",
    "model_authority",
    "binding_hash"
  ],
  "properties": {
    "schema_version": {"const": "p8.project_membership_batch_skill_binding.v1"},
    "operation_id": {"const": "PROJECT.MEMBERSHIP.ADD_MANY"},
    "payload_hash": {"$ref": "#/$defs/hashRef"},
    "capability_ref": {"$ref": "#/$defs/capabilityRef"},
    "arguments": {"$ref": "#/$defs/governedPayload"},
    "approval_projection": {"$ref": "#/$defs/approvalProjection"},
    "model_authority": {"const": false},
    "binding_hash": {"$ref": "#/$defs/hashRef"}
  },
  "$defs": {
    "hashRef": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subjectIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "capabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "skill_id",
        "skill_version",
        "skill_semantic_hash",
        "source_sha256",
        "artifact_source_revision"
      ],
      "properties": {
        "capability_id": {"const": "PROJECT.MEMBERSHIP.ADD_MANY"},
        "skill_id": {"const": "PROJECT.MEMBERSHIP.ADD_MANY"},
        "skill_version": {"const": "1.0.0"},
        "skill_semantic_hash": {"$ref": "#/$defs/hashRef"},
        "source_sha256": {"$ref": "#/$defs/hashRef"},
        "artifact_source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "governedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "requester_subject_id",
        "project_id",
        "target_subject_ids",
        "member_role",
        "resolution_evidence_hash"
      ],
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "requester_subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "target_subject_ids": {"$ref": "#/$defs/subjectIds"},
        "member_role": {"enum": ["OWNER", "MANAGER", "MEMBER", "VIEWER"]},
        "resolution_evidence_hash": {"$ref": "#/$defs/hashRef"}
      }
    },
    "approvalProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "project_id",
        "target_subject_ids",
        "target_count",
        "rejected_count",
        "member_role",
        "resolution_evidence_hash",
        "payload_hash"
      ],
      "properties": {
        "operation_id": {"const": "PROJECT.MEMBERSHIP.ADD_MANY"},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "target_subject_ids": {"$ref": "#/$defs/subjectIds"},
        "target_count": {"type": "integer", "minimum": 1, "maximum": 50},
        "rejected_count": {"type": "integer", "minimum": 0, "maximum": 50},
        "member_role": {"enum": ["OWNER", "MANAGER", "MEMBER", "VIEWER"]},
        "resolution_evidence_hash": {"$ref": "#/$defs/hashRef"},
        "payload_hash": {"$ref": "#/$defs/hashRef"}
      }
    }
  }
}
