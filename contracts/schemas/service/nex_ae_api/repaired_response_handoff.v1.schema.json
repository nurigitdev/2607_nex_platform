{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/repaired_response_handoff.v1.schema.json",
  "title": "NeX AE Repaired Response Handoff",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {
    "not": {
      "enum": [
        "raw_prompt",
        "raw_generation_output",
        "raw_output",
        "raw_source_text",
        "source_text",
        "messages",
        "provider_endpoint",
        "provider_url",
        "model_path",
        "storage_path",
        "authorization",
        "access_token",
        "refresh_token",
        "api_key",
        "password",
        "secret"
      ]
    }
  },
  "required": [
    "handoff_schema_version",
    "repaired_response_handoff_id",
    "handoff_request_id",
    "handoff_status",
    "trace_id",
    "request_id",
    "tenant_id",
    "workspace_id",
    "owner_user_id",
    "chat_document_id",
    "interaction_id",
    "actor_claims_ref",
    "source",
    "repaired_response",
    "lineage",
    "user_surface",
    "links",
    "redaction_summary",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "handoff_schema_version": {
      "const": "ae_repaired_response_handoff.v1"
    },
    "repaired_response_handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "handoff_request_id": {
      "type": "string",
      "minLength": 1
    },
    "handoff_status": {
      "const": "READY_FOR_USER_REVIEW"
    },
    "trace_id": {
      "$ref": "#/$defs/traceId"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_user_id": {
      "type": "string",
      "minLength": 1
    },
    "chat_document_id": {
      "type": "string",
      "minLength": 1
    },
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_claims_ref": {
      "$ref": "#/$defs/actorClaimsRef"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "repaired_response": {
      "$ref": "#/$defs/repairedResponse"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "user_surface": {
      "$ref": "#/$defs/userSurface"
    },
    "links": {
      "$ref": "#/$defs/links"
    },
    "redaction_summary": {
      "$ref": "#/$defs/redactionSummary"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "traceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "hash64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actorClaimsRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id",
        "tenant_id"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "user",
            "service"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_service",
        "ref_type",
        "ref_id",
        "relation"
      ],
      "properties": {
        "source_service": {
          "const": "nex-cx"
        },
        "ref_type": {
          "const": "repair_execution"
        },
        "ref_id": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "const": "result_of"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_service",
        "detail_schema_version",
        "remediation_action_id",
        "parent_cx_generation_id",
        "root_cx_generation_id",
        "repair_cx_generation_id",
        "result_ref"
      ],
      "properties": {
        "source_service": {
          "const": "nex-cx"
        },
        "detail_schema_version": {
          "const": "cx_remediation_execution_detail.v1"
        },
        "remediation_action_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_cx_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "root_cx_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "repair_cx_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "result_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/resultRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "repairedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cx_generation_id",
        "status",
        "alias",
        "provider_capability",
        "mo_generation_id",
        "finish_reason",
        "output_hash",
        "output_preview",
        "usage",
        "quality_summary"
      ],
      "properties": {
        "cx_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "COMPLETED"
        },
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "provider_capability": {
          "const": "generation"
        },
        "mo_generation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "finish_reason": {
          "type": "string",
          "minLength": 1
        },
        "output_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash64"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_preview": {
          "type": "string",
          "maxLength": 120
        },
        "usage": {
          "type": "object",
          "additionalProperties": true
        },
        "quality_summary": {
          "$ref": "#/$defs/qualitySummary"
        }
      }
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grounding_required",
        "retrieval_package_id",
        "retrieval_package_hash",
        "structured_draft_id",
        "draft_validation_status",
        "grounded_response_quality_status",
        "grounded_response_quality_issue_count"
      ],
      "properties": {
        "grounding_required": {
          "type": "boolean"
        },
        "retrieval_package_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "retrieval_package_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash64"
            },
            {
              "type": "null"
            }
          ]
        },
        "structured_draft_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "draft_validation_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "VALIDATED",
            "FAILED",
            null
          ]
        },
        "grounded_response_quality_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "PASS",
            "WARN",
            "FAIL",
            "NOT_REQUIRED",
            "UNKNOWN",
            null
          ]
        },
        "grounded_response_quality_issue_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_lineage_schema_version",
        "lineage_status",
        "parent_cx_generation_id",
        "root_cx_generation_id",
        "repair_cx_generation_id",
        "remediation_action_id",
        "action_type",
        "lineage_type",
        "attempt_no",
        "parent_generation_mutated"
      ],
      "properties": {
        "source_lineage_schema_version": {
          "const": "cx_repaired_generation_lineage.v1"
        },
        "lineage_status": {
          "const": "LINKED"
        },
        "parent_cx_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "root_cx_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "repair_cx_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "remediation_action_id": {
          "type": "string",
          "minLength": 1
        },
        "action_type": {
          "type": "string",
          "enum": [
            "retry_generation",
            "retrieval_repair",
            "citation_repair"
          ]
        },
        "lineage_type": {
          "type": "string",
          "enum": [
            "retry",
            "fresh_retrieval_regenerate",
            "repair"
          ]
        },
        "attempt_no": {
          "type": "integer",
          "minimum": 1
        },
        "parent_generation_mutated": {
          "const": false
        }
      }
    },
    "userSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentation_mode",
        "default_action",
        "available_actions"
      ],
      "properties": {
        "presentation_mode": {
          "type": "string",
          "enum": [
            "side_by_side_review",
            "replace_answer_candidate",
            "append_revision_note"
          ]
        },
        "default_action": {
          "const": "review_repair"
        },
        "available_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "view_original",
              "view_repaired",
              "accept_repair",
              "keep_original",
              "view_lineage"
            ]
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff",
        "original_generation",
        "repaired_generation",
        "remediation_execution"
      ],
      "properties": {
        "handoff": {
          "type": "string",
          "minLength": 1
        },
        "original_generation": {
          "type": "string",
          "minLength": 1
        },
        "repaired_generation": {
          "type": "string",
          "minLength": 1
        },
        "remediation_execution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "redactionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_output_included",
        "raw_prompt_included",
        "raw_source_text_included",
        "evidence_text_included",
        "provider_detail_included",
        "storage_path_included",
        "free_text_storage"
      ],
      "properties": {
        "raw_output_included": {
          "const": false
        },
        "raw_prompt_included": {
          "const": false
        },
        "raw_source_text_included": {
          "const": false
        },
        "evidence_text_included": {
          "const": false
        },
        "provider_detail_included": {
          "const": false
        },
        "storage_path_included": {
          "const": false
        },
        "free_text_storage": {
          "const": "hash_and_short_preview_only"
        }
      }
    }
  }
}
