{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/generation_policy_package.v1.schema.json",
  "title": "NeX AE Generation Policy Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation_policy_package_schema_version",
    "execution_mode",
    "intent_decision_ref",
    "ownership_ref",
    "template_ref",
    "prompt_contract_ref",
    "output_contract",
    "generation_profile",
    "provider_capability",
    "generation_parameters",
    "quality_policy",
    "retrieval_package_ref",
    "selected_evidence_ids",
    "user_message_hash",
    "policy_snapshot_hash",
    "privacy",
    "client_package_hash"
  ],
  "properties": {
    "generation_policy_package_schema_version": {
      "const": "ae_generation_policy_package.v1"
    },
    "execution_mode": {
      "$ref": "#/$defs/executionMode"
    },
    "intent_decision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_hash",
        "intent_label",
        "task_category",
        "decision_source"
      ],
      "properties": {
        "decision_hash": {
          "$ref": "#/$defs/hash"
        },
        "intent_label": {
          "type": "string",
          "minLength": 1
        },
        "task_category": {
          "type": "string",
          "minLength": 1
        },
        "decision_source": {
          "type": "string",
          "enum": [
            "EXPLICIT",
            "DETERMINISTIC_FALLBACK"
          ]
        }
      }
    },
    "ownership_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_ref",
        "owner_subject_ref"
      ],
      "properties": {
        "tenant_ref": {
          "$ref": "#/$defs/tenantRef"
        },
        "owner_subject_ref": {
          "$ref": "#/$defs/ownerRef"
        }
      }
    },
    "template_ref": {
      "$ref": "#/$defs/templateRef"
    },
    "prompt_contract_ref": {
      "$ref": "#/$defs/promptContractRef"
    },
    "output_contract": {
      "$ref": "#/$defs/outputContract"
    },
    "generation_profile": {
      "type": "string",
      "minLength": 1
    },
    "provider_capability": {
      "const": "generation"
    },
    "generation_parameters": {
      "$ref": "#/$defs/generationParameters"
    },
    "quality_policy": {
      "$ref": "#/$defs/qualityPolicy"
    },
    "retrieval_package_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/retrievalPackageRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "user_message_hash": {
      "$ref": "#/$defs/hash"
    },
    "policy_snapshot_hash": {
      "$ref": "#/$defs/hash"
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_user_prompt_included",
        "raw_evidence_included",
        "provider_runtime_included",
        "raw_token_included"
      ],
      "properties": {
        "raw_user_prompt_included": {
          "const": false
        },
        "raw_evidence_included": {
          "const": false
        },
        "provider_runtime_included": {
          "const": false
        },
        "raw_token_included": {
          "const": false
        }
      }
    },
    "client_package_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "GENERAL_ANSWER"
          }
        },
        "required": [
          "execution_mode"
        ]
      },
      "then": {
        "properties": {
          "retrieval_package_ref": {
            "type": "null"
          },
          "selected_evidence_ids": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "retrieval_package_ref": {
            "$ref": "#/$defs/retrievalPackageRef"
          },
          "selected_evidence_ids": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "GENERAL_ANSWER",
        "GROUNDED_ANSWER",
        "DOCUMENT_SUMMARY",
        "DOCUMENT_GENERATION"
      ]
    },
    "tenantRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "oa.tenant"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ownerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "oa.user"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "templateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "template_version"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "minLength": 1
        },
        "template_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "promptContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_binding_key",
        "prompt_binding_id",
        "prompt_template_version_id",
        "prompt_version",
        "content_sha256",
        "render_event_ref"
      ],
      "properties": {
        "prompt_binding_key": {
          "type": "string",
          "minLength": 1
        },
        "prompt_binding_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_template_version_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "$ref": "#/$defs/hash"
        },
        "render_event_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_render_event_id",
            "rendered_prompt_hash",
            "user_prompt_hash"
          ],
          "properties": {
            "prompt_render_event_id": {
              "type": "string",
              "minLength": 1
            },
            "rendered_prompt_hash": {
              "$ref": "#/$defs/hash"
            },
            "user_prompt_hash": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_contract_id",
        "output_contract_version",
        "artifact_intent",
        "preferred_export_format"
      ],
      "properties": {
        "output_contract_id": {
          "type": "string",
          "minLength": 1
        },
        "output_contract_version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_intent": {
          "type": "string",
          "minLength": 1
        },
        "preferred_export_format": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generationParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_output_tokens",
        "temperature",
        "streaming",
        "timeout_ms"
      ],
      "properties": {
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "streaming": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      }
    },
    "qualityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "grounding_required",
        "citation_required",
        "low_confidence_behavior",
        "no_answer_behavior",
        "untrusted_context_boundary"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "grounding_required": {
          "type": "boolean"
        },
        "citation_required": {
          "type": "boolean"
        },
        "low_confidence_behavior": {
          "type": "string",
          "enum": [
            "block",
            "warn"
          ]
        },
        "no_answer_behavior": {
          "type": "string",
          "enum": [
            "block_grounded_generation",
            "allow"
          ]
        },
        "untrusted_context_boundary": {
          "const": true
        }
      }
    },
    "retrievalPackageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval_package_id",
        "package_hash",
        "status"
      ],
      "properties": {
        "retrieval_package_id": {
          "type": "string",
          "minLength": 1
        },
        "package_hash": {
          "$ref": "#/$defs/hash"
        },
        "status": {
          "type": "string",
          "enum": [
            "READY",
            "LOW_CONFIDENCE",
            "PARTIAL"
          ]
        }
      }
    }
  }
}
