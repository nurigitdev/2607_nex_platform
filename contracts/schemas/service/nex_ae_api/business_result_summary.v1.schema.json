{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/business_result_summary.v1.schema.json",
  "title": "AE Business Result Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_type", "summary_schema_version", "summary"],
  "properties": {
    "result_type": {"const": "FINANCE.VOUCHER_DRAFT"},
    "summary_schema_version": {"const": "ae_business_result_summary.v1"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome", "verification_status", "approval_state",
        "business_operation_id", "voucher_number", "amount", "currency",
        "account_codes", "project_code", "business_object_link"
      ],
      "properties": {
        "outcome": {
          "enum": ["COMMITTED", "NOT_COMMITTED", "UNKNOWN_COMMIT_STATE"]
        },
        "verification_status": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 64
        },
        "approval_state": {
          "enum": ["APPROVED", "DENIED", "NOT_REQUIRED", "UNKNOWN"]
        },
        "business_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "voucher_number": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "amount": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{0,15}$"
        },
        "account_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "project_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "business_object_link": {"type": "null"}
      }
    }
  }
}
