{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_ae_api/mvp_acceptance.v1.schema.json",
  "title": "NeX AE MVP Acceptance Operations Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema_version",
    "acceptance_id",
    "service_id",
    "web_service_id",
    "acceptance_scope",
    "evaluated_at",
    "status",
    "operations_status",
    "gates",
    "blockers",
    "summary",
    "advisory_deferrals",
    "raw_evidence_included",
    "request_trace_id",
    "evidence_source_status",
    "server_selected"
  ],
  "properties": {
    "report_schema_version": {"const": "ae_mvp_acceptance_report.v1"},
    "acceptance_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "service_id": {"const": "nex-ae-api"},
    "web_service_id": {"const": "nex-ae-web"},
    "acceptance_scope": {"const": "nex_ae_service_mvp"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["ACCEPTED", "BLOCKED"]},
    "operations_status": {"type": "string", "enum": ["READY_FOR_OPERATIONS", "BLOCKED"]},
    "gates": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/gate_result"}
    },
    "blockers": {
      "type": "array",
      "maxItems": 9,
      "items": {"$ref": "#/$defs/blocker"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_count", "passed_gate_count", "blocked_gate_count"],
      "properties": {
        "gate_count": {"const": 9},
        "passed_gate_count": {"type": "integer", "minimum": 0, "maximum": 9},
        "blocked_gate_count": {"type": "integer", "minimum": 0, "maximum": 9}
      }
    },
    "advisory_deferrals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "product_wide_release_approval",
          "production_deployment_certification",
          "production_identity_provider_activation",
          "object_storage_activation",
          "distributed_load_and_disaster_recovery_certification"
        ]
      }
    },
    "raw_evidence_included": {"const": false},
    "request_trace_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{32}$"
    },
    "evidence_source_status": {"type": "string", "enum": ["COLLECTED", "UNAVAILABLE"]},
    "server_selected": {"const": true}
  },
  "$defs": {
    "gate_id": {
      "type": "string",
      "enum": [
        "ae_requirement_closures",
        "contract_validation",
        "unit_regression",
        "statement_coverage",
        "branch_coverage",
        "postgres_smoke",
        "live_grounded_generation",
        "privacy_failure_runbooks",
        "operations_handoff"
      ]
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "evidence_missing",
        "status_not_pass",
        "observed_at_invalid",
        "evidence_from_future",
        "evidence_stale",
        "requirement_count_incomplete",
        "closure_inventory_has_issues",
        "schema_count_empty",
        "example_count_empty",
        "negative_fixture_count_empty",
        "openapi_count_empty",
        "regression_pass_count_below_minimum",
        "regression_failures_present",
        "coverage_below_threshold",
        "postgres_backend_not_proven",
        "test_databases_not_proven",
        "postgres_cleanup_not_proven",
        "live_provider_models_not_proven",
        "live_provider_failures_present",
        "browser_engine_not_proven",
        "verified_response_not_proven",
        "browser_secret_boundary_not_proven",
        "runbook_inventory_incomplete",
        "operations_target_invalid",
        "operations_manifest_not_sealed",
        "gate_evaluator_missing"
      ]
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "severity", "status", "reason_codes"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/gate_id"},
        "severity": {"const": "BLOCKING"},
        "status": {"type": "string", "enum": ["PASS", "BLOCKED"]},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reason_code"}
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "reason_codes"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/gate_id"},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reason_code"}
        }
      }
    }
  }
}
