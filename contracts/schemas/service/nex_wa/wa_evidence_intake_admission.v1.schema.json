{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/service/nex_wa/wa_evidence_intake_admission.v1.schema.json",
  "title": "NeX-WA Evidence Intake Admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "job_type",
    "status",
    "source_type",
    "source_ref",
    "source_revision_ref",
    "idempotent_reuse",
    "request_id",
    "trace_id"
  ],
  "properties": {
    "schema_version": {"const": "wa_evidence_intake_admission.v1"},
    "job_id": {"type": "string", "format": "uuid"},
    "job_type": {"const": "WA_EVIDENCE_INGEST"},
    "status": {"const": "QUEUED"},
    "source_type": {"enum": ["AE_AGENT_RESULT", "AE_ARTIFACT"]},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "source_revision_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "idempotent_reuse": {"type": "boolean"},
    "request_id": {"$ref": "#/$defs/scoped_id"},
    "trace_id": {"$ref": "#/$defs/scoped_id"}
  },
  "$defs": {
    "scoped_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    }
  }
}
