{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/generation/cx_grounded_generation_lineage.v1.schema.json",
  "title": "NeX CX Grounded Generation Lineage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineage_schema_version",
    "retrieval_package_id",
    "retrieval_package_hash",
    "evidence_binding_hash",
    "selected_evidence_count",
    "citation_validation_status",
    "citation_repair_attempted",
    "citation_repair_attempt_count",
    "original_provider_prompt_package_hash",
    "effective_provider_prompt_package_hash",
    "same_retrieval_package",
    "private_evidence_included"
  ],
  "properties": {
    "lineage_schema_version": {"const": "cx_grounded_generation_lineage.v1"},
    "retrieval_package_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "retrieval_package_hash": {"$ref": "#/$defs/sha256"},
    "evidence_binding_hash": {"$ref": "#/$defs/sha256"},
    "selected_evidence_count": {"type": "integer", "minimum": 1},
    "citation_validation_status": {"const": "VALIDATED"},
    "citation_repair_attempted": {"type": "boolean"},
    "citation_repair_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "original_provider_prompt_package_hash": {"$ref": "#/$defs/sha256"},
    "effective_provider_prompt_package_hash": {"$ref": "#/$defs/sha256"},
    "same_retrieval_package": {"const": true},
    "private_evidence_included": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {"citation_repair_attempted": {"const": true}},
        "required": ["citation_repair_attempted"]
      },
      "then": {
        "properties": {"citation_repair_attempt_count": {"const": 1}}
      },
      "else": {
        "properties": {
          "citation_repair_attempt_count": {"const": 0},
          "effective_provider_prompt_package_hash": {
            "$comment": "Runtime validation requires equality with original_provider_prompt_package_hash."
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
