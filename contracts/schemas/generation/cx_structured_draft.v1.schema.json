{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/generation/cx_structured_draft.v1.schema.json",
  "title": "NeX CX Structured Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "structured_draft_schema_version",
    "structured_draft_id",
    "cx_generation_id",
    "status",
    "trace_id",
    "request_id",
    "title",
    "summary",
    "content_hash",
    "sections",
    "citations",
    "validation",
    "metadata",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "structured_draft_schema_version": {
      "const": "cx_structured_draft.v1"
    },
    "structured_draft_id": {
      "type": "string",
      "minLength": 1
    },
    "cx_generation_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "VALIDATED",
        "VALIDATION_FAILED"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "maxLength": 160
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "ordinal",
          "heading",
          "blocks"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "block_id",
                "block_type",
                "text_hash",
                "text_preview"
              ],
              "properties": {
                "block_id": {
                  "type": "string",
                  "minLength": 1
                },
                "block_type": {
                  "type": "string",
                  "enum": [
                    "paragraph"
                  ]
                },
                "text_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "text_preview": {
                  "type": "string",
                  "maxLength": 240
                }
              }
            }
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "citation_label",
          "evidence_id",
          "retrieval_package_id",
          "valid",
          "validation_error"
        ],
        "properties": {
          "citation_label": {
            "type": "string",
            "pattern": "^\\[[0-9]+\\]$"
          },
          "evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieval_package_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid": {
            "type": "boolean"
          },
          "validation_error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_profile_id",
        "citation_status",
        "errors",
        "warnings"
      ],
      "properties": {
        "validator_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "citation_status": {
          "type": "string",
          "enum": [
            "VALIDATED",
            "FAILED"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "detail"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality_audit": {
          "$ref": "#/$defs/groundedResponseCitationQualityAudit"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_output_stored_in_public_record",
        "retrieval_package_id",
        "compatibility_rule_id"
      ],
      "properties": {
        "raw_output_stored_in_public_record": {
          "const": false
        },
        "retrieval_package_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "compatibility_rule_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "groundedResponseCitationQualityAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_schema_version",
        "boundary_id",
        "service_id",
        "boundary_status",
        "grounding_required",
        "citations_required",
        "source_trace_required",
        "output_summary",
        "citation_summary",
        "retrieval_summary",
        "stage_status",
        "issues",
        "warnings",
        "recommended_action",
        "refactoring_checkpoint",
        "redaction"
      ],
      "properties": {
        "audit_schema_version": {
          "const": "cx_grounded_response_citation_quality_audit.v1"
        },
        "boundary_id": {
          "const": "cx.grounded_response.citation_quality"
        },
        "service_id": {
          "const": "nex-cx"
        },
        "boundary_status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_REQUIRED"
          ]
        },
        "grounding_required": {
          "type": "boolean"
        },
        "citations_required": {
          "type": "boolean"
        },
        "source_trace_required": {
          "type": "boolean"
        },
        "output_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "output_hash",
            "output_char_count",
            "raw_output_included"
          ],
          "properties": {
            "output_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "output_char_count": {
              "type": "integer",
              "minimum": 0
            },
            "raw_output_included": {
              "const": false
            }
          }
        },
        "citation_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "citation_count",
            "valid_citation_count",
            "invalid_citation_count",
            "missing_required_citation",
            "citation_labels",
            "validation_error_codes"
          ],
          "properties": {
            "citation_count": {
              "type": "integer",
              "minimum": 0
            },
            "valid_citation_count": {
              "type": "integer",
              "minimum": 0
            },
            "invalid_citation_count": {
              "type": "integer",
              "minimum": 0
            },
            "missing_required_citation": {
              "type": "boolean"
            },
            "citation_labels": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^\\[[0-9]+\\]$"
              }
            },
            "validation_error_codes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "retrieval_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retrieval_package_id",
            "package_hash",
            "evidence_item_count",
            "selected_evidence_count",
            "selected_evidence_cited_count",
            "source_trace_required"
          ],
          "properties": {
            "retrieval_package_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "package_hash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "evidence_item_count": {
              "type": "integer",
              "minimum": 0
            },
            "selected_evidence_count": {
              "type": "integer",
              "minimum": 0
            },
            "selected_evidence_cited_count": {
              "type": "integer",
              "minimum": 0
            },
            "source_trace_required": {
              "type": "boolean"
            }
          }
        },
        "stage_status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grounding_requirement",
            "citation_presence",
            "citation_evidence_membership",
            "selected_evidence_coverage",
            "raw_output_redaction"
          ],
          "properties": {
            "grounding_requirement": {
              "$ref": "#/$defs/citationQualityStageStatus"
            },
            "citation_presence": {
              "$ref": "#/$defs/citationQualityStageStatus"
            },
            "citation_evidence_membership": {
              "$ref": "#/$defs/citationQualityStageStatus"
            },
            "selected_evidence_coverage": {
              "$ref": "#/$defs/citationQualityStageStatus"
            },
            "raw_output_redaction": {
              "$ref": "#/$defs/citationQualityStageStatus"
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "error_code",
              "retryable"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "error_code": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_action": {
          "type": "string",
          "enum": [
            "proceed",
            "proceed_with_caveat",
            "repair_or_retry"
          ]
        },
        "refactoring_checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "validation_entrypoint",
            "legacy_entrypoint",
            "previous_guard_slot",
            "active_guard_slot",
            "next_guard_slot",
            "external_api_changed",
            "database_schema_changed"
          ],
          "properties": {
            "validation_entrypoint": {
              "const": "build_grounded_response_citation_quality_audit"
            },
            "legacy_entrypoint": {
              "const": "validate_citation_claims"
            },
            "previous_guard_slot": {
              "const": "retrieval_package_quality"
            },
            "active_guard_slot": {
              "const": "grounded_response_citation_validation"
            },
            "next_guard_slot": {
              "type": "string",
              "minLength": 1
            },
            "external_api_changed": {
              "type": "boolean"
            },
            "database_schema_changed": {
              "const": false
            }
          }
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "raw_output_included",
            "evidence_text_included",
            "prompt_text_included",
            "provider_detail_included"
          ],
          "properties": {
            "status": {
              "const": "PASS"
            },
            "raw_output_included": {
              "const": false
            },
            "evidence_text_included": {
              "const": false
            },
            "prompt_text_included": {
              "const": false
            },
            "provider_detail_included": {
              "const": false
            }
          }
        }
      }
    },
    "citationQualityStageStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "NOT_REQUIRED"
      ]
    }
  }
}
