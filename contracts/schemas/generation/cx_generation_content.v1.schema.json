{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/generation/cx_generation_content.v1.schema.json",
  "title": "NeX CX Owner-Private Generation Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_schema_version",
    "cx_generation_id",
    "content_type",
    "content",
    "content_sha256",
    "size_bytes",
    "owner_scope_enforced"
  ],
  "properties": {
    "content_schema_version": {"const": "cx_generation_content.v1"},
    "cx_generation_id": {"type": "string", "minLength": 1},
    "content_type": {"const": "text/plain; charset=utf-8"},
    "content": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "owner_scope_enforced": {"const": true}
  }
}
