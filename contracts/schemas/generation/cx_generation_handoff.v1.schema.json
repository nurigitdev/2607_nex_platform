{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/generation/cx_generation_handoff.v1.schema.json",
  "title": "NeX CX Owner-Safe Asynchronous Generation Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_schema_version",
    "handoff_status",
    "next_action",
    "job",
    "generation",
    "content",
    "owner_scope_enforced"
  ],
  "properties": {
    "handoff_schema_version": {"const": "cx_generation_handoff.v1"},
    "handoff_status": {"enum": ["PENDING", "READY", "BLOCKED"]},
    "next_action": {
      "enum": [
        "POLL_GENERATION_JOB",
        "PRESENT_GENERATION_TO_OWNER",
        "RETRY_OR_REPAIR_GENERATION"
      ]
    },
    "job": {"$ref": "#/$defs/job"},
    "generation": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/generation"}]
    },
    "content": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/content"}]
    },
    "owner_scope_enforced": {"const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {"handoff_status": {"const": "PENDING"}},
        "required": ["handoff_status"]
      },
      "then": {
        "properties": {
          "next_action": {"const": "POLL_GENERATION_JOB"},
          "job": {
            "allOf": [
              {"$ref": "#/$defs/job"},
              {"properties": {"status": {"enum": ["QUEUED", "RUNNING"]}}}
            ]
          },
          "generation": {"type": "null"},
          "content": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"handoff_status": {"const": "BLOCKED"}},
        "required": ["handoff_status"]
      },
      "then": {
        "properties": {
          "next_action": {"const": "RETRY_OR_REPAIR_GENERATION"},
          "job": {
            "allOf": [
              {"$ref": "#/$defs/job"},
              {"properties": {"status": {"enum": ["FAILED", "CANCELLED"]}}}
            ]
          },
          "generation": {"type": "null"},
          "content": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"handoff_status": {"const": "READY"}},
        "required": ["handoff_status"]
      },
      "then": {
        "properties": {
          "next_action": {"const": "PRESENT_GENERATION_TO_OWNER"},
          "job": {
            "allOf": [
              {"$ref": "#/$defs/job"},
              {"properties": {"status": {"const": "SUCCEEDED"}}}
            ]
          },
          "generation": {"$ref": "#/$defs/generation"},
          "content": {"$ref": "#/$defs/content"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "async_generation_schema_version",
        "job_id",
        "cx_generation_id",
        "status",
        "attempt_count",
        "max_attempts",
        "retryable",
        "available_at",
        "created_at",
        "updated_at",
        "links",
        "error"
      ],
      "properties": {
        "async_generation_schema_version": {"const": "cx_async_generation_job.v1"},
        "job_id": {"type": "string", "format": "uuid"},
        "cx_generation_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]},
        "attempt_count": {"type": "integer", "minimum": 0},
        "max_attempts": {"type": "integer", "minimum": 1},
        "retryable": {"type": "boolean"},
        "available_at": {"type": ["string", "null"], "format": "date-time"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "async_job"],
          "properties": {
            "generation": {"type": "string", "minLength": 1},
            "async_job": {"type": "string", "minLength": 1}
          }
        },
        "error": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["error_code", "retryable", "dead_lettered"],
              "properties": {
                "error_code": {"type": "string", "minLength": 1},
                "retryable": {"type": "boolean"},
                "dead_lettered": {"type": "boolean"}
              }
            }
          ]
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_model_schema_version",
        "record_schema_version",
        "cx_generation_id",
        "tenant_ref_type",
        "tenant_ref_id",
        "owner_subject_ref_type",
        "owner_subject_ref_id",
        "status",
        "retrieval_package_id",
        "trace_id",
        "request_id",
        "alias",
        "provider_capability",
        "mo_generation_id",
        "request_metadata",
        "response_metadata",
        "mo_runtime_metadata",
        "usage",
        "failure",
        "recovery_lineage",
        "created_at",
        "updated_at",
        "content_ref"
      ],
      "properties": {
        "read_model_schema_version": {"const": "cx_generation_read_model.v1"},
        "record_schema_version": {"const": "cx_generation_execution_record.v1"},
        "cx_generation_id": {"type": "string", "minLength": 1},
        "tenant_ref_type": {"const": "oa.tenant"},
        "tenant_ref_id": {"type": "string", "minLength": 1},
        "owner_subject_ref_type": {"const": "oa.user"},
        "owner_subject_ref_id": {"type": "string", "minLength": 1},
        "status": {"const": "COMPLETED"},
        "retrieval_package_id": {"type": ["string", "null"], "minLength": 1},
        "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "request_id": {"type": "string", "minLength": 1},
        "alias": {"type": "string", "minLength": 1},
        "provider_capability": {"const": "generation"},
        "mo_generation_id": {"type": ["string", "null"], "minLength": 1},
        "request_metadata": {"$ref": "#/$defs/requestMetadata"},
        "response_metadata": {"$ref": "#/$defs/responseMetadata"},
        "mo_runtime_metadata": {"$ref": "#/$defs/runtimeMetadata"},
        "usage": {"$ref": "#/$defs/usage"},
        "failure": {"type": ["object", "null"], "additionalProperties": true},
        "recovery_lineage": {"type": ["object", "null"], "additionalProperties": true},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "content_ref": {"$ref": "#/$defs/contentRef"}
      }
    },
    "requestMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_prompt_package_hash": {"$ref": "#/$defs/sha256"},
        "generation_request_hash": {"$ref": "#/$defs/sha256"},
        "response_format_type": {"enum": ["text", "json_object", "json_schema"]},
        "source_has_messages": {"type": "boolean"},
        "source_has_prompt": {"type": "boolean"},
        "compatibility_rule_id": {"type": ["string", "null"]},
        "grounding_required": {"type": "boolean"},
        "retrieval_package_id": {"type": ["string", "null"]},
        "retrieval_package_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "selected_evidence_count": {"type": "integer", "minimum": 0},
        "structured_draft_id": {"type": ["string", "null"]},
        "draft_validation_status": {"type": ["string", "null"]},
        "grounded_response_quality_audit_schema_version": {"type": ["string", "null"]},
        "grounded_response_quality_status": {"type": ["string", "null"]},
        "grounded_response_quality_issue_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "responseMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finish_reason": {"type": ["string", "null"]},
        "output_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "runtimeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {"type": "string"},
        "trace_id": {"type": "string"},
        "queue_ms": {"type": "integer", "minimum": 0},
        "provider_ms": {"type": "integer", "minimum": 0},
        "total_ms": {"type": "integer", "minimum": 0},
        "route_id": {"type": "string"},
        "admission_decision": {"type": "string"},
        "provider_request_id": {"type": "string"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "content_sha256", "size_bytes"],
      "properties": {
        "available": {"const": true},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_schema_version",
        "cx_generation_id",
        "content_type",
        "content",
        "content_sha256",
        "size_bytes",
        "owner_scope_enforced"
      ],
      "properties": {
        "content_schema_version": {"const": "cx_generation_content.v1"},
        "cx_generation_id": {"type": "string", "minLength": 1},
        "content_type": {"const": "text/plain; charset=utf-8"},
        "content": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "owner_scope_enforced": {"const": true}
      }
    }
  }
}
