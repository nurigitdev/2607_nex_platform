{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/generation/cx_generation_execution_record.v1.schema.json",
  "title": "NeX CX Generation Execution Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_schema_version",
    "cx_generation_id",
    "status",
    "trace_id",
    "request_id",
    "alias",
    "provider_capability",
    "mo_generation_id",
    "request_metadata",
    "response_metadata",
    "mo_runtime_metadata",
    "usage",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "record_schema_version": {
      "const": "cx_generation_execution_record.v1"
    },
    "cx_generation_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "FAILED"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "alias": {
      "type": "string",
      "minLength": 1
    },
    "provider_capability": {
      "type": "string",
      "enum": [
        "generation"
      ]
    },
    "mo_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "request_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_prompt_package_hash",
        "generation_request_hash",
        "response_format_type",
        "source_has_messages",
        "source_has_prompt"
      ],
      "properties": {
        "provider_prompt_package_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generation_request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_format_type": {
          "type": "string",
          "enum": [
            "text",
            "json_object",
            "json_schema"
          ]
        },
        "source_has_messages": {
          "type": "boolean"
        },
        "source_has_prompt": {
          "type": "boolean"
        },
        "compatibility_rule_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "grounding_required": {
          "type": "boolean"
        },
        "retrieval_package_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "retrieval_package_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "selected_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "structured_draft_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "draft_validation_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "VALIDATED",
            "FAILED",
            null
          ]
        },
        "grounded_response_quality_audit_schema_version": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "cx_grounded_response_citation_quality_audit.v1",
            null
          ]
        },
        "grounded_response_quality_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "PASS",
            "FAIL",
            "NOT_REQUIRED",
            null
          ]
        },
        "grounded_response_quality_issue_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "response_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finish_reason",
        "output_hash",
        "output_preview"
      ],
      "properties": {
        "finish_reason": {
          "type": "string"
        },
        "output_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_preview": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "mo_runtime_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "queue_ms": {
          "type": "integer",
          "minimum": 0
        },
        "provider_ms": {
          "type": "integer",
          "minimum": 0
        },
        "total_ms": {
          "type": "integer",
          "minimum": 0
        },
        "route_id": {
          "type": "string"
        },
        "admission_decision": {
          "type": "string"
        },
        "provider_request_id": {
          "type": "string"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": true
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_code",
        "failure_class",
        "owner_service",
        "failed_stage",
        "retryable",
        "recovery_policy_id",
        "recovery_policy_hash",
        "safe_message"
      ],
      "properties": {
        "failure_code": {
          "type": "string",
          "minLength": 1
        },
        "failure_class": {
          "type": "string",
          "minLength": 1
        },
        "owner_service": {
          "type": "string",
          "enum": [
            "nex-ae-api",
            "nex-cx",
            "nex-mo",
            "nex-ag"
          ]
        },
        "failed_stage": {
          "type": "string",
          "enum": [
            "INTAKE",
            "INTENT_DETECTED",
            "RETRIEVAL_REQUESTED",
            "CONTEXT_PACKAGED",
            "TEMPLATE_SELECTED",
            "PROMPT_ASSEMBLING",
            "MO_ADMISSION_WAITING",
            "GENERATING",
            "DRAFT_VALIDATING",
            "CITATION_VALIDATING",
            "ARTIFACT_RENDERING",
            "FINALIZING",
            "FAILED",
            "CANCELLED"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "recovery_policy_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "recovery_policy_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "safe_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "recovery_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_generation_id",
        "parent_generation_id",
        "attempt_no",
        "lineage_type",
        "lineage_reason",
        "default_recovery_action",
        "recovery_policy_id",
        "recovery_policy_hash",
        "retry_after_seconds",
        "max_attempts",
        "reuse_retrieval_package",
        "changed_fields"
      ],
      "properties": {
        "root_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_generation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "attempt_no": {
          "type": "integer",
          "minimum": 1
        },
        "lineage_type": {
          "type": "string",
          "enum": [
            "retry",
            "repair",
            "fresh_retrieval_regenerate",
            "failure"
          ]
        },
        "lineage_reason": {
          "type": "string",
          "minLength": 1
        },
        "default_recovery_action": {
          "type": "string",
          "enum": [
            "retry",
            "repair",
            "fresh_retrieval_regenerate",
            "cancel"
          ]
        },
        "recovery_policy_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "recovery_policy_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "retry_after_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "reuse_retrieval_package": {
          "type": "boolean"
        },
        "changed_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
