{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/generation/cx_remediation_execution_result.v1.schema.json",
  "title": "NeX CX Remediation Execution Result",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {
    "not": {
      "enum": [
        "prompt",
        "messages",
        "content",
        "raw_prompt",
        "raw_generation_output",
        "raw_source_document_text",
        "raw_feedback_comment",
        "raw_operator_note",
        "raw_evidence",
        "raw_output",
        "provider_url",
        "provider_endpoint",
        "model_path",
        "storage_path",
        "authorization",
        "cookie",
        "api_key",
        "password",
        "secret"
      ]
    }
  },
  "required": [
    "result_schema_version",
    "remediation_action_id",
    "parent_cx_generation_id",
    "repair_cx_generation_id",
    "tenant_id",
    "trace_id",
    "request_id",
    "action_type",
    "lineage_type",
    "execution_status",
    "result_ref",
    "failure",
    "redaction_summary",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "result_schema_version": {
      "const": "cx_remediation_execution_result.v1"
    },
    "remediation_action_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_cx_generation_id": {
      "type": "string",
      "minLength": 1
    },
    "repair_cx_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action_type": {
      "$ref": "#/$defs/cxExecutableActionType"
    },
    "lineage_type": {
      "$ref": "#/$defs/lineageType"
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "result_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/resultRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/failure"
        },
        {
          "type": "null"
        }
      ]
    },
    "redaction_summary": {
      "$ref": "#/$defs/redactionSummary"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "SUCCEEDED"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "repair_cx_generation_id": {
            "type": "string",
            "minLength": 1
          },
          "result_ref": {
            "$ref": "#/$defs/resultRef"
          },
          "failure": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "FAILED"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "repair_cx_generation_id": {
            "type": "null"
          },
          "result_ref": {
            "type": "null"
          },
          "failure": {
            "$ref": "#/$defs/failure"
          }
        }
      }
    }
  ],
  "$defs": {
    "cxExecutableActionType": {
      "type": "string",
      "enum": [
        "retry_generation",
        "retrieval_repair",
        "citation_repair"
      ]
    },
    "lineageType": {
      "type": "string",
      "enum": [
        "retry",
        "fresh_retrieval_regenerate",
        "repair"
      ]
    },
    "resultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_service",
        "ref_type",
        "ref_id",
        "relation"
      ],
      "properties": {
        "source_service": {
          "const": "nex-cx"
        },
        "ref_type": {
          "const": "repair_execution"
        },
        "ref_id": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "const": "result_of"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "prompt",
            "messages",
            "content",
            "raw_prompt",
            "raw_generation_output",
            "raw_source_document_text",
            "raw_feedback_comment",
            "raw_operator_note",
            "raw_evidence",
            "raw_output",
            "provider_url",
            "provider_endpoint",
            "model_path",
            "storage_path",
            "authorization",
            "cookie",
            "api_key",
            "password",
            "secret"
          ]
        }
      },
      "required": [
        "failure_code",
        "failure_class",
        "retryable",
        "safe_message"
      ],
      "properties": {
        "failure_code": {
          "type": "string",
          "minLength": 1
        },
        "failure_class": {
          "type": "string",
          "enum": [
            "validation",
            "retrieval",
            "generation",
            "citation_quality",
            "dependency"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "safe_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "redactionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_content_included",
        "prompt_text_included",
        "evidence_text_included",
        "provider_detail_included",
        "excluded_fields"
      ],
      "properties": {
        "raw_content_included": {
          "const": false
        },
        "prompt_text_included": {
          "const": false
        },
        "evidence_text_included": {
          "const": false
        },
        "provider_detail_included": {
          "const": false
        },
        "excluded_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "raw_prompt",
              "messages",
              "source_text",
              "output_text",
              "raw_output",
              "provider_url",
              "provider_endpoint",
              "model_path",
              "storage_path",
              "api_key"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
