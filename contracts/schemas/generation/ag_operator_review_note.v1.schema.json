{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/generation/ag_operator_review_note.v1.schema.json",
  "title": "NeX AG Operator Review Note",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operator_note_schema_version",
    "operator_note_id",
    "target_service",
    "target_kind",
    "target_id",
    "trace_id",
    "request_id",
    "operator_ref",
    "note_status",
    "note_type",
    "severity",
    "operator_note_hash",
    "operator_note_preview",
    "reason_codes",
    "metadata",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "operator_note_schema_version": {
      "const": "ag_operator_review_note.v1"
    },
    "operator_note_id": {
      "type": "string",
      "minLength": 1
    },
    "target_service": {
      "type": "string",
      "enum": [
        "nex-ae-api",
        "nex-cx",
        "nex-mo",
        "nex-oa",
        "nex-ag"
      ]
    },
    "target_kind": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "operator_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_type",
        "operator_id",
        "tenant_id"
      ],
      "properties": {
        "operator_type": {
          "type": "string",
          "enum": [
            "service",
            "user"
          ]
        },
        "operator_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "note_status": {
      "$ref": "#/$defs/noteStatus"
    },
    "note_type": {
      "$ref": "#/$defs/noteType"
    },
    "severity": {
      "$ref": "#/$defs/severity"
    },
    "operator_note_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operator_note_preview": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "raw_operator_note_stored",
        "operator_note_storage"
      ],
      "properties": {
        "raw_operator_note_stored": {
          "const": false
        },
        "operator_note_storage": {
          "const": "hash_and_short_preview_only"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "noteStatus": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "RESOLVED",
        "DELETED"
      ]
    },
    "noteType": {
      "type": "string",
      "enum": [
        "OBSERVATION",
        "ACTION",
        "FOLLOW_UP",
        "ESCALATION",
        "RESOLUTION"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "URGENT"
      ]
    }
  }
}
