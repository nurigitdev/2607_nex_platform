{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/generation/generation_compatibility_rule.v1.schema.json",
  "title": "NeX Generation Compatibility Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compatibility_rule_schema_version",
    "compatibility_rule_id",
    "status",
    "execution_mode",
    "template_id",
    "prompt_binding_id",
    "output_contract_id",
    "provider_capability",
    "generation_profile",
    "grounding_required",
    "allowed_artifact_intents",
    "citation_policy",
    "metadata"
  ],
  "properties": {
    "compatibility_rule_schema_version": {
      "const": "generation_compatibility_rule.v1"
    },
    "compatibility_rule_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE"
      ]
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "GENERAL_ANSWER",
        "GROUNDED_ANSWER",
        "DOCUMENT_SUMMARY",
        "REPORT_GENERATION"
      ]
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt_binding_id": {
      "type": "string",
      "minLength": 1
    },
    "output_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_capability": {
      "type": "string",
      "enum": [
        "generation"
      ]
    },
    "generation_profile": {
      "type": "string",
      "minLength": 1
    },
    "grounding_required": {
      "type": "boolean"
    },
    "allowed_artifact_intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "preview_only",
          "answer_export",
          "create_artifact"
        ]
      }
    },
    "citation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citations_required",
        "source_trace_required"
      ],
      "properties": {
        "citations_required": {
          "type": "boolean"
        },
        "source_trace_required": {
          "type": "boolean"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
