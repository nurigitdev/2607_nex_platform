{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-platform.local/schemas/generation/ae_artifact_record.v1.schema.json",
  "title": "NeX AE Artifact Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_schema_version",
    "artifact_id",
    "artifact_type",
    "artifact_status",
    "current_version_id",
    "trace_id",
    "request_id",
    "chat_document_id",
    "interaction_id",
    "owner_actor_ref",
    "workspace_ref",
    "display_title",
    "language",
    "artifact_intent",
    "target_formats",
    "retention_policy_ref",
    "template_ref",
    "handoff_ref",
    "source_refs",
    "versions",
    "render_jobs",
    "files",
    "links",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "artifact_schema_version": {
      "const": "ae_artifact_record.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "generated_document",
        "summary",
        "answer_export"
      ]
    },
    "artifact_status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "RENDERING",
        "READY",
        "FAILED",
        "ARCHIVED",
        "DELETED"
      ]
    },
    "current_version_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "chat_document_id": {
      "type": "string",
      "minLength": 1
    },
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_actor_ref": {
      "$ref": "#/$defs/actorRef"
    },
    "workspace_ref": {
      "$ref": "#/$defs/workspaceRef"
    },
    "display_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "language": {
      "type": "string",
      "enum": [
        "ko",
        "en"
      ]
    },
    "artifact_intent": {
      "type": "string",
      "enum": [
        "preview_only",
        "create_artifact",
        "create_and_export"
      ]
    },
    "target_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/renderFormat"
      }
    },
    "retention_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "template_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "template_version",
        "rendering_template_id"
      ],
      "properties": {
        "template_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "template_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "rendering_template_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "handoff_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_handoff_id",
        "artifact_request_id",
        "handoff_schema_version"
      ],
      "properties": {
        "artifact_handoff_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_request_id": {
          "type": "string",
          "minLength": 1
        },
        "handoff_schema_version": {
          "const": "ae_artifact_handoff.v1"
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactVersion"
      }
    },
    "render_jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/renderJob"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactFile"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactLink"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "actorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id",
        "tenant_id"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "user",
            "service"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workspaceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "tenant_id"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "renderFormat": {
      "type": "string",
      "enum": [
        "MD",
        "HTML_PREVIEW",
        "DOCX",
        "PDF"
      ]
    },
    "hexHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableHexHash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_status",
        "citation_count",
        "validation_error_count",
        "warning_count",
        "grounding_required",
        "retrieval_package_id",
        "retrieval_package_hash",
        "evidence_ref_count"
      ],
      "properties": {
        "citation_status": {
          "type": "string",
          "enum": [
            "VALIDATED"
          ]
        },
        "citation_count": {
          "type": "integer",
          "minimum": 0
        },
        "validation_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "grounding_required": {
          "type": "boolean"
        },
        "retrieval_package_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "retrieval_package_hash": {
          "$ref": "#/$defs/nullableHexHash"
        },
        "evidence_ref_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref_id",
        "cx_generation_id",
        "structured_draft_id",
        "draft_schema_version",
        "structured_draft_content_hash",
        "citation_claims_hash",
        "validation_result_hash",
        "retrieval_package_id",
        "retrieval_package_hash",
        "evidence_ref_count",
        "source_anchor_count",
        "quality_summary"
      ],
      "properties": {
        "source_ref_id": {
          "type": "string",
          "minLength": 1
        },
        "cx_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "structured_draft_id": {
          "type": "string",
          "minLength": 1
        },
        "draft_schema_version": {
          "const": "cx_structured_draft.v1"
        },
        "structured_draft_content_hash": {
          "$ref": "#/$defs/hexHash"
        },
        "citation_claims_hash": {
          "$ref": "#/$defs/hexHash"
        },
        "validation_result_hash": {
          "$ref": "#/$defs/hexHash"
        },
        "retrieval_package_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "retrieval_package_hash": {
          "$ref": "#/$defs/nullableHexHash"
        },
        "evidence_ref_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_anchor_count": {
          "type": "integer",
          "minimum": 0
        },
        "quality_summary": {
          "$ref": "#/$defs/qualitySummary"
        }
      }
    },
    "artifactVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_version_id",
        "artifact_id",
        "version_no",
        "version_reason",
        "source_generation_id",
        "source_structured_draft_id",
        "source_content_hash",
        "source_citation_claims_hash",
        "render_policy_hash",
        "artifact_content_hash",
        "rendered_formats",
        "validation_snapshot",
        "created_at"
      ],
      "properties": {
        "artifact_version_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "version_no": {
          "type": "integer",
          "minimum": 1
        },
        "version_reason": {
          "type": "string",
          "enum": [
            "initial_render",
            "rerender",
            "manual_edit",
            "rollback",
            "repair_render"
          ]
        },
        "source_generation_id": {
          "type": "string",
          "minLength": 1
        },
        "source_structured_draft_id": {
          "type": "string",
          "minLength": 1
        },
        "source_content_hash": {
          "$ref": "#/$defs/hexHash"
        },
        "source_citation_claims_hash": {
          "$ref": "#/$defs/hexHash"
        },
        "render_policy_hash": {
          "$ref": "#/$defs/hexHash"
        },
        "artifact_content_hash": {
          "$ref": "#/$defs/hexHash"
        },
        "rendered_formats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/renderFormat"
          }
        },
        "validation_snapshot": {
          "$ref": "#/$defs/qualitySummary"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "renderJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "render_job_id",
        "artifact_id",
        "artifact_version_id",
        "job_status",
        "current_stage",
        "progress_mode",
        "progress_percent",
        "retryable",
        "failure_code",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "render_job_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "job_status": {
          "type": "string",
          "enum": [
            "PENDING",
            "QUEUED",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "TIMEOUT",
            "CANCELLED"
          ]
        },
        "current_stage": {
          "type": "string",
          "enum": [
            "HANDOFF_VALIDATING",
            "MARKDOWN_RENDERING",
            "HTML_PREVIEW_RENDERING",
            "DOCX_RENDERING",
            "PDF_RENDERING",
            "LINK_CREATING",
            "FINALIZING"
          ]
        },
        "progress_mode": {
          "type": "string",
          "enum": [
            "DETERMINATE",
            "INDETERMINATE",
            "STREAMING"
          ]
        },
        "progress_percent": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "retryable": {
          "type": "boolean"
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "artifactFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_file_id",
        "artifact_version_id",
        "format",
        "mime_type",
        "file_name",
        "storage_ref",
        "file_size_bytes",
        "file_hash",
        "source_version_hash",
        "created_at"
      ],
      "properties": {
        "artifact_file_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version_id": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "$ref": "#/$defs/renderFormat"
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        },
        "file_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "storage_ref": {
          "type": "string",
          "pattern": "^ae://artifacts/[A-Za-z0-9._~:/-]+$"
        },
        "file_size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "file_hash": {
          "$ref": "#/$defs/hexHash"
        },
        "source_version_hash": {
          "$ref": "#/$defs/hexHash"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifactLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_link_id",
        "artifact_file_id",
        "link_type",
        "access_policy",
        "link_route",
        "expires_at",
        "created_by_actor_ref",
        "download_count",
        "revoked_at"
      ],
      "properties": {
        "artifact_link_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_file_id": {
          "type": "string",
          "minLength": 1
        },
        "link_type": {
          "type": "string",
          "enum": [
            "preview",
            "download",
            "share"
          ]
        },
        "access_policy": {
          "type": "string",
          "enum": [
            "owner_only",
            "workspace_scope"
          ]
        },
        "link_route": {
          "type": "string",
          "pattern": "^/api/v1/"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "created_by_actor_ref": {
          "$ref": "#/$defs/actorRef"
        },
        "download_count": {
          "type": "integer",
          "minimum": 0
        },
        "revoked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
